import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, CopyChip, DialogRow, DialogSection, Field, Progress } from "../primitives/modal.slint";
import { Select } from "../primitives/select.slint";
import { Switch } from "../inspector/controls.slint";
import { PaneScroll } from "../workspace/pane.slint";
import { Fmt } from "../util.slint";

// The export sheet.
//
// It states the format, asks where the file goes, offers three quality
// presets and starts. The deciding number sits *on* each preset — what the
// file will actually weigh — because that is the thing the choice hinges on,
// and it belongs where the choice is made.
//
// It covers the window and slides up from the bottom edge, and its groups
// are laid out across the width rather than down it: three columns on a
// laptop, two on a narrow window, and one that scrolls on a phone held
// upright. The footer - the Export button, the progress, the result -
// stays pinned under them whatever the body is doing.

export enum ExportPhase { idle, running, done, failed }

export struct ExportData {
    open: bool,
    /// the file name, without folder or extension
    name: string,
    /// the whole path, already shortened for display by whoever owns it
    path: string,
    /// "1920 x 1080 · 30.00 fps"
    format: string,
    duration: string,
    /// "8 clips · 3 titles"
    contents: string,
    resolution: int,
    /// the resolution ladder as this project would come out at each
    /// rung - "1080 × 1920" on a 9:16 edit - with its names, and which
    /// rungs cannot be picked: every one but the timeline's own
    resolutions: [string],
    resolution-details: [string],
    resolution-disabled: [bool],
    rate: int,
    /// the rates offered, the timeline's own first, with its name under
    /// it; the export is at the timeline's rate unless another is picked
    rates: [string],
    rate-details: [string],
    quality: int,
    /// index into the codec list: H.264, HEVC, AV1
    codec: int,
    /// Which of them this device can encode. A phone's chip may lack
    /// HEVC or AV1; the picker says so rather than failing on Export.
    h264-encodable: bool,
    hevc-encodable: bool,
    av1-encodable: bool,
    ten-bit: bool,
    /// The timeline is HDR, so the file can be written HDR or SDR.
    hdr-timeline: bool,
    /// It is being written HDR: ten bits, HEVC or AV1.
    hdr: bool,
    /// This platform can write ten bits at all. A phone's hardware
    /// encoders take eight, so neither the switch nor HDR is offered there.
    deep-available: bool,
    /// "HDR (HLG)" or "HDR (PQ)": the timeline's own.
    hdr-label: string,
    /// 0 = limited (video) range, 1 = full. Shown under Advanced.
    color-range: int,
    /// The Advanced section is open: bitrate controls show.
    advanced: bool,
    /// 0 = VBR, 1 = CBR.
    rate-mode: int,
    /// Target bitrate in kbps, used when rate-mode is CBR.
    bitrate: int,
    /// "HEVC 10-bit · hardware": what the file will be encoded as
    encoding: string,
    /// What each preset would weigh. Three strings rather than a list: a Slint
    /// struct cannot hold an array.
    size-high: string,
    size-balanced: string,
    size-small: string,
    phase: ExportPhase,
    /// 0..1
    progress: float,
    /// "Rendering video"
    stage: string,
    eta: string,
    /// why it failed, when it did
    message: string,
    done-size: string,
    /// nothing on the timeline to export
    empty: bool,
}

// One tile of the summary block.
//
// The block is a rounded rectangle in the hairline colour with 1px gaps
// between its rows, so the separators are the ground showing through rather
// than lines drawn on top — which is why the rules stop exactly at the rounded
// corners instead of running into them.
component Fact inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 34px;
    background: Theme.raised;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        Text {
            text: root.label;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        Text {
            text: root.value;
            color: Theme.fg;
            font-family: Theme.font-technical;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// One of the three quality presets. The estimate is on the card, in the accent
// when the card is the chosen one, because it is what the choice is actually
// being made on.
component QualityCard inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <string> size;
    in property <bool> current;

    callback clicked();

    horizontal-stretch: 1;
    height: 72px;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: root.current ? Theme.accent
        : touch.has-hover ? Theme.line-strong
        : Theme.line;
    background: root.current ? Theme.accent-soft : Theme.raised;

    animate background, border-color { duration: 120ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    VerticalLayout {
        padding: 10px;
        spacing: 1px;

        Text {
            text: root.label;
            color: Theme.fg;
            font-size: Theme.fs;
            font-weight: Theme.weight-title;
            overflow: elide;
        }

        Text {
            text: root.note;
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            overflow: elide;
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            text: "~" + root.size;
            color: root.current ? Theme.accent : Theme.fg;
            font-family: Theme.font-technical;
            font-size: Theme.fs;
            font-weight: Theme.weight-title;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── the groups ───────────────────────────────────────────────────────────
//
// One component each, so the sheet can deal them into however many columns
// its width holds without writing any of them twice.

// The picture at the playhead, small, and a strip to scrub it: a last
// look at the cut before the file is written, without leaving the sheet.
// The frame is the monitor's own, which keeps drawing under the sheet.
component PreviewSection inherits DialogSection {
    in property <image> frame;
    in property <float> playhead;
    in property <float> duration;
    in property <float> frame-rate;

    callback seek(seconds: float);

    title: I18n.t("common.preview");

    property <float> share: root.duration > 0
        ? Math.clamp(root.playhead / root.duration, 0, 1) : 0;

    Rectangle {
        height: self.width * 9 / 16;
        border-radius: Theme.r;
        background: Theme.stage;
        clip: true;

        Image {
            width: 100%;
            height: 100%;
            source: root.frame;
            image-fit: contain;
        }
    }

    // The scrub strip: the playhead's share of the cut, dragged.
    Rectangle {
        height: 24px;

        track := Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: parent.width;
            height: 4px;
            border-radius: 2px;
            background: Theme.line-strong;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * root.share;
                height: parent.height;
                border-radius: 2px;
                background: Theme.accent;
            }
        }

        Rectangle {
            x: track.width * root.share - self.width / 2;
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: Theme.accent;
        }

        TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.seek(Math.clamp(self.mouse-x / self.width, 0, 1) * root.duration);
                }
            }
            moved => {
                if (self.pressed) {
                    root.seek(Math.clamp(self.mouse-x / self.width, 0, 1) * root.duration);
                }
            }
        }
    }

    Text {
        text: Fmt.frames-timecode(root.playhead, root.frame-rate)
            + " / " + Fmt.frames-timecode(root.duration, root.frame-rate);
        color: Theme.fg-dim;
        font-family: Theme.font-technical;
        font-size: Theme.fs-sm;
    }
}

component SummarySection inherits DialogSection {
    in property <ExportData> data;

    title: I18n.t("export.summary");

    Rectangle {
        border-radius: Theme.r;
        // The ground the 1px gaps show through.
        background: Theme.line;
        clip: true;

        VerticalLayout {
            spacing: 1px;

            Fact { label: I18n.t("export.format"); value: root.data.format + " · " + root.data.encoding; }
            Fact { label: I18n.t("common.duration"); value: root.data.duration; }
            Fact { label: I18n.t("export.contents"); value: root.data.contents; }
        }
    }
}

component DestinationSection inherits DialogSection {
    in property <ExportData> data;
    /// A phone has no folder picker: the file goes where the path under
    /// the field says, so there is no Browse to press.
    in property <bool> phone;

    callback name-edited(name: string);
    callback browse();

    title: I18n.t("export.destination");

    DialogRow {
        Field {
            value: root.data.name;
            technical: true;
            edited(text) => { root.name-edited(text); }
        }

        if !root.phone: Button {
            label: I18n.t("export.browse");
            glyph: Glyph.import;
            clicked => { root.browse(); }
        }
    }

    // The whole path under the field rather than in it, so the part
    // you are editing is never the part that gets truncated away.
    Text {
        text: root.data.path;
        color: Theme.fg-dim;
        font-family: Theme.font-technical;
        font-size: Theme.fs-sm;
        overflow: elide;
    }
}

component OutputSection inherits DialogSection {
    in property <ExportData> data;

    callback resolution-changed(index: int);
    callback rate-changed(index: int);
    callback codec-changed(index: int);
    callback ten-bit-changed(on: bool);
    callback hdr-changed(on: bool);

    title: I18n.t("export.output");

    DialogRow {
        label: I18n.t("export.resolution");
        // The timeline's own size, and the ladder it sits on for scale:
        // a 9:16 edit is 1080 × 1920, not 1920 × 1080, and it exports at
        // the size it was cut at - the other rungs are shown and cannot be
        // picked. https://github.com/jub0t/Concat/issues/109
        Select {
            current: root.data.resolution;
            options: root.data.resolutions;
            details: root.data.resolution-details;
            disabled: root.data.resolution-disabled;
            changed(index) => { root.resolution-changed(index); }
        }
    }

    DialogRow {
        label: I18n.t("common.frameRate");
        Select {
            current: root.data.rate;
            options: root.data.rates;
            details: root.data.rate-details;
            changed(index) => { root.rate-changed(index); }
        }
    }

    // An HDR timeline is written as it is by default, or rolled off
    // to SDR for wherever HDR does not play.
    if root.data.hdr-timeline && root.data.deep-available: DialogRow {
        label: I18n.t("common.color");
        Select {
            current: root.data.hdr ? 0 : 1;
            options: [root.data.hdr-label, "SDR"];
            details: [I18n.t("export.asTheTimeline"), I18n.t("export.toneMapped")];
            changed(index) => { root.hdr-changed(index == 0); }
        }
    }

    // The standard, not the encoder: which encoder makes it is the
    // platform's business, and the Format line says when the hardware
    // one will. H.264 is left out of an HDR file, which it does not
    // carry.
    if !root.data.hdr: DialogRow {
        label: I18n.t("export.codec");
        Select {
            current: root.data.codec;
            options: ["H.264", "HEVC", "AV1"];
            details: [
                root.data.h264-encodable ? I18n.t("export.playsEverywhere") : I18n.t("export.notOnThisDevice"),
                root.data.hevc-encodable ? I18n.t("export.halfTheSize") : I18n.t("export.notOnThisDevice"),
                root.data.av1-encodable ? I18n.t("export.smallest") : I18n.t("export.notOnThisDevice"),
            ];
            changed(index) => { root.codec-changed(index); }
        }
    }

    if root.data.hdr: DialogRow {
        label: I18n.t("export.codec");
        Select {
            current: root.data.codec - 1;
            options: ["HEVC", "AV1"];
            details: [
                root.data.hevc-encodable ? I18n.t("export.halfTheSize") : I18n.t("export.notOnThisDevice"),
                root.data.av1-encodable ? I18n.t("export.smallest") : I18n.t("export.notOnThisDevice"),
            ];
            changed(index) => { root.codec-changed(index + 1); }
        }
    }

    // HDR is ten bits always, so the switch is for SDR alone.
    if !root.data.hdr && root.data.deep-available: DialogRow {
        label: I18n.t("export.tenBitColour");
        HorizontalLayout {
            alignment: end;
            VerticalLayout {
                alignment: center;
                Switch {
                    checked: root.data.ten-bit;
                    toggled(on) => { root.ten-bit-changed(on); }
                }
            }
        }
    }
}

component QualitySection inherits DialogSection {
    in property <ExportData> data;

    callback quality-changed(index: int);

    title: I18n.t("common.quality");

    HorizontalLayout {
        spacing: 6px;

        QualityCard {
            label: I18n.t("export.high");
            note: I18n.t("export.master");
            size: root.data.size-high;
            current: root.data.quality == 0;
            clicked => { root.quality-changed(0); }
        }
        QualityCard {
            label: I18n.t("common.balanced");
            note: I18n.t("export.recommended");
            size: root.data.size-balanced;
            current: root.data.quality == 1;
            clicked => { root.quality-changed(1); }
        }
        QualityCard {
            label: I18n.t("common.small");
            note: I18n.t("export.share");
            size: root.data.size-small;
            current: root.data.quality == 2;
            clicked => { root.quality-changed(2); }
        }
    }
}

// The switch, and what it opens: the bitrate, and the levels the file is
// written in. Limited is what every player and YouTube expect; full is for
// screen content bound for a PC player that reads the tag. Both are tagged
// true, so the choice is about the player, not about the picture.
// https://github.com/jub0t/Concat/issues/103
component AdvancedSection inherits VerticalLayout {
    in property <ExportData> data;
    in property <bool> first;
    /// The bitrate and colour groups shown outright, with no switch to
    /// show them: a sheet that has the window has room for them, and a
    /// switch there was one more thing to click before a choice.
    in property <bool> always;

    callback advanced-toggled(on: bool);
    callback rate-mode-changed(index: int);
    callback bitrate-changed(text: string);
    callback color-range-changed(index: int);

    if !root.always: DialogSection {
        first: root.first;
        title: I18n.t("export.advanced");

        DialogRow {
            label: I18n.t("export.showAdvancedOptions");
            Switch {
                checked: root.data.advanced;
                toggled(on) => { root.advanced-toggled(on); }
            }
        }
    }

    if root.always || root.data.advanced: DialogSection {
        first: root.always && root.first;
        title: I18n.t("export.bitrate");

        DialogRow {
            label: I18n.t("common.mode");
            Select {
                current: root.data.rate-mode;
                options: [I18n.t("export.vbr"), I18n.t("export.cbr")];
                changed(index) => { root.rate-mode-changed(index); }
            }
        }
        if root.data.rate-mode == 1: DialogRow {
            label: I18n.t("export.targetBitrate");
            Field {
                value: root.data.bitrate + " kbps";
                edited(text) => { root.bitrate-changed(text); }
            }
        }
    }

    if root.always || root.data.advanced: DialogSection {
        title: I18n.t("export.colour");

        DialogRow {
            label: I18n.t("common.colourRange");
            Select {
                current: root.data.color-range;
                options: [I18n.t("common.limited"), I18n.t("common.full")];
                details: [I18n.t("export.videoYoutube"), I18n.t("export.screenContent")];
                changed(index) => { root.color-range-changed(index); }
            }
        }
    }
}

// What is under the groups: the failure, the progress, the result, and
// the button that starts it all.
component ExportFooter inherits VerticalLayout {
    in property <ExportData> data;
    /// The button runs the footer's width on a phone, and keeps to a
    /// button's width on a desk, where the width would make it a banner.
    in property <bool> narrow;
    /// A phone has no file manager to show the file in.
    in property <bool> phone;

    callback begin();
    callback cancel();
    callback reveal();
    callback again();

    property <bool> running: root.data.phase == ExportPhase.running;

    spacing: 10px;

    // A failure says what went wrong where the action was, not in a
    // separate alert to be dismissed before you can try again.
    if root.data.phase == ExportPhase.failed: Rectangle {
        border-radius: Theme.r;
        background: Theme.danger-soft;

        HorizontalLayout {
            padding: 10px;
            spacing: 8px;

            VerticalLayout {
                alignment: start;
                Icon { glyph: Glyph.close; size: 13px; tint: Theme.danger; }
            }

            Text {
                horizontal-stretch: 1;
                text: root.data.message;
                color: Theme.danger;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            VerticalLayout {
                alignment: start;
                CopyChip { text: root.data.message; }
            }
        }
    }

    if root.running: HorizontalLayout {
        spacing: 8px;

        Text {
            text: root.data.stage;
            color: Theme.fg;
            font-size: Theme.fs;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: "\{Math.round(root.data.progress * 100)}%";
            color: Theme.fg-muted;
            font-family: Theme.font-technical;
            font-size: Theme.fs;
            vertical-alignment: center;
        }

        Text {
            text: root.data.eta;
            color: Theme.fg-muted;
            font-family: Theme.font-technical;
            font-size: Theme.fs;
            vertical-alignment: center;
        }
    }

    if root.running: Progress { value: root.data.progress; }

    if root.running: HorizontalLayout {
        alignment: start;
        Button {
            label: I18n.t("export.cancelExport");
            glyph: Glyph.close;
            ghost: true;
            clicked => { root.cancel(); }
        }
    }

    if root.data.phase == ExportPhase.done: HorizontalLayout {
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Icon { glyph: Glyph.check; size: 15px; tint: Theme.green; }
        }

        Text {
            text: I18n.t1("export.exported", "\{root.data.done-size}");
            color: Theme.green;
            font-size: Theme.fs;
            font-weight: Theme.weight-title;
            vertical-alignment: center;
        }
    }

    if root.data.phase == ExportPhase.done: HorizontalLayout {
        spacing: 6px;
        alignment: start;

        if !root.phone: Button {
            label: I18n.t("export.showInFolder");
            glyph: Glyph.import;
            clicked => { root.reveal(); }
        }
        Button {
            label: I18n.t("export.exportAgain");
            ghost: true;
            clicked => { root.again(); }
        }
    }

    if root.data.phase == ExportPhase.idle || root.data.phase == ExportPhase.failed:
    HorizontalLayout {
        alignment: root.narrow ? stretch : end;
        Button {
            block: true;
            primary: true;
            large: true;
            min-width: root.narrow ? 0px : 320px;
            glyph: Glyph.export;
            label: root.data.empty ? I18n.t("export.nothingToExport")
                : I18n.t("export.exportEstimate") + (root.data.quality == 0 ? root.data.size-high
                    : root.data.quality == 1 ? root.data.size-balanced
                    : root.data.size-small);
            enabled: !root.data.empty && root.data.name != "";
            clicked => { root.begin(); }
        }
    }
}

// Lays its children out at most `max` wide, centred in whatever width it
// is given: a sheet the width of a 4K monitor is not read across.
component Measure inherits HorizontalLayout {
    in property <length> max: 1180px;

    Rectangle { horizontal-stretch: 1; }
    VerticalLayout {
        max-width: root.max;
        horizontal-stretch: 1000;
        @children
    }
    Rectangle { horizontal-stretch: 1; }
}

export component ExportDialog inherits Rectangle {
    in property <ExportData> data;
    /// A finger drives it: the body scrolls under a drag as well as a wheel.
    in property <bool> phone;
    /// The monitor's frame and where the playhead is, for the preview
    /// group; a scrub there seeks the cut.
    in property <image> preview-frame;
    in property <float> playhead;
    in property <float> duration-seconds;
    in property <float> frame-rate;
    callback seek(seconds: float);

    callback closed();
    callback name-edited(name: string);
    callback browse();
    callback resolution-changed(index: int);
    callback rate-changed(index: int);
    callback quality-changed(index: int);
    callback codec-changed(index: int);
    callback ten-bit-changed(on: bool);
    callback hdr-changed(on: bool);
    callback color-range-changed(index: int);
    callback advanced-toggled(on: bool);
    callback rate-mode-changed(index: int);
    callback bitrate-changed(text: string);
    callback begin();
    callback cancel();
    callback reveal();
    callback again();

    property <bool> running: root.data.phase == ExportPhase.running;
    /// How many columns the width holds. Three groups a column wide need
    /// about 330px each; under two of those the sheet is a phone's single
    /// column and scrolls.
    property <int> columns: root.width >= 1080px ? 3 : root.width >= 720px ? 2 : 1;

    /// How far down the sheet is, as a share of the window: 0 up, 1 gone.
    /// A share rather than a length, so a window resized while the sheet is
    /// away does not animate it back into view on the way to the new edge.
    /// A quick start and a long settle: it arrives with a swoosh and lands
    /// softly, and leaves the same way down.
    property <float> lowered: root.data.open ? 0 : 1;
    animate lowered { duration: 380ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    // Up while open, and while it is still sliding away after closing, so
    // the way out is seen as well as the way in.
    visible: root.data.open || root.lowered < 1;

    sheet := Rectangle {
        x: 0;
        y: root.height * root.lowered;
        width: root.width;
        height: root.height;
        background: Theme.panel;

        // Nothing under the sheet takes a press while it is up.
        TouchArea { }

        VerticalLayout {
            // ── the header ───────────────────────────────────────────────
            Rectangle {
                height: 52px;

                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.line;
                }

                // The close on the trailing edge and the title centred
                // against the whole strip. Nothing on the leading edge:
                // that corner is the window's traffic lights on a Mac, and
                // the format is in the Summary anyway.
                HorizontalLayout {
                    padding-left: Theme.pad;
                    padding-right: 12px;
                    spacing: 8px;

                    Rectangle { horizontal-stretch: 1; }

                    // Gone, not disabled, while a job is running: there is
                    // no safe answer to pressing it, so it should not be
                    // there to press. It points down, the way the sheet
                    // leaves.
                    if !root.running: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: Theme.r-sm;
                            background: shut.has-hover ? Theme.field : Colors.transparent;

                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                glyph: Glyph.close;
                                size: 14px;
                                tint: shut.has-hover ? Theme.fg : Theme.fg-muted;
                            }

                            shut := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.closed(); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    x: (parent.width - self.preferred-width) / 2;
                    y: 0;
                    width: self.preferred-width;
                    height: parent.height;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;
                        Icon { glyph: Glyph.export; size: 16px; tint: Theme.accent; }
                    }

                    Text {
                        text: I18n.t("common.export");
                        color: Theme.fg;
                        font-size: Theme.fs-lg;
                        font-weight: Theme.weight-title;
                        vertical-alignment: center;
                    }
                }
            }

            // ── the groups ───────────────────────────────────────────────
            PaneScroll {
                vertical-stretch: 1;
                finger: root.phone;

                Measure {
                    padding-top: 8px;
                    padding-bottom: 16px;

                    if root.running || root.columns == 1: VerticalLayout {
                        SummarySection { first: true; data: root.data; }
                        if !root.running: DestinationSection {
                            data: root.data;
                            phone: root.phone;
                            name-edited(name) => { root.name-edited(name); }
                            browse => { root.browse(); }
                        }
                        if !root.running: OutputSection {
                            data: root.data;
                            resolution-changed(index) => { root.resolution-changed(index); }
                            rate-changed(index) => { root.rate-changed(index); }
                            codec-changed(index) => { root.codec-changed(index); }
                            ten-bit-changed(on) => { root.ten-bit-changed(on); }
                            hdr-changed(on) => { root.hdr-changed(on); }
                        }
                        if !root.running: QualitySection {
                            data: root.data;
                            quality-changed(index) => { root.quality-changed(index); }
                        }
                        if !root.running: AdvancedSection {
                            data: root.data;
                            advanced-toggled(on) => { root.advanced-toggled(on); }
                            rate-mode-changed(index) => { root.rate-mode-changed(index); }
                            bitrate-changed(text) => { root.bitrate-changed(text); }
                            color-range-changed(index) => { root.color-range-changed(index); }
                        }
                    }

                    // Two columns: what and where on the left with the
                    // quality, how on the right.
                    // Two columns: the picture, what it is and where it
                    // goes on the left with the quality; how on the right,
                    // the advanced groups open.
                    if !root.running && root.columns == 2: HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            alignment: start;
                            horizontal-stretch: 1;
                            PreviewSection {
                                first: true;
                                frame: root.preview-frame;
                                playhead: root.playhead;
                                duration: root.duration-seconds;
                                frame-rate: root.frame-rate;
                                seek(seconds) => { root.seek(seconds); }
                            }
                            SummarySection { data: root.data; }
                            DestinationSection {
                                data: root.data;
                                phone: root.phone;
                                name-edited(name) => { root.name-edited(name); }
                                browse => { root.browse(); }
                            }
                            QualitySection {
                                data: root.data;
                                quality-changed(index) => { root.quality-changed(index); }
                            }
                        }

                        VerticalLayout {
                            alignment: start;
                            horizontal-stretch: 1;
                            OutputSection {
                                first: true;
                                data: root.data;
                                resolution-changed(index) => { root.resolution-changed(index); }
                                rate-changed(index) => { root.rate-changed(index); }
                                codec-changed(index) => { root.codec-changed(index); }
                                ten-bit-changed(on) => { root.ten-bit-changed(on); }
                                hdr-changed(on) => { root.hdr-changed(on); }
                            }
                            AdvancedSection {
                                always: true;
                                data: root.data;
                                advanced-toggled(on) => { root.advanced-toggled(on); }
                                rate-mode-changed(index) => { root.rate-mode-changed(index); }
                                bitrate-changed(text) => { root.bitrate-changed(text); }
                                color-range-changed(index) => { root.color-range-changed(index); }
                            }
                        }
                    }

                    // Three columns: the picture and what it is; what
                    // shape and where it goes; how good, the advanced
                    // groups open under it.
                    if !root.running && root.columns == 3: HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            alignment: start;
                            horizontal-stretch: 1;
                            PreviewSection {
                                first: true;
                                frame: root.preview-frame;
                                playhead: root.playhead;
                                duration: root.duration-seconds;
                                frame-rate: root.frame-rate;
                                seek(seconds) => { root.seek(seconds); }
                            }
                            SummarySection { data: root.data; }
                        }

                        VerticalLayout {
                            alignment: start;
                            horizontal-stretch: 1;
                            OutputSection {
                                first: true;
                                data: root.data;
                                resolution-changed(index) => { root.resolution-changed(index); }
                                rate-changed(index) => { root.rate-changed(index); }
                                codec-changed(index) => { root.codec-changed(index); }
                                ten-bit-changed(on) => { root.ten-bit-changed(on); }
                                hdr-changed(on) => { root.hdr-changed(on); }
                            }
                            DestinationSection {
                                data: root.data;
                                phone: root.phone;
                                name-edited(name) => { root.name-edited(name); }
                                browse => { root.browse(); }
                            }
                        }

                        VerticalLayout {
                            alignment: start;
                            horizontal-stretch: 1;
                            QualitySection {
                                first: true;
                                data: root.data;
                                quality-changed(index) => { root.quality-changed(index); }
                            }
                            AdvancedSection {
                                always: true;
                                data: root.data;
                                advanced-toggled(on) => { root.advanced-toggled(on); }
                                rate-mode-changed(index) => { root.rate-mode-changed(index); }
                                bitrate-changed(text) => { root.bitrate-changed(text); }
                                color-range-changed(index) => { root.color-range-changed(index); }
                            }
                        }
                    }
                }
            }

            // ── the footer ───────────────────────────────────────────────
            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            // The groups pad themselves; the footer is padded to match.
            Measure {
                padding: 14px;

                ExportFooter {
                    data: root.data;
                    narrow: root.columns == 1;
                    phone: root.phone;
                    begin => { root.begin(); }
                    cancel => { root.cancel(); }
                    reveal => { root.reveal(); }
                    again => { root.again(); }
                }
            }
        }
    }
}
