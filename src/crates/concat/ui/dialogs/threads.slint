import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, DialogRow, DialogSection, Field, Modal, Progress } from "../primitives/modal.slint";
import { ResizeBox } from "../primitives/resize-box.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Tip } from "../primitives/tooltip.slint";

export struct ThreadsFrameData {
    label: string,
    author: string,
    text: string,
    likes: string,
    replies: string,
    voice-ready: bool,
    voice-duration: string,
}

export struct ThreadsData {
    open: bool,
    url: string,
    running: bool,
    generating-voiceovers: bool,
    voiceovers-ready: bool,
    meme-file: string,
    stage: string,
    error: string,
    title: string,
    source-url: string,
    sort: int,
    voice-rate: int,
    selected-index: int,
    selected-label: string,
    selected-author: string,
    selected-text: string,
    selected-likes: string,
    scene-revision: int,
    remaining-comments: int,
    frames: [ThreadsFrameData],
}

component SceneIconButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> danger: false;

    callback clicked();

    property <bool> lit: touch.has-hover && root.enabled;

    width: 24px;
    height: 24px;
    border-radius: Theme.r-sm;
    opacity: root.enabled ? 1.0 : 0.35;
    background: root.danger && root.lit ? Theme.danger-wash
        : root.lit ? Theme.field-hover
        : Colors.transparent;
    border-width: root.danger && root.lit ? 1px : 0px;
    border-color: Theme.danger-edge;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 12px;
        tint: root.danger && root.lit ? Theme.danger
            : root.lit ? Theme.fg
            : Theme.fg-muted;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    Tip {
        text: root.tip;
        active: root.lit && root.tip != "";
    }
}

/// An additive entry point for the Threads quick-video workflow. It uses
/// Concat's launch-screen sheet and leaves ordinary project creation alone.
export component ThreadsDialog inherits Modal {
    in property <ThreadsData> data;

    callback url-edited(url: string);
    callback extract();
    callback select-frame(index: int);
    callback frame-author-edited(author: string);
    callback frame-text-edited(text: string);
    callback move-frame-up(index: int);
    callback move-frame-down(index: int);
    callback remove-frame(index: int);
    callback add-custom-frame();
    callback add-next-comment();
    callback reset-frames();
    callback sort-changed(index: int);
    callback voice-rate-changed(index: int);
    callback generate-voiceovers();
    callback choose-meme();
    callback remove-meme();
    callback create-project();

    open: root.data.open;
    title: I18n.t("threads.title");
    glyph: Glyph.film;
    dismissable: !root.data.running;
    surface-width: 700px;
    surface-height: 700px;

    property <int> draft-revision: -1;
    property <string> draft-author;
    property <string> draft-text;
    property <bool> typing-author;
    property <bool> typing-text;

    function sync-draft() {
        if (root.data.scene-revision != root.draft-revision || !root.typing-author) {
            root.draft-author = root.data.selected-author;
        }
        if (root.data.scene-revision != root.draft-revision || !root.typing-text) {
            root.draft-text = root.data.selected-text;
        }
        root.draft-revision = root.data.scene-revision;
    }

    init => { root.sync-draft(); }
    changed data => { root.sync-draft(); }

    VerticalLayout {
        // This form is mostly wrapping text and flexible controls. Give the
        // modal's scroll content a real width so it does not measure the form
        // at the minimum text width and leave most of the sheet empty.
        horizontal-stretch: 1;
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 16px;
        padding-bottom: 18px;
        spacing: 12px;

        Text {
            horizontal-stretch: 1;
            text: I18n.t("threads.intro");
            color: Theme.fg-muted;
            font-size: Theme.fs;
            wrap: word-wrap;
        }

        DialogSection {
            horizontal-stretch: 1;
            first: true;
            title: I18n.t("threads.sourceLink");

            HorizontalLayout {
                spacing: 8px;
                Field {
                    value: root.data.url;
                    placeholder: "https://www.threads.com/@name/post/...";
                    editable: !root.data.running;
                    edited(value) => { root.url-edited(value); }
                }
                Button {
                    primary: true;
                    large: true;
                    glyph: Glyph.import;
                    label: root.data.generating-voiceovers
                        ? I18n.t("threads.generatingVoices")
                        : root.data.running ? I18n.t("threads.extracting") : I18n.t("threads.fetch");
                    enabled: !root.data.running && root.data.url != "";
                    clicked => { root.extract(); }
                }
            }
        }

        if root.data.running: HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 10px;
            Progress { horizontal-stretch: 1; value: 0.18; live: true; }
            Text {
                text: root.data.stage == "" ? I18n.t("threads.extracting") : root.data.stage;
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }
        }

        if root.data.error != "": Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.r;
            background: Theme.danger-wash;
            border-width: 1px;
            border-color: Theme.danger-edge;
            height: notice.preferred-height + 18px;

            notice := Text {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                text: root.data.error;
                color: Theme.fg;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        if root.data.frames.length > 0: DialogSection {
            horizontal-stretch: 1;
            title: I18n.t1("threads.resultTitle", "\{root.data.frames.length}");
            choices: [I18n.t("threads.sortLikes"), I18n.t("threads.sortReplies")];
            choice: root.data.sort;
            chose(index) => { root.sort-changed(index); }

            VerticalLayout {
                spacing: 6px;

                for frame[index] in root.data.frames: Rectangle {
                    property <bool> is-selected: index == root.data.selected-index;
                    border-radius: Theme.r;
                    background: is-selected ? Theme.accent-soft : Theme.field;
                    border-width: 1px;
                    border-color: is-selected ? Theme.accent : Theme.line;
                    height: 68px;

                    // Declared first so action buttons inside the card take their own clicks.
                    TouchArea {
                        enabled: !root.data.running;
                        mouse-cursor: !root.data.running ? MouseCursor.pointer : MouseCursor.default;
                        clicked => { root.select-frame(index); }
                    }

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: "\{index + 1}. " + frame.label;
                                color: is-selected ? Theme.accent : Theme.fg;
                                font-size: Theme.fs;
                                font-weight: Theme.weight-title;
                                vertical-alignment: center;
                            }
                            Text {
                                text: frame.author;
                                color: Theme.fg-muted;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if frame.likes != "": Text {
                                text: "· " + I18n.t1("threads.likes", frame.likes);
                                color: Theme.fg-dim;
                                font-size: Theme.fs-xs;
                                vertical-alignment: center;
                            }
                            if frame.voice-ready: HorizontalLayout {
                                spacing: 3px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon { glyph: Glyph.check; size: 12px; tint: Theme.green; }
                                }
                                if frame.voice-duration != "": Text {
                                    text: frame.voice-duration;
                                    color: Theme.green;
                                    font-family: Theme.font-technical;
                                    font-size: Theme.fs-xs;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            SceneIconButton {
                                glyph: Glyph.chevron-up;
                                tip: I18n.t("threads.moveUp");
                                enabled: !root.data.running && index > 0;
                                clicked => { root.move-frame-up(index); }
                            }
                            SceneIconButton {
                                glyph: Glyph.chevron-down;
                                tip: I18n.t("threads.moveDown");
                                enabled: !root.data.running && index + 1 < root.data.frames.length;
                                clicked => { root.move-frame-down(index); }
                            }
                            SceneIconButton {
                                glyph: Glyph.trash;
                                tip: I18n.t("threads.removeScene");
                                danger: true;
                                enabled: !root.data.running && root.data.frames.length > 1;
                                clicked => { root.remove-frame(index); }
                            }
                        }

                        Text {
                            text: frame.text == "" ? I18n.t("threads.sceneTextPlaceholder") : frame.text;
                            color: frame.text == "" ? Theme.fg-dim : Theme.fg-muted;
                            font-size: Theme.fs-sm;
                            overflow: elide;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    padding-top: 2px;

                    Button {
                        glyph: Glyph.plus;
                        label: I18n.t1("threads.addComment", "\{root.data.remaining-comments}");
                        enabled: !root.data.running && root.data.remaining-comments > 0;
                        clicked => { root.add-next-comment(); }
                    }
                    Button {
                        glyph: Glyph.plus;
                        label: I18n.t("threads.addCustom");
                        enabled: !root.data.running;
                        clicked => { root.add-custom-frame(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        glyph: Glyph.reset;
                        ghost: true;
                        label: I18n.t("threads.resetScenes");
                        enabled: !root.data.running;
                        clicked => { root.reset-frames(); }
                    }
                }

                Rectangle {
                    border-radius: Theme.r;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.line;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: I18n.t1("threads.editScene", root.data.selected-label);
                                color: Theme.fg;
                                font-size: Theme.fs;
                                font-weight: Theme.weight-title;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: I18n.t1("threads.chars", "\{root.draft-text.character-count}");
                                color: Theme.fg-dim;
                                font-family: Theme.font-technical;
                                font-size: Theme.fs-xs;
                                vertical-alignment: center;
                            }
                        }

                        DialogRow {
                            label: I18n.t("threads.author");
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 28px;
                                border-radius: Theme.r;
                                background: Theme.field;
                                border-width: 1px;
                                border-color: author-input.has-focus ? Theme.accent : Theme.line;
                                clip: true;

                                TouchArea {
                                    enabled: !root.data.running;
                                    mouse-cursor: !root.data.running ? MouseCursor.text : MouseCursor.default;
                                    clicked => { author-input.focus(); }
                                }

                                author-input := TextInput {
                                    x: 10px;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width - 20px;
                                    height: self.preferred-height;
                                    text <=> root.draft-author;
                                    color: Theme.fg;
                                    font-size: Theme.fs;
                                    single-line: true;
                                    enabled: !root.data.running;
                                    selection-background-color: Theme.accent;
                                    selection-foreground-color: Theme.on-accent;
                                    changed has-focus => { root.typing-author = self.has-focus; }
                                    edited => { root.frame-author-edited(self.text); }
                                }
                            }
                        }

                        text-box := ResizeBox {
                            box-height: 76px;
                            min-box: 56px;
                            max-box: 160px;
                            ground: Theme.field;
                            pad-x: 10px;
                            pad-y: 7px;
                            content-height: scene-text.preferred-height;
                            focused: scene-text.has-focus;

                            scene-text := TextInput {
                                x: 0;
                                y: text-box.pad-y;
                                width: parent.width;
                                height: Math.max(self.preferred-height, text-box.view-height);
                                cursor-position-changed(at) => { text-box.reveal(at.y, self.font-size * 1.4); }
                                text <=> root.draft-text;
                                color: Theme.fg;
                                font-size: Theme.fs;
                                single-line: false;
                                wrap: word-wrap;
                                enabled: !root.data.running;
                                selection-background-color: Theme.accent;
                                selection-foreground-color: Theme.on-accent;
                                changed has-focus => { root.typing-text = self.has-focus; }
                                edited => { root.frame-text-edited(self.text); }
                            }

                            if root.draft-text == "" && !scene-text.has-focus: Text {
                                x: 0;
                                y: text-box.pad-y;
                                width: parent.width;
                                text: I18n.t("threads.sceneTextPlaceholder");
                                color: Theme.fg-dim;
                                font-size: Theme.fs;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        if root.data.frames.length > 0: DialogSection {
            horizontal-stretch: 1;
            title: I18n.t("threads.voiceAndMeme");

            DialogRow {
                label: I18n.t("threads.voiceSpeed");
                SegmentedControl {
                    options: ["1.0×", "1.15×", "1.25×", "1.35×"];
                    current: root.data.voice-rate;
                    enabled: !root.data.running;
                    changed(index) => { root.voice-rate-changed(index); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Icon { glyph: Glyph.sticker; size: 15px; tint: Theme.fg-dim; }
                }
                Text {
                    text: root.data.meme-file == ""
                        ? I18n.t("threads.memeOptional")
                        : root.data.meme-file;
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Button {
                    glyph: Glyph.image;
                    label: root.data.meme-file == ""
                        ? I18n.t("threads.chooseMeme")
                        : I18n.t("threads.changeMeme");
                    enabled: !root.data.running;
                    clicked => { root.choose-meme(); }
                }
                if root.data.meme-file != "": Button {
                    label: I18n.t("threads.removeMeme");
                    enabled: !root.data.running;
                    clicked => { root.remove-meme(); }
                }
            }
        }

        if root.data.frames.length == 0 && !root.data.running && root.data.error == "": Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: Theme.launch-well;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: Theme.r-lg;

            VerticalLayout {
                alignment: center;
                padding: 24px;
                spacing: 8px;
                HorizontalLayout {
                    alignment: center;
                    Icon { glyph: Glyph.link; size: 22px; tint: Theme.fg-dim; }
                }
                Text {
                    text: I18n.t("threads.empty");
                    color: Theme.fg-muted;
                    font-size: Theme.fs;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.data.frames.length > 0 || root.data.running || root.data.error != "": Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: end;
            spacing: 8px;
            if root.data.frames.length > 0 && !root.data.voiceovers-ready: Button {
                primary: true;
                large: true;
                glyph: Glyph.mic;
                label: root.data.generating-voiceovers
                    ? I18n.t("threads.generatingVoices")
                    : I18n.t("threads.generateVoices");
                enabled: !root.data.running;
                clicked => { root.generate-voiceovers(); }
            }
            if root.data.voiceovers-ready: Text {
                text: I18n.t("threads.voiceoversReady");
                color: Theme.accent;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }
            if root.data.voiceovers-ready: Button {
                primary: true;
                large: true;
                glyph: Glyph.plus;
                label: I18n.t("threads.createProject");
                clicked => { root.create-project(); }
            }
            Button {
                label: I18n.t("threads.close");
                enabled: !root.data.running;
                clicked => { root.closed(); }
            }
        }
    }
}
