import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, CopyChip, DialogRow, DialogSection, Field, Modal, Progress } from "../primitives/modal.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";
import { Switch } from "../inspector/controls.slint";

// Captions: what the tray's Captions tool opens.
//
// Two sheets in one, and a switch between them: "Use Sample Voice".
// On, the words are a clip's: one picked from the timeline's clips that
// have sound, through the transcriber, cut to the words' own timing. Off,
// they are a script typed here, one title per sentence at reading pace,
// laid down from the playhead. The list holds only clips with sound, so a
// silent video cannot be sent to the transcriber. The switch starts on
// when the sheet is opened on a clip with sound - from the clip's menu, or
// with one selected - and off otherwise. Then where the lines sit and how
// big they are, and one button. While it runs
// the sheet is the progress report: a transcription knows how far through
// the sound it is, so it gets a real bar and not a sweep. The language is
// the transcriber's to work out.
//
// On a desk it is a card floating over the editor (see Modal.floating): the
// timeline stays live under it, so the clip it transcribes follows the
// selection - a clip with sound selected is the one shown and run. Closed,
// a transcription goes on, and opened again the card shows it. On a phone
// it is a sheet.

/// What the preview card is told about the chosen style.
export struct CaptionsPreview {
    words: [string],
    sample: string,
    font: string,
    weight: int,
    colour: color,
    lit: bool,
    lit-colour: color,
    rainbow: bool,
    stroke-colour: color,
    stroke: float,
    background: color,
    motion: int,
    seconds: float,
    intensity: float,
    rtl: bool,
    name: string,
}

/// The chosen style, played: the words arrive with its motion, then are
/// lit one by one in its colour, over and over. It is Slint text, a close
/// picture of the result; the export is drawn by the text engine.
component CaptionPreviewCard inherits Rectangle {
    in property <CaptionsPreview> p;
    in-out property <float> t: 0;
    callback replay();
    height: 120px;
    border-radius: Theme.r;
    background: #17171c;
    clip: true;

    property <int> n: max(1, root.p.words.length);
    property <float> cycle: 0.6 + root.n * 0.5 + 1.0;
    property <float> prog: min(1.0, root.t / max(0.05, root.p.seconds));
    property <float> k: root.p.intensity;
    // The spoken word now lit: the words wait for the motion first.
    property <int> spoken: root.t < root.p.seconds ? -1 : min(root.n - 1, floor((root.t - root.p.seconds) / 0.5));
    property <float> fade: root.p.motion == 0 ? 1.0 : min(1.0, root.prog * (root.p.motion >= 5 ? 4.0 : 1.0));
    property <float> grow: root.p.motion == 2 ? 1 - (1 - root.prog) * 0.4 * root.k + 0.12 * root.k * Math.sin(root.prog * 180deg)
        : root.p.motion == 4 ? 1 - (1 - root.prog) * 0.4 * root.k
        : root.p.motion == 6 ? 1 + (1 - root.prog) * 0.35 * root.k * Math.cos(root.prog * 1080deg)
        : 1.0;
    property <length> dy: root.p.motion == 3 ? (1 - root.prog) * 24px * root.k
        : root.p.motion == 5 ? -Math.abs(Math.sin(root.prog * 540deg)) * (1 - root.prog) * 30px * root.k
        : 0px;
    property <length> dx: root.p.motion == 7 && root.prog < 1 ? Math.sin(root.t * 3600deg) * 8px * (1 - root.prog) * root.k : 0px;

    Timer {
        interval: 33ms;
        running: root.p.words.length > 0;
        triggered => {
            root.t += 0.033;
            if root.t > root.cycle {
                root.t = 0;
            }
        }
    }

    plate := Rectangle {
        x: (parent.width - self.width) / 2 + root.dx;
        y: (parent.height - self.height) / 2 + root.dy;
        width: row.preferred-width + 24px;
        height: row.preferred-height + 14px;
        background: root.p.background;
        border-radius: 6px;
        opacity: root.fade;
        transform-scale: root.grow;

        row := HorizontalLayout {
            alignment: center;
            spacing: 7px;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 7px;
            padding-bottom: 7px;

            for word[i] in root.p.words: Text {
                property <int> order: root.p.rtl ? root.n - 1 - i : i;
                text: word;
                font-family: root.p.font;
                font-weight: root.p.weight;
                font-size: 26px;
                color: root.p.lit && order == root.spoken
                    ? (root.p.rainbow
                        ? [#ff3b30, #ff9500, #ffcc00, #34c759, #5ac8fa, #5856d6, #ff2d92][Math.mod(order, 7)]
                        : root.p.lit-colour)
                    : root.p.colour;
                stroke: root.p.stroke-colour;
                stroke-width: root.p.stroke * 52px;
            }
        }
    }

    Rectangle {
        x: 8px;
        y: 8px;
        width: replay-label.preferred-width + 16px;
        height: 24px;
        border-radius: 12px;
        background: #ffffff22;
        replay-label := Text {
            text: I18n.t("captions.replay");
            color: #ffffffcc;
            font-size: Theme.fs-sm;
        }
        TouchArea {
            clicked => { root.t = 0; root.replay(); }
        }
    }
}

export struct CaptionsSheetData {
    open: bool,
    /// "Use Sample Voice": the words come from a clip's sound.
    from-voice: bool,
    /// The timeline's clips with sound, by file and start.
    sources: [string],
    /// Row in `sources` of the clip to transcribe; -1 for none.
    source: int,
    text: string,
    /// Row in the installed transcriber list.
    model: int,
    /// 0 Bottom, 1 Centre, 2 Top
    placement: int,
    /// 0 Small, 1 Medium, 2 Large
    size: int,
    running: bool,
    /// 0 the local transcriber, 1 Gemini.
    engine: int,
    /// Gemini: a key is saved in the system's credential store.
    gemini-key: bool,
    /// Gemini: a connection test is running.
    gemini-testing: bool,
    /// Gemini: what the last save or test said.
    gemini-status: string,
    /// Gemini: the models the key can see.
    gemini-models: [string],
    gemini-model: int,
    /// Gemini: the speech languages offered, by their own names.
    gemini-languages: [string],
    gemini-language: int,
    /// Gemini: how the captions appear, by name, and the row chosen.
    gemini-reveals: [string],
    gemini-reveal: int,
    /// The motions the captions lane can be given, by name, and the row.
    motions: [string],
    motion: int,
    /// How fast and how strong a motion is, by name, and the rows.
    speeds: [string],
    speed: int,
    strengths: [string],
    intensity: int,
    /// The styles captions can be made in: the kept look, then the presets.
    styles: [string],
    style: int,
    /// The shelves the style list can be narrowed to, and the row.
    categories: [string],
    category: int,
    /// The chosen style, as the preview card plays it.
    preview: CaptionsPreview,
    /// The colours the spoken word can be lit in, and the row.
    highlights: [string],
    highlight: int,
    /// The faces captions can be set in: automatic, then the bundled ones.
    fonts: [string],
    font: int,
    /// Gemini: what sending the clip's sound will cost, in words; shown
    /// before anything leaves the machine.
    gemini-notice: string,
    /// 0..1: where the transcription surely is.
    progress: float,
    /// Where the step under way leaves the bar, 0..1.
    ceiling: float,
    /// Seconds that step should take.
    step: float,
    /// Seconds of the run still to go, once the work has been timed;
    /// negative before.
    left: float,
    /// What the run is doing, in words.
    stage: string,
    /// A transcriber model is installed.
    ready: bool,
    /// Why the last run failed, when it did.
    message: string,
}

export component CaptionsDialog inherits Modal {
    in property <CaptionsSheetData> data;
    /// The installed transcriber models, by name.
    in property <[string]> models;

    callback voice-toggled(on: bool);
    callback source-changed(index: int);
    callback text-edited(text: string);
    callback model-changed(index: int);
    callback placement-changed(index: int);
    callback size-changed(index: int);
    callback engine-changed(index: int);
    callback gemini-key-saved(key: string);
    callback gemini-key-cleared();
    callback gemini-test();
    callback gemini-model-changed(index: int);
    callback gemini-language-changed(index: int);
    callback gemini-reveal-changed(index: int);
    callback motion-changed(index: int);
    callback apply-motion();
    callback speed-changed(index: int);
    callback intensity-changed(index: int);
    callback style-changed(index: int);
    callback category-changed(index: int);
    callback sample-edited(text: string);
    callback apply-style();
    callback highlight-changed(index: int);
    callback apply-highlight();
    callback font-changed(index: int);
    callback apply-font();
    callback begin();
    callback cancel();
    callback import-srt();
    callback export-srt();
    callback export-ass();

    property <bool> from-voice: root.data.from-voice;

    open: root.data.open;
    title: I18n.t("captions.captions");
    glyph: Glyph.text-mark;
    surface-width: 480px;
    dismissable: !root.data.running;

    // The script being typed, held apart from `data.text` the way the Field
    // primitive holds its draft: a TextInput's binding is dropped on the
    // first keystroke, so the sheet re-seeds it when it opens and never
    // while it is being typed into.
    property <string> draft;
    /// The script has the caret. Kept up here because the box lives under
    /// an `if`, and nothing outside one can reach into it.
    property <bool> typing;
    changed data => {
        if (!root.typing) {
            root.draft = root.data.text;
        }
    }
    init => { root.draft = root.data.text; }

    // The key being typed, held up here and never sent anywhere until
    // Save: it is cleared the moment it is handed over.
    property <string> key-draft;

    VerticalLayout {
        if !root.data.running && !root.from-voice: DialogSection {
            first: true;
            title: I18n.t("common.script");

            Rectangle {
                height: 104px;
                border-radius: Theme.r;
                background: Theme.well;
                border-width: 1px;
                border-color: script.has-focus ? Theme.accent : Theme.line;
                clip: true;

                script := TextInput {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    text <=> root.draft;
                    color: Theme.fg;
                    font-size: Theme.fs-lg;
                    single-line: false;
                    wrap: word-wrap;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                    changed has-focus => { root.typing = self.has-focus; }
                    edited => { root.text-edited(self.text); }
                    // Home and End are unbound in Slint on macOS and would
                    // walk up to the window's playhead shortcuts.
                    key-pressed(event) => {
                        if (event.text == Key.Home) {
                            self.set-selection-offsets(0, 0);
                            return accept;
                        }
                        if (event.text == Key.End) {
                            self.set-selection-offsets(1000000000, 1000000000);
                            return accept;
                        }
                        return reject;
                    }
                }

                if root.draft == "" && !script.has-focus: Text {
                    x: 10px;
                    y: 8px;
                    text: I18n.t("captions.typeWordsPutScreen");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-lg;
                }
            }
        }

        // The switch, under the script it stands in for: off, the words
        // are typed above it; on, they come from a clip's voice, chosen
        // under it. A row of its own rather than a DialogRow, whose label
        // column is too narrow for the words.
        if !root.data.running: HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 14px;
            spacing: 10px;

            Text {
                horizontal-stretch: 1;
                text: I18n.t("captions.transcribeClipVoice");
                color: Theme.fg;
                font-size: Theme.fs;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            VerticalLayout {
                alignment: center;
                Switch {
                    checked: root.from-voice;
                    toggled(on) => { root.voice-toggled(on); }
                }
            }
        }

        if !root.data.running && root.from-voice: DialogSection {
            first: true;
            title: I18n.t("captions.engine");

            DialogRow {
                label: I18n.t("captions.engine");
                SegmentedControl {
                    options: [I18n.t("captions.engineLocal"), "Gemini"];
                    current: root.data.engine;
                    changed(index) => { root.engine-changed(index); }
                }
            }
        }

        if !root.data.running && root.from-voice && root.data.engine == 0: DialogSection {
            title: I18n.t("common.transcriber");

            DialogRow {
                label: I18n.t("common.audio");
                Select {
                    options: root.data.sources;
                    current: root.data.source;
                    placeholder: I18n.t("captions.noVoiceOnTimeline");
                    enabled: root.data.sources.length > 0;
                    changed(index) => { root.source-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("common.model");
                Select {
                    options: root.models;
                    current: root.data.model;
                    placeholder: I18n.t("common.noneInstalled");
                    enabled: root.models.length > 0;
                    changed(index) => { root.model-changed(index); }
                }
            }

            if !root.data.ready: Text {
                text: I18n.t("captions.downloadTranscriberModelFirst");
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        if !root.data.running && root.from-voice && root.data.engine == 1: DialogSection {
            title: "Gemini";

            DialogRow {
                label: I18n.t("common.audio");
                Select {
                    options: root.data.sources;
                    current: root.data.source;
                    placeholder: I18n.t("captions.noVoiceOnTimeline");
                    enabled: root.data.sources.length > 0;
                    changed(index) => { root.source-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("captions.apiKey");
                HorizontalLayout {
                    spacing: 6px;
                    Field {
                        value: root.key-draft;
                        secret: true;
                        technical: true;
                        placeholder: root.data.gemini-key ? I18n.t("captions.geminiKeyIsSaved") : I18n.t("captions.pasteApiKey");
                        edited(text) => { root.key-draft = text; }
                    }
                    Button {
                        label: I18n.t("captions.saveKey");
                        enabled: root.key-draft != "";
                        clicked => {
                            root.gemini-key-saved(root.key-draft);
                            root.key-draft = "";
                        }
                    }
                }
            }

            DialogRow {
                label: I18n.t("common.model");
                Select {
                    options: root.data.gemini-models;
                    current: root.data.gemini-model;
                    enabled: root.data.gemini-models.length > 0;
                    changed(index) => { root.gemini-model-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("captions.speechLanguage");
                Select {
                    options: root.data.gemini-languages;
                    current: root.data.gemini-language;
                    changed(index) => { root.gemini-language-changed(index); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    label: root.data.gemini-testing ? I18n.t("captions.testing") : I18n.t("captions.testConnection");
                    ghost: true;
                    enabled: root.data.gemini-key && !root.data.gemini-testing;
                    clicked => { root.gemini-test(); }
                }
                if root.data.gemini-key: Button {
                    label: I18n.t("captions.removeKey");
                    ghost: true;
                    clicked => { root.gemini-key-cleared(); }
                }
            }

            if root.data.gemini-status != "": Text {
                text: root.data.gemini-status;
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            // Said before the first byte leaves the machine.
            Text {
                text: root.data.gemini-notice;
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        if !root.data.running: DialogSection {
            title: I18n.t("captions.captions");

            DialogRow {
                label: I18n.t("captions.placement");
                SegmentedControl {
                    options: [I18n.t("common.bottom"), I18n.t("captions.centre"), I18n.t("common.top")];
                    current: root.data.placement;
                    changed(index) => { root.placement-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("common.size");
                SegmentedControl {
                    options: [I18n.t("common.small"), I18n.t("common.medium"), I18n.t("common.large")];
                    current: root.data.size;
                    changed(index) => { root.size-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("captions.motion");
                HorizontalLayout {
                    spacing: 6px;
                    Select {
                        options: root.data.motions;
                        current: root.data.motion;
                        changed(index) => { root.motion-changed(index); }
                    }
                    Button {
                        label: I18n.t("captions.applyMotion");
                        ghost: true;
                        clicked => { root.apply-motion(); }
                    }
                }
            }

            DialogRow {
                label: I18n.t("captions.speed");
                HorizontalLayout {
                    spacing: 6px;
                    Select {
                        options: root.data.speeds;
                        current: root.data.speed;
                        changed(index) => { root.speed-changed(index); }
                    }
                    Select {
                        options: root.data.strengths;
                        current: root.data.intensity;
                        changed(index) => { root.intensity-changed(index); }
                    }
                }
            }

            DialogRow {
                label: I18n.t("captions.font");
                HorizontalLayout {
                    spacing: 6px;
                    Select {
                        options: root.data.fonts;
                        current: root.data.font;
                        changed(index) => { root.font-changed(index); }
                    }
                    Button {
                        label: I18n.t("captions.applyFont");
                        ghost: true;
                        clicked => { root.apply-font(); }
                    }
                }
            }

            DialogRow {
                label: I18n.t("captions.highlight");
                HorizontalLayout {
                    spacing: 6px;
                    Select {
                        options: root.data.highlights;
                        current: root.data.highlight;
                        changed(index) => { root.highlight-changed(index); }
                    }
                    Button {
                        label: I18n.t("captions.applyHighlight");
                        ghost: true;
                        clicked => { root.apply-highlight(); }
                    }
                }
            }

            CaptionPreviewCard {
                p: root.data.preview;
            }

            DialogRow {
                label: I18n.t("captions.sample");
                Field {
                    value: root.data.preview.sample;
                    placeholder: I18n.t("captions.samplePlaceholder");
                    edited(text) => { root.sample-edited(text); }
                }
            }

            DialogRow {
                label: I18n.t("captions.category");
                Select {
                    options: root.data.categories;
                    current: root.data.category;
                    changed(index) => { root.category-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("captions.style");
                HorizontalLayout {
                    spacing: 6px;
                    Select {
                        options: root.data.styles;
                        current: root.data.style;
                        changed(index) => { root.style-changed(index); }
                    }
                    Button {
                        label: I18n.t("captions.applyStyle");
                        ghost: true;
                        clicked => { root.apply-style(); }
                    }
                }
            }

            Text {
                text: root.from-voice
                    ? I18n.t("captions.oneTitlePerPhrase")
                    : I18n.t("captions.oneTitlePerSentence");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            if root.data.message != "": Rectangle {
                border-radius: Theme.r;
                background: Theme.danger-soft;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: start;
                        Icon { glyph: Glyph.close; size: 13px; tint: Theme.danger; }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.message;
                        color: Theme.danger;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        alignment: start;
                        CopyChip { text: root.data.message; }
                    }
                }
            }

            if root.data.running: VerticalLayout {
                spacing: 8px;

                row := HorizontalLayout {
                    spacing: 8px;
                    // The time left, once the work has been timed: counted down
                    // from the last report, and gone in the last second.
                    property <int> left: Math.ceil(Math.max(0, root.data.left - bar.since / 1s));

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.stage;
                        color: Theme.fg;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }

                    if root.data.left >= 0 && row.left > 0: Text {
                        text: I18n.t2("common.aboutLeft", "\{Math.floor(row.left / 60)}",
                            (Math.mod(row.left, 60) < 10 ? "0" : "") + "\{Math.mod(row.left, 60)}");
                        color: Theme.fg-dim;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "\{Math.floor(bar.shown * 100)}%";
                        color: Theme.fg-muted;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                }

                bar := Progress {
                    value: root.data.progress;
                    ceiling: root.data.ceiling;
                    step: root.data.step * 1s;
                    live: true;
                }
            }

            if root.data.running: HorizontalLayout {
                alignment: start;
                Button {
                    label: I18n.t("common.cancel");
                    glyph: Glyph.close;
                    ghost: true;
                    clicked => { root.cancel(); }
                }
            }

            if !root.data.running: Button {
                block: true;
                primary: true;
                large: true;
                glyph: Glyph.text-mark;
                label: root.from-voice ? I18n.t("captions.generateCaptions") : I18n.t("captions.addCaptions");
                enabled: root.from-voice ? root.data.ready && root.data.source >= 0 : root.draft != "";
                clicked => { root.begin(); }
            }

            // Captions as a SubRip file: one read in as titles with the
            // look above, timed as the file says; or a lane of titles
            // written out: the selected title's lane, or with none
            // selected the lane with the most titles, the captions'.
            if !root.data.running: HorizontalLayout {
                spacing: 8px;

                Button {
                    horizontal-stretch: 1;
                    block: true;
                    ghost: true;
                    glyph: Glyph.import;
                    label: I18n.t("captions.importSrt");
                    clicked => { root.import-srt(); }
                }

                Button {
                    horizontal-stretch: 1;
                    block: true;
                    ghost: true;
                    glyph: Glyph.export;
                    label: I18n.t("captions.exportSrt");
                    clicked => { root.export-srt(); }
                }
            }
            // The same lane with each title's look: font, colour, outline,
            // shadow, plate and place, for a player or editor that reads ASS.
            if !root.data.running: Button {
                block: true;
                ghost: true;
                glyph: Glyph.export;
                label: I18n.t("captions.exportAss");
                clicked => { root.export-ass(); }
            }
        }
    }
}
