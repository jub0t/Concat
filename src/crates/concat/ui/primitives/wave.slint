import { Theme } from "../theme/theme.slint";

// A waveform drawn: the bars in `tint`, standing about the centre line and
// scaled by `gain`, and the part of them past the hot lines - above the
// upper one, below the lower - drawn again in the hot colour: the same
// path, clipped to the two bands. The path is at unity (see
// `format::wave_path`), so the gain is a layout property here and a
// volume drag costs no rebuild; a gain over one pushes the bars past the
// edges and the box clips them, which is what full scale looks like.
export component Wave inherits Rectangle {
    in property <string> commands;
    in property <float> gain: 1;
    in property <brush> tint;
    /// A line through the middle, at any gain: silence read as a hairline
    /// for a path drawn with no floor, which a quiet passage turned up grows
    /// out of with its own shape (see `format::wave_path`).
    in property <bool> hairline;

    property <length> bars-h: root.height * Math.max(0, root.gain);
    property <length> bars-y: (root.height - root.bars-h) / 2;
    /// How far from the middle the hot band begins, either way.
    property <length> hot-inset: root.height * (1 - Theme.wave-hot-line) / 2;

    clip: true;

    if root.hairline: Rectangle {
        x: 0;
        y: (root.height - 1px) / 2;
        width: root.width;
        height: 1px;
        background: root.tint;
    }

    Path {
        x: 0;
        y: root.bars-y;
        width: root.width;
        height: root.bars-h;
        commands: root.commands;
        viewbox-width: 1;
        viewbox-height: 1;
        fit: fill;
        fill: root.tint;
    }

    for band in [0, 1]: Rectangle {
        x: 0;
        y: band == 0 ? 0 : root.height - root.hot-inset;
        width: root.width;
        height: root.hot-inset;
        clip: true;

        Path {
            x: 0;
            y: root.bars-y - parent.y;
            width: root.width;
            height: root.bars-h;
            commands: root.commands;
            viewbox-width: 1;
            viewbox-height: 1;
            fit: fill;
            fill: Theme.wave-hot;
        }
    }
}
