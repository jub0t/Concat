import { Theme } from "../theme/theme.slint";

// A waveform drawn: the bars in `tint`, scaled by `gain` from the floor
// up, the part of them over the hot line (-6 dBFS) drawn again in the hot
// amber and the part over the clip line (-1 dBFS) again in red - the same
// path each time, clipped to the band above its line. A meter's three
// zones, laid along the sound. The path is at
// unity (see `format::wave_path`), so the gain is a layout property here
// and a volume drag costs no rebuild; a gain over one pushes the bars past
// the top and the box clips them, which is what full scale looks like.
export component Wave inherits Rectangle {
    in property <string> commands;
    in property <float> gain: 1;
    in property <brush> tint;

    property <length> bars-h: root.height * Math.max(0, root.gain);
    property <length> bars-y: root.height - root.bars-h;
    /// The band over the hot line, from the top down.
    property <length> hot-h: root.height * (1 - Theme.wave-hot-line);
    /// The band over the clip line.
    property <length> clip-h: root.height * (1 - Theme.wave-clip-line);

    clip: true;

    Path {
        x: 0;
        y: root.bars-y;
        width: root.width;
        height: root.bars-h;
        commands: root.commands;
        viewbox-width: 1;
        viewbox-height: 1;
        fit: fill;
        fill: root.tint;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.hot-h;
        clip: true;

        Path {
            x: 0;
            y: root.bars-y;
            width: root.width;
            height: root.bars-h;
            commands: root.commands;
            viewbox-width: 1;
            viewbox-height: 1;
            fit: fill;
            fill: Theme.wave-hot;
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.clip-h;
        clip: true;

        Path {
            x: 0;
            y: root.bars-y;
            width: root.width;
            height: root.bars-h;
            commands: root.commands;
            viewbox-width: 1;
            viewbox-height: 1;
            fit: fill;
            fill: Theme.wave-clip;
        }
    }
}
