import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { FocusRing } from "focus-ring.slint";
import { Tip } from "tooltip.slint";

// A single choice among a few, as one row of segments.
//
// Two looks. In a panel's body it is a field like the others there - the
// field's ground and hairline, the segments split by hairlines, the one
// chosen outlined and washed in the accent - so a choice reads as a value
// set, not as a set of pages. `tabs` is the header's look instead, a well
// with a raised thumb, for the strips that do switch what a panel shows;
// it belongs nowhere else.
//
// The segments share the width equally, so the thumb's geometry is computed
// from the count rather than measured from the buttons. A `current` out of
// range - none of them, as a mix of one's own is neither preset - lights
// nothing.
export component SegmentedControl inherits Rectangle {
    in property <[string]> options;
    /// A glyph per option, in the same order. A segment with one wears it
    /// in place of its word - three alignments are three marks, not three
    /// words - and the word stays as its accessible name. Shorter than
    /// `options` is fine; a segment past the end keeps its word.
    in property <[Glyph]> icons;
    in-out property <int> current;
    in property <bool> enabled: true;
    /// Segments that cannot be picked, by index: greyed, and refused
    /// by a click or the arrow keys. Shorter than `options` is fine; a
    /// segment past the end can be picked.
    in property <[bool]> disabled;

    /// The header's look, for a strip that switches pages; see above.
    in property <bool> tabs: false;

    callback changed(index: int);

    property <bool> ring;
    property <bool> lit: root.current >= 0 && root.current < root.options.length;

    // 1px border + 2px padding, so the track insets by 3px on every side. A
    // Slint border is drawn inside the bounds but children still measure from
    // the outer edge, so the border has to be added in by hand.
    property <length> inset: root.tabs ? 3px : 0px;
    property <length> seg-w: (root.width - 2 * root.inset) / Math.max(root.options.length, 1);

    /// Every segment wears a mark: the control is only as wide as the
    /// marks need, not the row - icons say it in less room than words.
    property <bool> marks-only: root.options.length > 0 && root.icons.length >= root.options.length;
    property <length> marks-w: root.options.length * 36px + 2 * root.inset;

    height: Theme.h;
    min-width: root.marks-only ? root.marks-w : 120px;
    max-width: root.marks-only ? root.marks-w : 100000px;
    horizontal-stretch: root.marks-only ? 0 : 1;
    background: root.tabs ? Theme.well : Theme.field;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: Theme.r;
    opacity: root.enabled ? 1.0 : 0.45;

    function select(index: int) {
        if (index >= 0 && index < root.options.length && !root.disabled[index]) {
            root.current = index;
            root.changed(index);
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        // :focus-visible — keyboard focus only, see IconButton.
        focus-gained(reason) => {
            root.ring = reason == FocusReason.tab-navigation;
        }
        focus-lost(reason) => {
            root.ring = false;
        }
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                root.select(Math.mod(root.current + 1, root.options.length));
                return EventResult.accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.select(Math.mod(root.current - 1 + root.options.length, root.options.length));
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    thumb := Rectangle {
        visible: root.lit;
        x: root.inset + root.current * root.seg-w;
        y: root.inset;
        width: root.seg-w;
        height: root.height - 2 * root.inset;
        border-radius: root.tabs ? Theme.r-sm : Theme.r;
        background: root.tabs ? Theme.field-hover : Theme.accent-soft;
        border-width: root.tabs ? 0px : 1px;
        border-color: Theme.accent;

        animate x, width { duration: 180ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    }

    for option[index] in root.options: Rectangle {
        x: root.inset + index * root.seg-w;
        y: root.inset;
        width: root.seg-w;
        height: root.height - 2 * root.inset;

        // A hairline between two segments, in the body's look; none
        // beside the one chosen, whose outline is its edge.
        if index > 0 && !root.tabs: Rectangle {
            x: 0;
            y: 6px;
            width: 1px;
            height: parent.height - 12px;
            background: Theme.line;
            visible: !root.lit || (index != root.current && index != root.current + 1);
        }

        // The segment's whole box, so the label can centre in it; see the
        // note on IconButton's text in panel.slint for why a Text needs to
        // be handed one.
        if index >= root.icons.length: Text {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: option;
            color: root.disabled[index] ? Theme.fg-dim
                : index == root.current ? (root.tabs ? Theme.fg : Theme.accent)
                : segment.has-hover ? Theme.fg : Theme.fg-muted;
            font-size: Theme.fs;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;

            animate color { duration: 140ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
        }
        if index < root.icons.length: Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            glyph: root.icons[index];
            size: 14px;
            tint: index == root.current ? (root.tabs ? Theme.fg : Theme.accent)
                : segment.has-hover ? Theme.fg : Theme.fg-muted;
        }

        // A mark's name, on hover: the word it stands in for.
        if index < root.icons.length: Tip {
            text: option;
            active: segment.has-hover;
        }

        segment := TouchArea {
            enabled: root.enabled && !root.disabled[index];
            mouse-cursor: pointer;
            clicked => {
                fs.focus();
                root.select(index);
            }
        }
    }

    FocusRing {
        active: root.ring;
        radius: Theme.r;
    }
}
