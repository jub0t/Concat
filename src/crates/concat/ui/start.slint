import { I18n } from "i18n.slint";
import { Theme } from "theme/theme.slint";
import { CopyChip } from "primitives/modal.slint";
import { Glyph, Icon } from "icons.slint";
import { SegmentedControl } from "primitives/segmented-control.slint";
import { ThinScrollbar } from "primitives/scrollbar.slint";

// The launch screen.
//
// Full-bleed on the window's own ground — no card, no border, no shadow. A
// setup screen is not a dialog floating over something; it *is* the window,
// and framing it as a card only adds an edge that means nothing. Hierarchy
// comes from type size and whitespace instead, which is why this is the one
// surface in the app with a display-sized heading on it.
//
// An editor should not drop you straight into an untitled timeline either: the
// frame rate, the frame size and where the folder goes are decisions the whole
// edit depends on, and choosing them after material is cut is how you end up
// conforming footage.
//
// The form and the recents are the whole of the screen, and they take three
// shapes by the width they are given, since a Slint layout has no wrap:
//
// - wide: the form with the recents in a column beside it;
// - middle: the form across the width, the recents under it;
// - narrow, a phone held upright: every label above its value, every control
//   across the width, the button across the width, and the forget cross on
//   every recent row, since there is no hover to reveal it with.
//
// There is no template store in this tree, which is also why the library's
// "save as template" is an unwired seam.

/// One row of the Recent column.
///
/// The two lines under the name arrive formatted. A decimal frame rate to two
/// places and a coarse "4 days ago" are both easier to produce where the
/// numbers are than in an expression language with no printf and no clock.
export struct RecentProjectData {
    /// The folder, and the row's identity — what reopening and forgetting name.
    path: string,
    name: string,
    /// "1080 x 1920 · 30.00 fps"
    detail: string,
    /// "yesterday", "4 days ago"
    when: string,
    /// A frame from the earliest clip on its timeline, once something has
    /// produced one. Empty falls back to a quiet film mark rather than an
    /// error: the launch screen is not the place to complain about footage.
    poster: image,
}

/// The form, as one struct — the same shape the two dialogs use, and for the
/// same reason: it is one screen's worth of state and a partial update is how
/// a panel ends up showing half of two things.
export struct StartData {
    name: string,
    location: string,
    /// Index into `resolutions`; the numbers behind it are Rust's.
    resolution: int,
    /// Index into `rates`.
    rate: int,
    /// "1920 x 1080"
    size-readout: string,
    /// The chosen frame's width over its height, for the swatch beside the
    /// readout that shows its shape: 1.78 for landscape HD, 0.56 upright.
    frame-aspect: float,
    /// "30/1 fps" — the exact fraction, because 29.97 is 30000/1001 and never
    /// anything else.
    rate-readout: string,
    /// Creating. The button says so and everything is refused meanwhile.
    busy: bool,
    /// Non-empty puts up the notice above the button.
    error: string,
}

// A labelled row with a hairline under it, in the style of a settings list.
// Beside the value where there is room; above it where there is not.
component Field inherits Rectangle {
    in property <string> label;
    /// The last row carries no rule: there is nothing under it to divide from.
    in property <bool> last;
    /// The label over the value rather than beside it: the narrow shape.
    in property <bool> stacked;

    /// The label column. Wide enough for "Resolution" and "Frame rate" at
    /// 13px without wrapping, which is what keeps every value on one x.
    property <length> label-w: 112px;
    property <length> body-x: root.stacked ? 0px : root.label-w + 16px;
    property <length> body-y: root.stacked ? 38px : 16px;

    height: root.body-y + body.preferred-height + 16px;

    Text {
        x: 0;
        y: root.stacked ? 14px : 16px;
        width: root.stacked ? root.width : root.label-w;
        text: root.label;
        color: Theme.fg-muted;
        font-size: Theme.fs-lg;
    }

    body := VerticalLayout {
        x: root.body-x;
        y: root.body-y;
        width: root.width - root.body-x;
        height: self.preferred-height;
        spacing: 8px;

        @children
    }

    if !root.last: Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.line;
    }
}

// A field's editable line: no box, no ground, just the text on the row it is
// in. The rules between the rows are already saying where one value ends and
// the next begins, so a border round each one is the same fact twice.
component PlainInput inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <length> size: Theme.fs-input;
    in property <string> face: Theme.font;
    in property <bool> enabled: true;
    /// Takes the caret when the screen opens, and selects what is there — so
    /// the default name can be replaced by typing rather than by clearing it
    /// first.
    in property <bool> autofocus;

    callback edited(text: string);
    callback accepted();

    height: Math.max(22px, root.size + 8px);

    // The text being edited, held apart from `text`.
    //
    // A TextInput writes to whatever it is bound to, and an assignment in
    // Slint replaces the binding — so binding straight to the published value
    // works for one keystroke and then goes deaf. Seeded instead, and never
    // while the field has focus, so a republish mid-word cannot yank the
    // caret. Same as `Field` in primitives/modal.slint, same reason.
    property <string> draft;
    function seed() { root.draft = root.text; }
    init => {
        root.seed();
        if (root.autofocus) {
            input.focus();
            input.select-all();
        }
    }
    changed text => {
        if (!input.has-focus) {
            root.seed();
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    input := TextInput {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        // A TextInput fills its Rectangle parent by default, so without this
        // the centring above subtracts the parent's own height from itself
        // and resolves to zero, leaving the text against the top edge. Same
        // fix, and the same reason, as Field in modal.slint.
        height: self.preferred-height;
        text <=> root.draft;
        color: Theme.fg;
        font-family: root.face;
        font-size: root.size;
        single-line: true;
        read-only: !root.enabled;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;

        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }

    if root.draft == "": Text {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        text: root.placeholder;
        color: Theme.fg-dim;
        font-family: root.face;
        font-size: root.size;
        overflow: elide;
    }
}

// The one accent-coloured word in the form. A link and not a button: it opens
// a picker for the field beside it rather than doing anything to the project,
// and a filled button here would out-shout Create.
component LinkButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;

    callback clicked();

    width: text.preferred-width;
    height: 20px;
    opacity: root.enabled ? (touch.has-hover ? 0.7 : 1.0) : 0.4;

    animate opacity { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    text := Text {
        x: 0;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: Theme.accent;
        font-size: Theme.fs-lg;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The shape of the chosen frame, beside its numbers: a box of the frame's
// own proportions in a square of room, so 9:16 reads as upright at a glance
// and 4:3 as nearly square, without anyone reading the digits.
component FrameShape inherits Rectangle {
    in property <float> aspect: 16 / 9;
    property <float> shape: Math.max(0.2, Math.min(5.0, root.aspect));
    property <length> room: 40px;

    width: root.room;
    height: root.room;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.shape >= 1 ? root.room : root.room * root.shape;
        height: root.shape >= 1 ? root.room / root.shape : root.room;
        border-radius: Theme.r-xs;
        background: Theme.well;
        border-width: 1px;
        border-color: Theme.line-strong;

        animate width, height { duration: 160ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    }
}

// One project in the Recent column: poster, name, what it is, when it was
// last open — and the cross that forgets it: on hover where there is a
// pointer, always where there is not.
component RecentRow inherits Rectangle {
    in property <RecentProjectData> project;
    in property <bool> enabled: true;
    /// The narrow shape: a smaller poster, and the forget cross always
    /// there, since a finger cannot hover.
    in property <bool> compact;

    callback opened();
    callback forgotten();

    property <length> poster-w: root.compact ? 72px : 96px;
    property <bool> forgettable: root.compact || touch.has-hover;

    height: root.poster-w * 9 / 16 + 22px;
    border-radius: Theme.r-lg;
    background: touch.has-hover ? Theme.field : Colors.transparent;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.opened(); }

        poster := Rectangle {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: root.poster-w;
            height: self.width * 9 / 16;
            border-radius: Theme.r;
            background: Theme.well;
            border-width: 1px;
            border-color: Theme.line;
            clip: true;

            if root.project.poster.width > 0: Image {
                width: parent.width;
                height: parent.height;
                source: root.project.poster;
                image-fit: cover;
            }

            if root.project.poster.width == 0: Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                glyph: Glyph.film;
                size: 17px;
                weight: 1.5;
                tint: Theme.fg-dim;
            }
        }

        VerticalLayout {
            x: poster.x + poster.width + 12px;
            y: (parent.height - self.preferred-height) / 2;
            width: parent.width - poster.width - 20px - 34px;
            height: self.preferred-height;
            spacing: 2px;

            Text {
                text: root.project.name;
                color: Theme.fg;
                font-size: Theme.fs-xl;
                overflow: elide;
            }

            Text {
                text: root.project.detail;
                color: Theme.fg-dim;
                font-family: Theme.font-technical;
                font-size: Theme.fs-sm;
                overflow: elide;
            }

            Text {
                text: root.project.when;
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                overflow: elide;
            }
        }

        // Hover-only where there is a pointer, like the bin's card: a
        // permanent cross on every row of a list of your own work is a list
        // of invitations to lose one. On a phone there is no hover, so it
        // stays, quiet, at the row's end.
        if root.forgettable: Rectangle {
            x: parent.width - self.width - 8px;
            y: (parent.height - self.height) / 2;
            width: 28px;
            height: 28px;
            border-radius: Theme.r-xs;
            background: forget.has-hover ? Theme.field-active : Colors.transparent;

            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                glyph: Glyph.close;
                size: 12px;
                tint: forget.has-hover ? Theme.fg : Theme.fg-dim;
            }

            forget := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.forgotten(); }
            }
        }
    }
}

// The Recent column. Its own component because it appears in two places: to
// the right of the form when there is room, and under it when there is not.
//
// No empty state — a "Recent" heading over nothing is worse than no heading —
// so whoever places this only places it when there is something to show.
component RecentsColumn inherits VerticalLayout {
    in property <[RecentProjectData]> recents;
    in property <bool> enabled: true;
    in property <bool> compact;
    /// The rule above the heading, for the stacked arrangement. Beside the
    /// form there is a whole column of air doing that job already.
    in property <bool> ruled;

    callback opened(path: string);
    callback forgotten(path: string);

    alignment: start;

    if root.ruled: Rectangle {
        height: root.compact ? 40px : 56px;

        Rectangle {
            x: 0;
            y: parent.height / 2;
            width: parent.width;
            height: 1px;
            background: Theme.line;
        }
    }

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: I18n.t("Recent");
            color: Theme.fg-muted;
            font-size: Theme.fs-lg;
            font-weight: Theme.weight-title;
        }

        // How many, quietly: a count is the one thing a list of rows does
        // not say about itself until it is scrolled.
        Text {
            text: root.recents.length;
            color: Theme.fg-dim;
            font-family: Theme.font-technical;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
    }

    Rectangle { height: 12px; }

    for project in root.recents: RecentRow {
        project: project;
        enabled: root.enabled;
        compact: root.compact;
        opened => { root.opened(project.path); }
        forgotten => { root.forgotten(project.path); }
    }
}

// A pill, and the only filled accent in the form: it is the one thing on
// this screen that starts an edit. Its own width beside its note; the whole
// width on a phone.
component CreateButton inherits Rectangle {
    in property <bool> busy;
    in property <bool> enabled: true;
    in property <bool> block;

    callback clicked();

    // Its label's width plus the pill's ends beside the note; across the
    // width when the layout it sits in stretches it.
    min-width: label.preferred-width + 48px;
    preferred-width: label.preferred-width + 48px;
    horizontal-stretch: root.block ? 1 : 0;
    height: root.block ? 44px : 40px;
    border-radius: self.height / 2;
    background: go.has-hover && root.enabled ? Theme.accent-hover : Theme.accent;
    opacity: root.enabled ? 1.0 : 0.4;

    animate background { duration: 120ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.busy ? I18n.t("Creating…") : I18n.t("Create");
        color: Theme.on-accent;
        font-size: Theme.fs-xl;
        font-weight: Theme.weight-title;
    }

    go := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The line under or beside the button: what pressing it does to the disk.
component CreateNote inherits HorizontalLayout {
    spacing: 6px;

    VerticalLayout {
        alignment: start;
        padding-top: 2px;
        Icon {
            glyph: Glyph.info;
            size: 12px;
            tint: Theme.fg-dim;
        }
    }

    Text {
        horizontal-stretch: 1;
        text: I18n.t("The project folder is created now; the edit autosaves into it.");
        color: Theme.fg-dim;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component StartScreen inherits Rectangle {
    in property <StartData> data;
    /// The two ladders' labels. The numbers behind each index are Rust's, so
    /// there is one place that knows 4K is 3840 x 2160 and 29.97 is 30000
    /// over 1001 — see `RESOLUTIONS` and `START_RATES` in the window.
    in property <[string]> resolutions;
    in property <[string]> rates;
    in property <[RecentProjectData]> recents;

    callback name-edited(name: string);
    callback location-edited(path: string);
    callback browse();
    callback resolution-changed(index: int);
    callback rate-changed(index: int);
    callback create();
    callback open-recent(path: string);
    callback forget-recent(path: string);
    callback dismiss-error();

    // ── the three shapes ─────────────────────────────────────────────────
    //
    // Narrow is a phone held upright, or a window squeezed that far: under
    // this the label column and the value cannot share a row. Wide is the
    // recents beside the form, only once there is history to show and room
    // for both columns at their full widths.
    property <bool> narrow: root.width < 600px;
    /// The form's own column, and the widest the pair may run to.
    property <length> form-w: 700px;
    property <length> recents-w: 340px;
    property <length> column-gap: 64px;
    property <bool> side-by-side: root.recents.length > 0
        && root.width >= root.form-w + root.column-gap + root.recents-w + 96px;
    /// The margin the sheet keeps from the window's edge: a twelfth of the
    /// width, between the phone's 20px and the desktop's 48px.
    property <length> pad: Math.max(20px, Math.min(48px, root.width / 12));
    /// The top margin: room to breathe on a desktop, less on a phone where
    /// the height is the scarce thing.
    property <length> pad-top: root.narrow ? 24px : 48px;

    /// A project needs somewhere to go. Everything else has a default.
    property <bool> can-create: !root.data.busy && root.data.location != "";

    background: Theme.page;
    clip: true;

    // The whole screen scrolls when it does not fit: a wheel, a trackpad or
    // a finger, which a Flickable takes all of. It clamps its own travel.
    flick := Flickable {
        viewport-width: self.width;
        viewport-height: Math.max(self.height, sheet.height + root.pad-top + root.pad);
        interactive: sheet.height + root.pad-top + root.pad > self.height;

        sheet := Rectangle {
            // Centred when it fits and pinned to the top when it does not,
            // which is what `justify-center` in a scroll container gives.
            x: (flick.width - self.width) / 2;
            y: sheet.height + root.pad-top + root.pad > flick.height
                ? root.pad-top
                : Math.max(root.pad-top, (flick.height - self.height) / 2);
            width: Math.min(flick.width - 2 * root.pad,
                root.side-by-side
                    ? root.form-w + root.column-gap + root.recents-w
                    : root.form-w);
            height: columns.preferred-height;

            columns := HorizontalLayout {
                spacing: root.column-gap;

                // ── the form ─────────────────────────────────────────────
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;

                    Text {
                        text: I18n.t("New project");
                        color: Theme.fg;
                        // The one display-sized line in the app. The tree
                        // bundles two faces and no display face, so the
                        // interface face carries it at its heaviest weight and
                        // tight tracking — -0.03em, which at 34px is a point.
                        // A phone gets it at 26px, still the largest thing on
                        // its screen and no longer half of it.
                        font-size: root.narrow ? 26px : Theme.fs-display;
                        font-weight: Theme.weight-display;
                        letter-spacing: root.narrow ? -0.6px : -1px;
                        wrap: word-wrap;
                    }

                    Rectangle { height: 6px; }

                    Text {
                        text: I18n.t("These settings apply to the whole edit and cannot be changed later.");
                        color: Theme.fg-muted;
                        font-size: root.narrow ? Theme.fs-lg : Theme.fs-xl;
                        wrap: word-wrap;
                    }

                    Rectangle { height: root.narrow ? 24px : 40px; }

                    Field {
                        label: I18n.t("Name");
                        stacked: root.narrow;

                        PlainInput {
                            text: root.data.name;
                            placeholder: I18n.t("Untitled project");
                            autofocus: true;
                            enabled: !root.data.busy;
                            edited(text) => { root.name-edited(text); }
                            accepted => { root.create(); }
                        }
                    }

                    Field {
                        label: I18n.t("Location");
                        stacked: root.narrow;

                        HorizontalLayout {
                            spacing: 12px;

                            PlainInput {
                                horizontal-stretch: 1;
                                text: root.data.location;
                                placeholder: I18n.t("Choose a folder");
                                size: Theme.fs;
                                face: Theme.font-technical;
                                enabled: !root.data.busy;
                                edited(text) => { root.location-edited(text); }
                                accepted => { root.create(); }
                            }

                            VerticalLayout {
                                alignment: center;
                                LinkButton {
                                    label: I18n.t("Choose…");
                                    enabled: !root.data.busy;
                                    clicked => { root.browse(); }
                                }
                            }
                        }
                    }

                    Field {
                        label: I18n.t("Resolution");
                        stacked: root.narrow;

                        // The control takes the row up to its natural width
                        // and the whole row on a phone, where four labels
                        // need every pixel there is.
                        SegmentedControl {
                            width: Math.min(312px, parent.width);
                            options: root.resolutions;
                            current <=> root.res-index;
                            enabled: !root.data.busy;
                            changed(index) => { root.resolution-changed(index); }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            FrameShape {
                                aspect: root.data.frame-aspect;
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.data.size-readout;
                                    color: Theme.fg-dim;
                                    font-family: Theme.font-technical;
                                    font-size: Theme.fs-sm;
                                }
                            }
                        }
                    }

                    Field {
                        label: I18n.t("Frame rate");
                        last: true;
                        stacked: root.narrow;

                        SegmentedControl {
                            width: Math.min(300px, parent.width);
                            options: root.rates;
                            current <=> root.rate-index;
                            enabled: !root.data.busy;
                            changed(index) => { root.rate-changed(index); }
                        }

                        Text {
                            text: root.data.rate-readout;
                            color: Theme.fg-dim;
                            font-family: Theme.font-technical;
                            font-size: Theme.fs-sm;
                        }
                    }

                    // The notice, above the button, wrapping to as many
                    // lines as the error takes: an elided error is half an
                    // error, and on a phone that is most of it.
                    if root.data.error != "": Rectangle {
                        height: notice.preferred-height + 12px;

                        notice := Rectangle {
                            x: 0;
                            y: 12px;
                            width: parent.width;
                            height: self.preferred-height;
                            border-radius: Theme.r;
                            background: Theme.danger-soft;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 6px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 8px;

                                VerticalLayout {
                                    alignment: start;
                                    padding-top: 2px;
                                    Icon {
                                        glyph: Glyph.info;
                                        size: 13px;
                                        tint: Theme.danger;
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.data.error;
                                    color: Theme.danger;
                                    font-size: Theme.fs;
                                    wrap: word-wrap;
                                }

                                VerticalLayout {
                                    alignment: start;
                                    CopyChip {
                                        text: root.data.error;
                                    }
                                }

                                VerticalLayout {
                                    alignment: start;
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: Theme.r-xs;

                                        Icon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            glyph: Glyph.close;
                                            size: 11px;
                                            tint: Theme.danger;
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.dismiss-error(); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: root.narrow ? 28px : 40px; }

                    // ── the recents, under the form ──────────────────────
                    //
                    // Placed here rather than reflowed: a Slint layout has no
                    // wrap, so the two arrangements are two shapes and each is
                    // only built at the width the other cannot fit. On a phone
                    // they come after the button, which is the thing the
                    // screen is for and should not need a scroll to reach.
                    if !root.side-by-side && !root.narrow && root.recents.length > 0: RecentsColumn {
                        recents: root.recents;
                        enabled: !root.data.busy;
                        ruled: true;
                        opened(path) => { root.open-recent(path); }
                        forgotten(path) => { root.forget-recent(path); }
                    }

                    // The button and its note: side by side where there is
                    // room, the button across the width and the note under
                    // it on a phone, where a pill a thumb can miss is a pill
                    // that will be missed.
                    if !root.narrow: HorizontalLayout {
                        alignment: start;
                        spacing: 16px;

                        CreateButton {
                            busy: root.data.busy;
                            enabled: root.can-create;
                            clicked => { root.create(); }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            CreateNote { }
                        }
                    }

                    if root.narrow: VerticalLayout {
                        spacing: 12px;

                        CreateButton {
                            block: true;
                            busy: root.data.busy;
                            enabled: root.can-create;
                            clicked => { root.create(); }
                        }

                        CreateNote { }
                    }

                    if root.narrow && root.recents.length > 0: RecentsColumn {
                        recents: root.recents;
                        enabled: !root.data.busy;
                        ruled: true;
                        compact: true;
                        opened(path) => { root.open-recent(path); }
                        forgotten(path) => { root.forget-recent(path); }
                    }
                }

                // ── the recents, beside the form ─────────────────────────
                if root.side-by-side: RecentsColumn {
                    width: root.recents-w;
                    recents: root.recents;
                    enabled: !root.data.busy;
                    opened(path) => { root.open-recent(path); }
                    forgotten(path) => { root.forget-recent(path); }
                }
            }
        }
    }

    // The segmented controls own their `current`: they write to it, and a
    // write replaces whatever binding was declared. Seeded from the published
    // form instead, the way the inspector's tab strip is.
    property <int> res-index;
    property <int> rate-index;
    function seed() {
        root.res-index = root.data.resolution;
        root.rate-index = root.data.rate;
    }
    init => { root.seed(); }
    changed data => { root.seed(); }

    if flick.interactive: ThinScrollbar {
        x: parent.width - self.width - 2px;
        y: 0;
        height: root.height;
        viewport: root.height;
        content: flick.viewport-height;
        offset: -flick.viewport-y;
        scrolled(to) => { flick.viewport-y = -to; }
    }
}
