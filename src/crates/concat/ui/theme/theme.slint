// The theme: the two palettes, and the one property that chooses between them.
//
// Everything the interface is made of — every colour, every radius, every
// metric, every step of the type scale — is read from `Theme`, and nowhere
// else. Nothing outside this directory names a colour. Which colour `Theme`
// hands back depends on `dark`, and that is the whole of the switch.
//
// The split across the three files is by what a theme gets to decide:
//
//   - `dark.slint` and `light.slint` are the palettes. Colours only, the same
//     token names in the same order, and each one complete — no palette
//     borrows a value from the other. Their headers say what the values mean
//     and which relationships between them are load-bearing; read the dark
//     one first, it is where those rules are written down.
//   - This file holds the switch, and everything a palette does *not* get to
//     decide: the type, the shape, and the content colours. A second theme is
//     a retone, not a redraw — the panels are the same size and the corners
//     are the same radius under both — and the colours a *title* can be belong
//     to the document, which is exported the same way whichever theme the
//     window happened to be wearing.
//
// To add a third theme: write the palette next door, import it here, and give
// `dark` more than two answers to be. To fork the look wholesale: change the
// values in a palette. Neither one touches a file outside this directory.
//
// Two things are deliberately *not* here:
//
//   - The effect previews in ui/assets, which are photographs of what an
//     effect does rather than anything a theme decides.
//   - Sizes under about 5px — a 2px scrollbar thumb, a 1px splitter pill.
//     Those are shape at a scale nobody themes, and stay where they are drawn.
import { Dark } from "dark.slint";
import { Light } from "light.slint";
import { Violet } from "violet.slint";
import { Lime } from "lime.slint";
import { Rose } from "rose.slint";
import { Ocean } from "ocean.slint";

export global Theme {
    /// Which palette every colour below is read from. Settings > Appearance
    /// picks it (main.rs, `on_settings_theme_changed`), and every binding in
    /// the tree is a property read away from it, so the window retones in a
    /// frame without anything being rebuilt.
    in-out property <int> variant: 0;

    // ── type ─────────────────────────────────────────────────────────────
    //
    // Two roles, not one, even while one face plays both.
    //
    // `font` carries the interface: every label, title and sentence. `font-
    // technical` is for timecode, the ruler, clip labels, paths, dimensions,
    // counts — anything you read as a *value* rather than as language.
    //
    // Both are Hanken Grotesk, the one face this build bundles (app.slint).
    // The split between the roles stays so that the two can differ again
    // without touching a single element.
    out property <string> font: "Hanken Grotesk";
    out property <string> font-technical: "Hanken Grotesk";
    /// The scale. `fs` is the body size everything inherits; the two either
    /// side of it are the dense readout and the panel title. `xl` is for the
    /// few lines that are content rather than chrome — a project's name in a
    /// list — and `display` is the launch screen's heading and nothing else.
    out property <length> fs-xs: 10px;
    out property <length> fs-sm: 11px;
    out property <length> fs: 12px;
    out property <length> fs-lg: 13px;
    out property <length> fs-xl: 14px;
    out property <length> fs-input: 15px;
    out property <length> fs-display: 34px;

    // The weights the design actually calls for, uncompensated.
    //
    // Skia composites glyph coverage with gamma correction, so text comes out
    // at the weight the tokens name. FemtoVG does not correct for it and thins
    // small light-on-dark text, which a step up to 500/600 compensates for.
    // Use those if you build --features wgpu; leave them alone otherwise, or
    // the text is over-corrected and reads as too heavy.
    //
    // Weight is the one axis that can absorb a renderer difference without
    // touching a colour token, and every face is bundled, so it costs nothing
    // at runtime. Reach for it rather than nudging a surface to compensate.
    out property <int> weight-body: 400;    // 500 under --features wgpu
    out property <int> weight-title: 500;   // 600 under --features wgpu
    /// The launch screen's heading, and the wordmark in the title bar. The one
    /// weight above `title`, and the only place the type gets to be loud. Bold
    /// is bundled, so this names it exactly.
    out property <int> weight-display: 700;

    // ── shape ────────────────────────────────────────────────────────────
    //
    // radii
    out property <length> r-xs: 3px;
    out property <length> r-sm: 5px;
    out property <length> r: 7px;
    out property <length> r-lg: 12px;
    /// The dialog sheet, and nothing smaller. A modal is the largest rounded
    /// thing in the window and wants a corner to match.
    out property <length> r-xl: 16px;

    // metrics
    out property <length> h: 28px;        // standard control height
    out property <length> gap: 6px;
    out property <length> pad: 14px;      // panel horizontal padding
    out property <length> label-w: 62px;

    // ── surfaces ─────────────────────────────────────────────────────────
    out property <color> panel: variant == 1 ? Light.panel
        : variant == 2 ? Violet.panel
        : variant == 3 ? Lime.panel
        : variant == 4 ? Rose.panel
        : variant == 5 ? Ocean.panel
        : Dark.panel;
    out property <color> raised: variant == 1 ? Light.raised
        : variant == 2 ? Violet.raised
        : variant == 3 ? Lime.raised
        : variant == 4 ? Rose.raised
        : variant == 5 ? Ocean.raised
        : Dark.raised;
    out property <color> well: variant == 1 ? Light.well
        : variant == 2 ? Violet.well
        : variant == 3 ? Lime.well
        : variant == 4 ? Rose.well
        : variant == 5 ? Ocean.well
        : Dark.well;
    out property <color> field: variant == 1 ? Light.field
        : variant == 2 ? Violet.field
        : variant == 3 ? Lime.field
        : variant == 4 ? Rose.field
        : variant == 5 ? Ocean.field
        : Dark.field;
    out property <color> field-hover: variant == 1 ? Light.field-hover
        : variant == 2 ? Violet.field-hover
        : variant == 3 ? Lime.field-hover
        : variant == 4 ? Rose.field-hover
        : variant == 5 ? Ocean.field-hover
        : Dark.field-hover;
    out property <color> field-active: variant == 1 ? Light.field-active
        : variant == 2 ? Violet.field-active
        : variant == 3 ? Lime.field-active
        : variant == 4 ? Rose.field-active
        : variant == 5 ? Ocean.field-active
        : Dark.field-active;

    // hairlines
    out property <color> line: variant == 1 ? Light.line
        : variant == 2 ? Violet.line
        : variant == 3 ? Lime.line
        : variant == 4 ? Rose.line
        : variant == 5 ? Ocean.line
        : Dark.line;
    out property <color> line-strong: variant == 1 ? Light.line-strong
        : variant == 2 ? Violet.line-strong
        : variant == 3 ? Lime.line-strong
        : variant == 4 ? Rose.line-strong
        : variant == 5 ? Ocean.line-strong
        : Dark.line-strong;

    // text
    out property <color> fg: variant == 1 ? Light.fg
        : variant == 2 ? Violet.fg
        : variant == 3 ? Lime.fg
        : variant == 4 ? Rose.fg
        : variant == 5 ? Ocean.fg
        : Dark.fg;
    out property <color> fg-muted: variant == 1 ? Light.fg-muted
        : variant == 2 ? Violet.fg-muted
        : variant == 3 ? Lime.fg-muted
        : variant == 4 ? Rose.fg-muted
        : variant == 5 ? Ocean.fg-muted
        : Dark.fg-muted;
    out property <color> fg-dim: variant == 1 ? Light.fg-dim
        : variant == 2 ? Violet.fg-dim
        : variant == 3 ? Lime.fg-dim
        : variant == 4 ? Rose.fg-dim
        : variant == 5 ? Ocean.fg-dim
        : Dark.fg-dim;

    // accents
    out property <color> accent: variant == 1 ? Light.accent
        : variant == 2 ? Violet.accent
        : variant == 3 ? Lime.accent
        : variant == 4 ? Rose.accent
        : variant == 5 ? Ocean.accent
        : Dark.accent;
    out property <color> accent-hover: variant == 1 ? Light.accent-hover
        : variant == 2 ? Violet.accent-hover
        : variant == 3 ? Lime.accent-hover
        : variant == 4 ? Rose.accent-hover
        : variant == 5 ? Ocean.accent-hover
        : Dark.accent-hover;
    out property <color> accent-soft: variant == 1 ? Light.accent-soft
        : variant == 2 ? Violet.accent-soft
        : variant == 3 ? Lime.accent-soft
        : variant == 4 ? Rose.accent-soft
        : variant == 5 ? Ocean.accent-soft
        : Dark.accent-soft;
    out property <color> green: variant == 1 ? Light.green
        : variant == 2 ? Violet.green
        : variant == 3 ? Lime.green
        : variant == 4 ? Rose.green
        : variant == 5 ? Ocean.green
        : Dark.green;
    out property <color> on-accent: variant == 1 ? Light.on-accent
        : variant == 2 ? Violet.on-accent
        : variant == 3 ? Lime.on-accent
        : variant == 4 ? Rose.on-accent
        : variant == 5 ? Ocean.on-accent
        : Dark.on-accent;
    out property <color> on-green: variant == 1 ? Light.on-green
        : variant == 2 ? Violet.on-green
        : variant == 3 ? Lime.on-green
        : variant == 4 ? Rose.on-green
        : variant == 5 ? Ocean.on-green
        : Dark.on-green;

    // the Rail's dragger
    out property <color> grip: variant == 1 ? Light.grip
        : variant == 2 ? Violet.grip
        : variant == 3 ? Lime.grip
        : variant == 4 ? Rose.grip
        : variant == 5 ? Ocean.grip
        : Dark.grip;
    out property <color> grip-active: variant == 1 ? Light.grip-active
        : variant == 2 ? Violet.grip-active
        : variant == 3 ? Lime.grip-active
        : variant == 4 ? Rose.grip-active
        : variant == 5 ? Ocean.grip-active
        : Dark.grip-active;
    out property <color> grip-edge: variant == 1 ? Light.grip-edge
        : variant == 2 ? Violet.grip-edge
        : variant == 3 ? Lime.grip-edge
        : variant == 4 ? Rose.grip-edge
        : variant == 5 ? Ocean.grip-edge
        : Dark.grip-edge;

    // meter ramp
    out property <color> meter-low: variant == 1 ? Light.meter-low
        : variant == 2 ? Violet.meter-low
        : variant == 3 ? Lime.meter-low
        : variant == 4 ? Rose.meter-low
        : variant == 5 ? Ocean.meter-low
        : Dark.meter-low;
    out property <color> meter-mid: variant == 1 ? Light.meter-mid
        : variant == 2 ? Violet.meter-mid
        : variant == 3 ? Lime.meter-mid
        : variant == 4 ? Rose.meter-mid
        : variant == 5 ? Ocean.meter-mid
        : Dark.meter-mid;
    out property <color> meter-high: variant == 1 ? Light.meter-high
        : variant == 2 ? Violet.meter-high
        : variant == 3 ? Lime.meter-high
        : variant == 4 ? Rose.meter-high
        : variant == 5 ? Ocean.meter-high
        : Dark.meter-high;

    // media kinds
    out property <color> kind-video: variant == 1 ? Light.kind-video
        : variant == 2 ? Violet.kind-video
        : variant == 3 ? Lime.kind-video
        : variant == 4 ? Rose.kind-video
        : variant == 5 ? Ocean.kind-video
        : Dark.kind-video;
    out property <color> kind-video-well: variant == 1 ? Light.kind-video-well
        : variant == 2 ? Violet.kind-video-well
        : variant == 3 ? Lime.kind-video-well
        : variant == 4 ? Rose.kind-video-well
        : variant == 5 ? Ocean.kind-video-well
        : Dark.kind-video-well;
    out property <color> kind-audio: variant == 1 ? Light.kind-audio
        : variant == 2 ? Violet.kind-audio
        : variant == 3 ? Lime.kind-audio
        : variant == 4 ? Rose.kind-audio
        : variant == 5 ? Ocean.kind-audio
        : Dark.kind-audio;
    out property <color> kind-audio-well: variant == 1 ? Light.kind-audio-well
        : variant == 2 ? Violet.kind-audio-well
        : variant == 3 ? Lime.kind-audio-well
        : variant == 4 ? Rose.kind-audio-well
        : variant == 5 ? Ocean.kind-audio-well
        : Dark.kind-audio-well;
    out property <color> kind-image: variant == 1 ? Light.kind-image
        : variant == 2 ? Violet.kind-image
        : variant == 3 ? Lime.kind-image
        : variant == 4 ? Rose.kind-image
        : variant == 5 ? Ocean.kind-image
        : Dark.kind-image;
    out property <color> kind-image-well: variant == 1 ? Light.kind-image-well
        : variant == 2 ? Violet.kind-image-well
        : variant == 3 ? Lime.kind-image-well
        : variant == 4 ? Rose.kind-image-well
        : variant == 5 ? Ocean.kind-image-well
        : Dark.kind-image-well;
    out property <color> kind-text: variant == 1 ? Light.kind-text
        : variant == 2 ? Violet.kind-text
        : variant == 3 ? Lime.kind-text
        : variant == 4 ? Rose.kind-text
        : variant == 5 ? Ocean.kind-text
        : Dark.kind-text;
    out property <color> kind-text-well: variant == 1 ? Light.kind-text-well
        : variant == 2 ? Violet.kind-text-well
        : variant == 3 ? Lime.kind-text-well
        : variant == 4 ? Rose.kind-text-well
        : variant == 5 ? Ocean.kind-text-well
        : Dark.kind-text-well;
    out property <color> kind-filter: variant == 1 ? Light.kind-filter
        : variant == 2 ? Violet.kind-filter
        : variant == 3 ? Lime.kind-filter
        : variant == 4 ? Rose.kind-filter
        : variant == 5 ? Ocean.kind-filter
        : Dark.kind-filter;
    out property <color> kind-filter-well: variant == 1 ? Light.kind-filter-well
        : variant == 2 ? Violet.kind-filter-well
        : variant == 3 ? Lime.kind-filter-well
        : variant == 4 ? Rose.kind-filter-well
        : variant == 5 ? Ocean.kind-filter-well
        : Dark.kind-filter-well;

    // timeline
    out property <color> lane: variant == 1 ? Light.lane
        : variant == 2 ? Violet.lane
        : variant == 3 ? Lime.lane
        : variant == 4 ? Rose.lane
        : variant == 5 ? Ocean.lane
        : Dark.lane;
    out property <color> lane-alt: variant == 1 ? Light.lane-alt
        : variant == 2 ? Violet.lane-alt
        : variant == 3 ? Lime.lane-alt
        : variant == 4 ? Rose.lane-alt
        : variant == 5 ? Ocean.lane-alt
        : Dark.lane-alt;
    out property <color> ruler: variant == 1 ? Light.ruler
        : variant == 2 ? Violet.ruler
        : variant == 3 ? Lime.ruler
        : variant == 4 ? Rose.ruler
        : variant == 5 ? Ocean.ruler
        : Dark.ruler;
    out property <color> grid: variant == 1 ? Light.grid
        : variant == 2 ? Violet.grid
        : variant == 3 ? Lime.grid
        : variant == 4 ? Rose.grid
        : variant == 5 ? Ocean.grid
        : Dark.grid;
    out property <color> playhead: variant == 1 ? Light.playhead
        : variant == 2 ? Violet.playhead
        : variant == 3 ? Lime.playhead
        : variant == 4 ? Rose.playhead
        : variant == 5 ? Ocean.playhead
        : Dark.playhead;
    out property <color> wave: variant == 1 ? Light.wave
        : variant == 2 ? Violet.wave
        : variant == 3 ? Lime.wave
        : variant == 4 ? Rose.wave
        : variant == 5 ? Ocean.wave
        : Dark.wave;
    out property <color> wave-video: variant == 1 ? Light.wave-video
        : variant == 2 ? Violet.wave-video
        : variant == 3 ? Lime.wave-video
        : variant == 4 ? Rose.wave-video
        : variant == 5 ? Ocean.wave-video
        : Dark.wave-video;
    out property <color> wave-hot: variant == 1 ? Light.wave-hot
        : variant == 2 ? Violet.wave-hot
        : variant == 3 ? Lime.wave-hot
        : variant == 4 ? Rose.wave-hot
        : variant == 5 ? Ocean.wave-hot
        : Dark.wave-hot;
    /// Where a waveform's bar goes hot: the peak level, as a fraction of
    /// full scale, above which the part of the bar over it is drawn in
    /// `wave-hot`. -6 dBFS: a mix that keeps its peaks under it has
    /// headroom, one that crosses it often is on its way to clipping.
    out property <float> wave-hot-line: 0.5012;

    // clip ink
    out property <color> clip-ink: variant == 1 ? Light.clip-ink
        : variant == 2 ? Violet.clip-ink
        : variant == 3 ? Lime.clip-ink
        : variant == 4 ? Rose.clip-ink
        : variant == 5 ? Ocean.clip-ink
        : Dark.clip-ink;
    out property <color> clip-body: variant == 1 ? Light.clip-body
        : variant == 2 ? Violet.clip-body
        : variant == 3 ? Lime.clip-body
        : variant == 4 ? Rose.clip-body
        : variant == 5 ? Ocean.clip-body
        : Dark.clip-body;
    out property <color> clip-chip: variant == 1 ? Light.clip-chip
        : variant == 2 ? Violet.clip-chip
        : variant == 3 ? Lime.clip-chip
        : variant == 4 ? Rose.clip-chip
        : variant == 5 ? Ocean.clip-chip
        : Dark.clip-chip;
    out property <color> wave-centre: variant == 1 ? Light.wave-centre
        : variant == 2 ? Violet.wave-centre
        : variant == 3 ? Lime.wave-centre
        : variant == 4 ? Rose.wave-centre
        : variant == 5 ? Ocean.wave-centre
        : Dark.wave-centre;
    out property <color> fade-shade: variant == 1 ? Light.fade-shade
        : variant == 2 ? Violet.fade-shade
        : variant == 3 ? Lime.fade-shade
        : variant == 4 ? Rose.fade-shade
        : variant == 5 ? Ocean.fade-shade
        : Dark.fade-shade;
    out property <color> fade-edge: variant == 1 ? Light.fade-edge
        : variant == 2 ? Violet.fade-edge
        : variant == 3 ? Lime.fade-edge
        : variant == 4 ? Rose.fade-edge
        : variant == 5 ? Ocean.fade-edge
        : Dark.fade-edge;
    out property <color> transition-in: variant == 1 ? Light.transition-in
        : variant == 2 ? Violet.transition-in
        : variant == 3 ? Lime.transition-in
        : variant == 4 ? Rose.transition-in
        : variant == 5 ? Ocean.transition-in
        : Dark.transition-in;
    out property <color> transition-out: variant == 1 ? Light.transition-out
        : variant == 2 ? Violet.transition-out
        : variant == 3 ? Lime.transition-out
        : variant == 4 ? Rose.transition-out
        : variant == 5 ? Ocean.transition-out
        : Dark.transition-out;

    // the monitor
    out property <color> stage: variant == 1 ? Light.stage
        : variant == 2 ? Violet.stage
        : variant == 3 ? Lime.stage
        : variant == 4 ? Rose.stage
        : variant == 5 ? Ocean.stage
        : Dark.stage;
    out property <color> sample-ground: variant == 1 ? Light.sample-ground
        : variant == 2 ? Violet.sample-ground
        : variant == 3 ? Lime.sample-ground
        : variant == 4 ? Rose.sample-ground
        : variant == 5 ? Ocean.sample-ground
        : Dark.sample-ground;
    out property <color> on-stage-dim: variant == 1 ? Light.on-stage-dim
        : variant == 2 ? Violet.on-stage-dim
        : variant == 3 ? Lime.on-stage-dim
        : variant == 4 ? Rose.on-stage-dim
        : variant == 5 ? Ocean.on-stage-dim
        : Dark.on-stage-dim;

    // sheets over things that are not panels
    out property <color> overlay: variant == 1 ? Light.overlay
        : variant == 2 ? Violet.overlay
        : variant == 3 ? Lime.overlay
        : variant == 4 ? Rose.overlay
        : variant == 5 ? Ocean.overlay
        : Dark.overlay;
    out property <color> scrim: variant == 1 ? Light.scrim
        : variant == 2 ? Violet.scrim
        : variant == 3 ? Lime.scrim
        : variant == 4 ? Rose.scrim
        : variant == 5 ? Ocean.scrim
        : Dark.scrim;
    out property <color> on-scrim: variant == 1 ? Light.on-scrim
        : variant == 2 ? Violet.on-scrim
        : variant == 3 ? Lime.on-scrim
        : variant == 4 ? Rose.on-scrim
        : variant == 5 ? Ocean.on-scrim
        : Dark.on-scrim;

    // destructive
    out property <color> danger: variant == 1 ? Light.danger
        : variant == 2 ? Violet.danger
        : variant == 3 ? Lime.danger
        : variant == 4 ? Rose.danger
        : variant == 5 ? Ocean.danger
        : Dark.danger;
    out property <color> danger-soft: variant == 1 ? Light.danger-soft
        : variant == 2 ? Violet.danger-soft
        : variant == 3 ? Lime.danger-soft
        : variant == 4 ? Rose.danger-soft
        : variant == 5 ? Ocean.danger-soft
        : Dark.danger-soft;
    out property <color> danger-wash: variant == 1 ? Light.danger-wash
        : variant == 2 ? Violet.danger-wash
        : variant == 3 ? Lime.danger-wash
        : variant == 4 ? Rose.danger-wash
        : variant == 5 ? Ocean.danger-wash
        : Dark.danger-wash;
    out property <color> danger-edge: variant == 1 ? Light.danger-edge
        : variant == 2 ? Violet.danger-edge
        : variant == 3 ? Lime.danger-edge
        : variant == 4 ? Rose.danger-edge
        : variant == 5 ? Ocean.danger-edge
        : Dark.danger-edge;

    // the window ground the panes float on
    out property <color> page: variant == 1 ? Light.page
        : variant == 2 ? Violet.page
        : variant == 3 ? Lime.page
        : variant == 4 ? Rose.page
        : variant == 5 ? Ocean.page
        : Dark.page;
    out property <color> page-fg-muted: variant == 1 ? Light.page-fg-muted
        : variant == 2 ? Violet.page-fg-muted
        : variant == 3 ? Lime.page-fg-muted
        : variant == 4 ? Rose.page-fg-muted
        : variant == 5 ? Ocean.page-fg-muted
        : Dark.page-fg-muted;

    // ── content ──────────────────────────────────────────────────────────
    //
    // Colours the *edit* can be made of, as opposed to the interface — and the
    // one group here that does not follow the switch. A title's colour is
    // baked into the export; the video does not have a theme, and a shelf that
    // offered different colours depending on which way the toggle was pointing
    // would be offering to change the cut by changing the lighting in the room.
    //
    // They live here rather than beside the control that offers them because
    // there is exactly one shelf and it belongs to the whole application. The
    // list is the neutrals first, then the interface's own status hues, then
    // the clip palette's marks — both palettes' accents are in it, so the row
    // agrees with the window whichever way it is set.
    out property <[color]> swatches: [
        #ffffff, #f5f5f7, #a1a1a6, #6e6e73, #15220a, #000000,
        #cbf53f, #4d7c0f, #30d158, #ffd60a, #f09e2f, #ff453a,
        #e8355e, #8b5cf6, #4d8df6, #142640,
    ];
    /// What a title's plate is set to when the switch is turned on. A colour
    /// and not a flag: turning it off is clearing it, and this is what "on"
    /// means the first time.
    out property <color> plate-on: #000000cc;
}