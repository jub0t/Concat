export global Rose {
    // surfaces
    out property <color> panel: #2d2125;
    out property <color> raised: #382a30;
    out property <color> well: #25191e;
    out property <color> field: #403037;
    out property <color> field-hover: #4a383f;
    out property <color> field-active: #56424a;

    // hairlines
    out property <color> line: #ffffff1a;
    out property <color> line-strong: #ffffff33;

    // text
    out property <color> fg: #f5f5f7;
    out property <color> fg-muted: #a1a1a6;
    out property <color> fg-dim: #6e6e73;

    // accents
    out property <color> accent: #e11d48;
    out property <color> accent-hover: #f43f5e;
    out property <color> accent-soft: #e11d4833;
    out property <color> green: #30d158;
    out property <color> on-accent: #ffffff;
    out property <color> on-green: #06210f;

    // the Rail's dragger
    out property <color> grip: #dcdce4;
    out property <color> grip-active: #ffffff;
    out property <color> grip-edge: #0000008c;

    // meter ramp
    out property <color> meter-low: #34c759;
    out property <color> meter-mid: #ffd60a;
    out property <color> meter-high: #ff453a;

    // media kinds
    out property <color> kind-video: #3373d1;
    out property <color> kind-video-well: #142238;
    out property <color> kind-audio: #34c46f;
    out property <color> kind-audio-well: #12301c;
    out property <color> kind-image: #9f63d6;
    out property <color> kind-image-well: #2a1e34;
    out property <color> kind-text: #cf5a99;
    out property <color> kind-text-well: #321c29;
    out property <color> kind-filter: #6d63e8;
    out property <color> kind-filter-well: #23204a;

    // timeline
    out property <color> lane: #241a1e;
    out property <color> lane-alt: #281e22;
    out property <color> ruler: #21171b;
    out property <color> grid: #ffffff24;
    out property <color> playhead: #ff453a;
    out property <color> wave: #a7f0c2b3;
    out property <color> wave-video: #a9c8f5b3;
    out property <color> wave-hot: #ffb340d9;

    // clip ink
    out property <color> clip-ink: #ffffff;
    out property <color> clip-body: #ffe4b2b8;
    out property <color> clip-chip: #00000059;
    out property <color> wave-centre: #ffffff2e;
    out property <color> fade-shade: #00000073;
    out property <color> fade-edge: #ffffffa6;
    out property <color> transition-in: #ffffffcc;
    out property <color> transition-out: #ffffff73;

    // the monitor
    out property <color> stage: #000000;
    out property <color> on-stage-dim: #ffffff6b;
    out property <color> sample-ground: #41353b;

    // sheets
    out property <color> overlay: #00000099;
    out property <color> scrim: #0000008c;
    out property <color> on-scrim: #ffffff;

    // destructive
    out property <color> danger: #ff453a;
    out property <color> danger-soft: #ff453a24;
    out property <color> danger-wash: #2a1614;
    out property <color> danger-edge: #5a2b28;

    // window ground
    out property <color> page: #21151a;
    out property <color> page-fg-muted: #a1a1a6;
}