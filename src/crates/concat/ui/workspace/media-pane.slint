        if (id == "concat.noir") { return @image-url("../assets/effect-previews/noir.jpg"); }
        if (id == "concat.retro-70s") { return @image-url("../assets/effect-previews/retro-70s.jpg"); }
        if (id == "concat.rosy") { return @image-url("../assets/effect-previews/rosy.jpg"); }
        if (id == "concat.sci-fi") { return @image-url("../assets/effect-previews/sci-fi.jpg"); }
        if (id == "concat.silver") { return @image-url("../assets/effect-previews/silver.jpg"); }
        if (id == "concat.super-8") { return @image-url("../assets/effect-previews/super-8.jpg"); }
