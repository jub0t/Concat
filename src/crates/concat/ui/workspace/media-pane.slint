        if (id == "concat.mask-linear") { return @image-url("../assets/effect-previews/mask-linear.jpg"); }
        if (id == "concat.mask-rectangle") { return @image-url("../assets/effect-previews/mask-rectangle.jpg"); }
        if (id == "concat.neon-edges") { return @image-url("../assets/effect-previews/neon-edges.jpg"); }
        if (id == "concat.oil-paint") { return @image-url("../assets/effect-previews/oil-paint.jpg"); }
        if (id == "concat.rgb-split") { return @image-url("../assets/effect-previews/rgb-split.jpg"); }
        if (id == "concat.ripple") { return @image-url("../assets/effect-previews/ripple.jpg"); }
        if (id == "concat.snow") { return @image-url("../assets/effect-previews/snow.jpg"); }
        if (id == "concat.twirl") { return @image-url("../assets/effect-previews/twirl.jpg"); }
        // New filters
        if (id == "concat.adjust") { return @image-url("../assets/effect-previews/adjust.jpg"); }
        if (id == "concat.autumn") { return @image-url("../assets/effect-previews/autumn.jpg"); }
