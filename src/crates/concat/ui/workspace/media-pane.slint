        if (id == "concat.zoom-transition") { return @image-url("../assets/effect-previews/zoom-transition.jpg"); }
        // Modern Video Effects
        if (id == "concat.camera-shake") { return @image-url("../assets/effect-previews/camera-shake.jpg"); }
        if (id == "concat.rgb-glitch") { return @image-url("../assets/effect-previews/rgb-glitch.jpg"); }
        if (id == "concat.sparkle") { return @image-url("../assets/effect-previews/sparkle.jpg"); }
        if (id == "concat.tilt-shift") { return @image-url("../assets/effect-previews/tilt-shift.jpg"); }
        if (id == "concat.strobe-flash") { return @image-url("../assets/effect-previews/strobe-flash.jpg"); }
        if (id == "concat.crt-scanlines") { return @image-url("../assets/effect-previews/crt-scanlines.jpg"); }
        if (id == "concat.film-reel") { return @image-url("../assets/effect-previews/film-reel.jpg"); }
        if (id == "concat.camcorder-90s") { return @image-url("../assets/effect-previews/camcorder-90s.jpg"); }
        if (id == "concat.halation") { return @image-url("../assets/effect-previews/halation.jpg"); }
        if (id == "concat.wave-warp") { return @image-url("../assets/effect-previews/wave-warp.jpg"); }
        if (id == "concat.vortex-swirl") { return @image-url("../assets/effect-previews/vortex-swirl.jpg"); }
        if (id == "concat.prism-dispersion") { return @image-url("../assets/effect-previews/prism-dispersion.jpg"); }
        if (id == "concat.mirror-tile") { return @image-url("../assets/effect-previews/mirror-tile.jpg"); }
        if (id == "concat.bass-shockwave") { return @image-url("../assets/effect-previews/bass-shockwave.jpg"); }
        if (id == "concat.laser-beams") { return @image-url("../assets/effect-previews/laser-beams.jpg"); }
        if (id == "concat.neon-glow") { return @image-url("../assets/effect-previews/neon-glow.jpg"); }
        if (id == "concat.color-cycle") { return @image-url("../assets/effect-previews/color-cycle.jpg"); }
        // Modern Transitions
        if (id == "concat.whip-pan") { return @image-url("../assets/effect-previews/whip-pan.jpg"); }
        if (id == "concat.zoom-blur-transition") { return @image-url("../assets/effect-previews/zoom-blur-transition.jpg"); }
        if (id == "concat.light-leak-flash") { return @image-url("../assets/effect-previews/light-leak-flash.jpg"); }
        if (id == "concat.glitch-warp") { return @image-url("../assets/effect-previews/glitch-warp.jpg"); }
        return root.no-art;
    }
    /// The category column. In-out, because it is dragged.
    in-out property <length> sidebar-w: 104px;
    /// Narrow enough to be a real squeeze, wide enough that a category name
    /// still says which category.
    in property <length> min-sidebar: 76px;
    /// Where the column was when the divider went down. A drag is one pointer,
    /// so one slot is enough.
    property <length> press-sidebar;

    /// The sidebar as it is actually drawn — see `headers-w` in the timeline
    /// pane, which has the same problem for the same reason. A library
    /// dropped into a narrow seat would otherwise hand the card grid a
    /// negative width.
    property <length> sidebar: Math.max(0px,
        Math.min(root.sidebar-w, root.width / 2));

    // The catalogues. The ids are written into project files, so they are
    // stable forever - pick them like you mean them. The effect artwork is a
    // rendered preview, each effect's real FFmpeg chain run over one source
    // still. Transitions used to be two hand-written lists here; they are
    // now packages like any other effect, browsed the same way through
    // `catalogue-transitions`/`transition-groups` below.

    function narrow(to: MediaFilter) {
        root.filter = to;
        root.filter-changed(to);
    }

    Pane {
        // The page strip. Its bottom edge is the pane's full-width divider,
        // which is why the hairline is a child of this row and not a border on
        // the pill below it.
        Rectangle {
            height: 52px;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                // 4px above and below, not the 8px at the sides: the chips
                // carry a mark over their label and their own air around
                // both, and those need the room within the 52px the strip
                // shares with the other panes' headers.
                padding-top: 4px;
                padding-bottom: 4px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;

                // A sunken track and nothing else. No border: this sits
                // inside a pane that is already outlined, and a second rule
                // 8px in from the first reads as a box in a box. That is what
                // separates it from `SegmentedControl`, where the border is
                // doing real work because that control sits loose in a form
                // row with nothing else to bound it.
                Rectangle {
                    background: Theme.well;
                    border-radius: Theme.r;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        LibraryTab {
                            glyph: Glyph.film;
                            label: I18n.t("Media");
                            current: root.tab == 0;
                            clicked => { root.tab = 0; }
                        }
                        LibraryTab {
                            glyph: Glyph.text-mark;
                            label: I18n.t("Text");
                            current: root.tab == 1;
                            clicked => { root.tab = 1; }
                        }
                        LibraryTab {
                            glyph: Glyph.transition;
                            label: I18n.t("Transitions");
                            current: root.tab == 2;
                            clicked => { root.tab = 2; }
                        }
                        LibraryTab {
                            glyph: Glyph.sparkle;
                            label: I18n.t("Effects");
                            current: root.tab == 3;
                            clicked => { root.tab = 3; }
                        }
                        LibraryTab {
                            glyph: Glyph.filter;
                            label: I18n.t("Filters");
                            current: root.tab == 4;
                            clicked => { root.tab = 4; }
                        }
                        LibraryTab {
                            glyph: Glyph.slot;
                            label: I18n.t("Templates");
                            current: root.tab == 5;
                            clicked => { root.tab = 5; }
                        }
                    }
                }

                // Outside the sunken track, not in it: the track holds the
                // pages of *this* view and this button changes which view the
                // pane is, which is a different question about a different
                // thing.
                VerticalLayout {
                    alignment: center;
                    PaneSwitcher {
                        kind: PaneKind.media;
                        seat: root.pane-seat;
                        removable: root.pane-removable;
                        picked(kind) => { root.pane-picked(kind); }
                        removed => { root.pane-removed(); }
                    }
                }
            }
        }

        // The page: category sidebar, hairline, browsing area. Positioned by
        // hand for the reason the workspace is — the sidebar is a fixed column
        // and the rest is the remainder, and saying that directly is shorter
        // than a layout plus the stretch factors that would express it.
        body := Rectangle {
            vertical-stretch: 1;

            // The divider is the grab handle, exactly as it is between the
            // track column and the lanes. The sidebar is the only fixed
            // column in the window that could not be resized, and it is the
            // one carrying the longest labels — "Transitions", a category
            // name — so it was also the one most likely to be wrong for a
            // given page at a given window width.
            HairlineSplitter {
                x: root.sidebar;
                y: 0;
                height: parent.height;

                pressed => { root.press-sidebar = root.sidebar-w; }
                moved(delta) => {
                    // Floored so the labels keep their room, and capped at
                    // half the pane so the grid it is squeezing always has
                    // more of the pane than the list of what to put in it.
                    root.sidebar-w = Math.max(root.min-sidebar,
                        Math.min(parent.width / 2, root.press-sidebar + delta));
                }
            }

            Rectangle {
                // Pinned: an element with an explicit width but no x is
                // CENTRED in its parent by Slint's default geometry, and this
                // column spent two rounds of debugging drifting into the card
                // grid because of exactly that. Every element in this file
                // that sets one dimension must pin the other axis too.
                x: 0;
                width: root.sidebar;
                clip: true;

                // One group per page, each behind its own `if`.
                //
                // These were plain children with a `visible` toggle and a
                // height of zero when hidden, to keep a tab switch from
                // re-instantiating anything. That was wrong in a way that only
                // showed up on the later tabs: a zero-height child still takes
                // its share of the layout's `spacing`, so every group started
                // one pixel lower for each hidden row above it, and Templates
                // sat a dozen pixels below Media. A conditional group costs a
                // rebuild on a tab switch — which the pages themselves already
                // pay, a few lines down — and cannot drift.
                VerticalLayout {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    alignment: start;
                    padding: 4px;

                    if root.tab == 0: VerticalLayout {
                        spacing: 1px;
                        CategoryHeading {
                            height: 26px;
                            title: I18n.t("Media");
                            open: root.categories-open;
                            toggled => { root.categories-open = !root.categories-open; }
                        }
                        if root.categories-open: CategoryRow {
                            height: 24px;
                            label: I18n.t("All media");
                            count: root.count-all;
                            current: root.filter == MediaFilter.all;
                            clicked => { root.narrow(MediaFilter.all); }
                        }
                        if root.categories-open: CategoryRow {
                            height: 24px;
                            label: I18n.t("Video");
                            count: root.count-video;
                            current: root.filter == MediaFilter.video;
                            clicked => { root.narrow(MediaFilter.video); }
                        }
                        if root.categories-open: CategoryRow {
                            height: 24px;
                            label: I18n.t("Audio");
                            count: root.count-audio;
                            current: root.filter == MediaFilter.audio;
                            clicked => { root.narrow(MediaFilter.audio); }
                        }
                        if root.categories-open: CategoryRow {
                            height: 24px;
                            label: I18n.t("Images");
                            count: root.count-images;
                            current: root.filter == MediaFilter.images;
                            clicked => { root.narrow(MediaFilter.images); }
                        }

                        // What the editor made rather than the user
                        // imported, one shelf per origin. A voice read
                        // aloud is here and not under Audio, so the sound
                        // the user brought stays tellable from the sound
                        // the app wrote.
                        CategoryHeading {
                            height: 26px;
                            title: I18n.t("Generated");
                            open: root.generated-open;
                            toggled => { root.generated-open = !root.generated-open; }
                        }
                        if root.generated-open: CategoryRow {
                            height: 24px;
                            label: I18n.t("Speech");
                            count: root.count-speech;
                            current: root.filter == MediaFilter.speech;
                            clicked => { root.narrow(MediaFilter.speech); }
                        }
                        // A clip's sound written out as it played, from
                        // the clip's own menu: a file of its own, apart
                        // from the import it was cut from.
                        if root.generated-open: CategoryRow {
                            height: 24px;
                            label: I18n.t("Processed");
                            count: root.count-processed;
                            current: root.filter == MediaFilter.processed;
                            clicked => { root.narrow(MediaFilter.processed); }
                        }
                    }

                    if root.tab == 1: VerticalLayout {
                        spacing: 1px;
                        CategoryHeading {
                            height: 26px;
                            title: I18n.t("Text");
                            open: root.text-open;
                            toggled => { root.text-open = !root.text-open; }
                        }
                        if root.text-open: CategoryRow {
                            height: 24px;
                            label: I18n.t("Titles");
                            current: root.text-category == 0;
                            clicked => { root.text-category = 0; }
                        }
                        if root.text-open: CategoryRow {
                            height: 24px;
                            label: I18n.t("Presets");
                            current: root.text-category == 1;
                            clicked => { root.text-category = 1; }
                        }
                    }

                    if root.tab == 2: VerticalLayout {
                        spacing: 1px;
                        CategoryHeading {
                            height: 26px;
                            title: I18n.t("Transitions");
                            open: root.transitions-open;
                            toggled => { root.transitions-open = !root.transitions-open; }
                        }
                        if root.transitions-open: VerticalLayout {
                            spacing: 1px;
                            for label[index] in root.transition-groups: CategoryRow {
                                height: 24px;
                                label: label;
                                current: Library.view(3).group == index;
                                clicked => { Library.group-changed(3, index); }
                            }
                        }
                    }

                    // The picture's shelves and the sound's, from the
                    // catalogue's own groups, on one page called Effects.
                    if root.tab == 3: VerticalLayout {
                        spacing: 1px;
                        CategoryHeading {
                            height: 26px;
                            title: I18n.t("Video Effects");
                            open: root.effects-open;
                            toggled => { root.effects-open = !root.effects-open; }
                        }
                        if root.effects-open: VerticalLayout {
                            spacing: 1px;
                            for label[index] in root.effect-groups: CategoryRow {
                                height: 24px;
                                label: label;
                                current: !root.audio-shelf && Library.view(1).group == index;
                                clicked => {
                                    root.audio-shelf = false;
                                    Library.group-changed(1, index);
                                }
                            }
                        }
                        CategoryHeading {
                            height: 26px;
                            title: I18n.t("Audio Effects");
                            open: root.audio-open;
                            toggled => { root.audio-open = !root.audio-open; }
                        }
                        if root.audio-open: VerticalLayout {
                            spacing: 1px;
                            for label[index] in root.audio-groups: CategoryRow {
                                height: 24px;
                                label: label;
                                current: root.audio-shelf && Library.view(2).group == index;
                                clicked => {
                                    root.audio-shelf = true;
                                    Library.group-changed(2, index);
                                }
                            }
                        }
                    }

                    // Filters are colour looks, the way every video editor's
                    // users understand the word. What a voice or a room does
                    // to the sound is on the Effects page.
                    if root.tab == 4: VerticalLayout {
                        spacing: 1px;
                        CategoryHeading {
                            height: 26px;
                            title: I18n.t("Filters");
                            open: root.filters-open;
                            toggled => { root.filters-open = !root.filters-open; }
                        }
                        if root.filters-open: VerticalLayout {
                            spacing: 1px;
                            for label[index] in root.filter-groups: CategoryRow {
                                height: 24px;
                                label: label;
                                current: Library.view(0).group == index;
                                clicked => { Library.group-changed(0, index); }
                            }
                        }
                    }

                    if root.tab == 5: VerticalLayout {
                        spacing: 1px;
                        CategoryHeading {
                            height: 26px;
                            title: I18n.t("Templates");
                            open: root.templates-open;
                            toggled => { root.templates-open = !root.templates-open; }
                        }
                        if root.templates-open: CategoryRow {
                            height: 24px;
                            label: I18n.t("My templates");
                            current: true;
                        }
                    }
                }
            }

            pages := PaneScroll {
                x: root.sidebar + 1px;
                width: Math.max(0px, parent.width - root.sidebar - 1px);
                height: parent.height;

                if root.tab == 0: HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    // Import holds the left edge at the width its own word
                    // needs; sort and filter are pushed against the right by
                    // the gap between, which is the only part of the row with
                    // any give in it.
                    ImportButton {
                        // The row holds one other control, and two controls
                        // side by side at two different heights read as two
                        // rows that failed to line up.
                        height: Theme.h;
                        horizontal-stretch: 0;
                        busy: root.importing;
                        clicked => { root.import-media(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // Sort, and sort only: narrowing the bin by kind is the
                    // sidebar's, where each kind carries its count and the
                    // current one stays lit. A second control saying the same
                    // thing from the other side of the panel can only ever
                    // agree with it or contradict it.
                    //
                    // Marked rather than worded: at the end of a row this
                    // narrow, "Sort: Added" costs more room than it earns, and
                    // the list behind it still spells all three out.
                    Select {
                        horizontal-stretch: 0;
                        width: self.natural-width;
                        options: [I18n.t("Sort: Added"), I18n.t("Sort: Name"),
                            I18n.t("Sort: Type")];
                        icons: [Glyph.clock, Glyph.text-mark, Glyph.tag];
                        current: 0;
                        changed(index) => { root.sort-changed(index); }
                    }
                }

                // Only worth a row when a multiple selection exists — one
                // selected card is deleted from the card itself.
                if root.tab == 0 && root.selected-count > 1: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-bottom: 8px;

                    Rectangle {
                        height: 28px;
                        background: Theme.well;
                        border-radius: Theme.r;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 8px;

                            Text {
                                horizontal-stretch: 1;
                                text: "\{root.selected-count} selected";
                                color: Theme.fg-muted;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: wipe.width + 16px;
                                    height: 20px;
                                    border-radius: Theme.r-xs;
                                    background: bin.has-hover ? Theme.danger-soft
                                        : Colors.transparent;

                                    wipe := Text {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        text: I18n.t("Delete");
                                        color: Theme.danger;
                                        font-size: Theme.fs-sm;
                                    }

                                    bin := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.remove-selected(); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.tab == 0 && root.items.length == 0: Empty {
                    glyph: Glyph.import;
                    text: root.filter == MediaFilter.speech
                        ? I18n.t("Nothing read aloud yet. Text to speech puts its voice here.")
                        : root.filter == MediaFilter.processed
                        ? I18n.t("Nothing rendered yet. Right-click a clip on the timeline and render its sound to put it here.")
                        : root.count-all > 0
                        ? I18n.t("Nothing of that kind in this project.")
                        : "Drop video and audio files anywhere in the window to import them.";
                }

                if root.tab == 0 && root.items.length > 0: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-bottom: 8px;

                    MediaGrid {
                        horizontal-stretch: 1;
                        items: root.items;
                        // Whatever the page has left after the rows above it:
                        // the import row is 8 + 36 + 8, the delete strip 28
                        // and its own 8, and this row keeps 8 under itself.
                        // Counted rather than measured, because reading a
                        // sibling's laid-out height from inside the layout
                        // that assigns it is a binding loop waiting to happen.
                        page-floor: Math.max(0px, pages.height - 52px
                            - (root.selected-count > 1 ? 36px : 0px) - 8px);

                        menu-items: root.menu-items;
                        menu-height: root.menu-height;
                        menu-token: root.menu-token;

                        pressed => { root.floor-pressed(); }
                        clicked(id, additive) => { root.select(id, additive); }
                        activated(id) => { root.activate(id); }
                        removed(id) => { root.remove(id); }
                        context(id) => { root.context(id); }
                        menu-selected(id) => { root.menu-selected(id); }
                        band-selected(columns, from-col, to-col, from-row, to-row, additive) => {
                            root.band-selected(columns, from-col, to-col,
                                from-row, to-row, additive);
                        }
                    }
                }

                if root.tab == 1 && root.text-category == 0: HorizontalLayout {
                    padding: 8px;

                    TextPage {
                        horizontal-stretch: 1;
                        add-text => { root.add-text("default"); }
                    }
                }

                // The looks. Each card is a title in that look, placed at
                // the playhead on a click or dragged onto a lane; a preset
                // that brings a font installs it on the way.
                if root.tab == 1 && root.text-category == 1: HorizontalLayout {
                    padding: 8px;

                    PresetGrid {
                        horizontal-stretch: 1;
                        items: root.presets;
                        applied(id) => { root.add-text(id); }
                    }
                }

                if root.tab == 2: VerticalLayout {
                    padding: 8px;

                    ShelfSearch {
                        shelf: 3;
                        placeholder: I18n.t1("Search {0}s", I18n.t("transition"));
                    }
                    ShelfGrid {
                        entries: root.catalogue-transitions;
                        glyph: Glyph.transition;
                        art(id) => { return root.art-of(id); }
                        // Transitions apply directly on single-click — no audition overlay.
                        auditions: false;
                        applied(id, label) => { root.apply-transition(id); }
                    }
                }

                if root.tab == 3: VerticalLayout {
                    padding: 8px;

                    ShelfSearch {
                        shelf: root.effects-shelf;
                        placeholder: root.audio-shelf
                            ? I18n.t1("Search {0}s", I18n.t("audio effect"))
                            : I18n.t1("Search {0}s", I18n.t("effect"));
                    }
                    if !root.audio-shelf: CategoryPillBar {
                        current: Library.view(root.effects-shelf).category;
                        picked(cat) => {
                            Library.category-changed(root.effects-shelf, cat);
                        }
                    }
                    if !root.audio-shelf: Rectangle { height: 6px; }
                    // A package folder written while the app runs - the
                    // user's own effect, or one shared with them - is read
                    // in here, without a restart.
                    ImportButton {
                        label: I18n.t("Reload custom effects");
                        glyph: Glyph.reset;
                        clicked => { root.reload-packages(); }
                    }
                    Rectangle { height: 8px; }
                    ShelfGrid {
                        entries: root.audio-shelf ? root.catalogue-audio : root.catalogue-effects;
                        glyph: root.audio-shelf ? Glyph.waveform : Glyph.sparkle;
                        art(id) => { return root.art-of(id); }
                        // Effects apply directly on single-click to the selected clip —
                        // auditions:false means click = apply, no monitor overlay confusion.
                        auditions: false;
                        applied(id, label) => {
                            if (root.audio-shelf) {
                                root.apply-audio(id);
                            } else {
                                root.apply-effect(id);
                            }
                        }
                    }
                }

                if root.tab == 4: VerticalLayout {
                    padding: 8px;

                    // A filter is a layer over a span of the timeline,
                    // dragged onto the lanes like a piece of media - the
                    // payload says so. Short of a drag, a click shows the
                    // look over the monitor, and a double-click or the
                    // card's plus lays it at the playhead.
                    ShelfSearch {
                        shelf: 0;
                        placeholder: I18n.t1("Search {0}s", I18n.t("filter"));
                    }
                    // A table from any grading tool becomes a look here, the
                    // way it does on every desktop editor's Filters page.
                    HorizontalLayout {
                        spacing: 8px;
                        ImportButton {
                            label: I18n.t("Import a LUT (.cube)");
                            glyph: Glyph.import;
                            clicked => { root.import-lut(); }
                        }
                        ImportButton {
                            label: I18n.t("Reload custom effects");
                            glyph: Glyph.reset;
                            clicked => { root.reload-packages(); }
                        }
                    }
                    Rectangle { height: 8px; }
                    ShelfGrid {
                        entries: root.catalogue-filters;
                        payload-kind: "filter";
                        auditions: true;
                        auditioning: root.audition;
                        art(id) => { return root.art-of(id); }
                        auditioned(id) => { root.audition-filter(id); }
                        applied(id, label) => { root.apply-filter(id, label); }
                    }
                }

                // Templates: the save affordance, then the gallery of saved
                // templates, which shows its empty state until one is saved.
                if root.tab == 5: HorizontalLayout {
                    padding: 8px;

                    ImportButton {
                        label: I18n.t("Save this project as a template");
                        glyph: Glyph.slot;
                        clicked => { root.save-template(); }
                    }
                }

                if root.tab == 5: Empty {
                    glyph: Glyph.slot;
                    text: I18n.t("No templates yet. Mark media as slots, then save this project as a template.");
                }
            }
        }
    }
}
