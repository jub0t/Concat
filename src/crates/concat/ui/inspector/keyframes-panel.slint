// The Keyframes panel: every knob of the selected clip that can ride, as a
// row - the knob itself, and under it a strip of the clip with a diamond
// at every key and a hairline where the playhead is. Changing the knob sets
// the key under the playhead; clicking a diamond goes to it; dragging one
// moves it. Below the rows, the ease into the key the playhead is on, or is
// heading for, as a curve.

import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { IconButton, Row, Section, SectionHeader } from "../primitives/panel.slint";
import { Button } from "../primitives/modal.slint";
import { Select } from "../primitives/select.slint";
import { BezierEditor } from "../primitives/bezier-editor.slint";
import { HelpButton, InspectorFmt, Param, ParamFormat, Subhead } from "controls.slint";
import { ClipField, ClipKeyData, Keyframes, SelectedClipData } from "../timeline/model.slint";

/// One key on a row's strip: where in the clip, `0..1`, and whether the
/// playhead is on it.
export struct KeyMarkData {
    at: float,
    here: bool,
}

/// One row of the panel: a keyable knob, its keys, and its ease.
export struct KeyRowData {
    /// The clip property, for a row that is one.
    field: ClipField,
    /// The Adjust knob's key, for a row that is one; empty for a property.
    param: string,
    label: string,
    keys: [KeyMarkData],
    state: ClipKeyData,
    /// What the knob is worth at the playhead, in the knob's own units.
    value: float,
    minimum: float,
    maximum: float,
    step: float,
    default-value: float,
    fmt: ParamFormat,
    unit: string,
    unit-scale: float,
    /// The ease into the key the playhead is on, or else the next key: the
    /// segment being played.
    ease-x1: float,
    ease-y1: float,
    ease-x2: float,
    ease-y2: float,
    /// That key exists and has a key behind it to ease from.
    has-ease: bool,
    /// Where that key sits, to write the ease back to.
    ease-at: float,
}

/// The panel's rows and verbs, a global so Rust publishes one list.
export global KeyEditor {
    in property <[KeyRowData]> rows;
    /// The playhead's place in the selected clip, `0..1`, held to its ends.
    in property <float> at;

    /// Move the playhead to `at` of the selected clip.
    callback jump(at: float);
    /// Move the key at `from` to `to` on a property, or on the Adjust knob
    /// `param` names.
    callback move-key(field: ClipField, param: string, from: float, to: float);
    /// Set the ease into the key at `at`.
    callback set-ease(field: ClipField, param: string, at: float, x1: float, y1: float, x2: float, y2: float);
    /// Move the playhead to the nearest key behind (-1) or ahead (+1) on
    /// any knob of the clip.
    callback step-all(delta: int);
    /// Take every key off the clip.
    callback clear-all();
}

/// The strip under a row: the clip's length, its keys as diamonds, the
/// playhead as a hairline. A diamond is clicked to go to its key and
/// dragged to move it.
component KeyStrip inherits Rectangle {
    in property <[KeyMarkData]> keys;
    in property <float> at;
    callback jump(at: float);
    callback moved(from: float, to: float);

    height: 18px;

    Rectangle {
        x: 0;
        y: root.height / 2 - 1px;
        width: root.width;
        height: 2px;
        border-radius: 1px;
        background: Theme.line-strong;
    }

    Rectangle {
        x: root.at * root.width;
        y: 0;
        width: 1px;
        height: root.height;
        background: Theme.accent;
        opacity: 0.7;
    }

    for key in root.keys: TouchArea {
        property <float> drag-at: key.at;
        property <bool> dragging;
        property <float> shown-at: self.dragging ? self.drag-at : key.at;

        x: self.shown-at * root.width - 7px;
        y: 0;
        width: 14px;
        height: root.height;
        mouse-cursor: pointer;

        Path {
            x: 2px;
            y: root.height / 2 - 5px;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M 5 0.75 L 9.25 5 L 5 9.25 L 0.75 5 Z";
            fill: key.here ? Theme.accent : Theme.panel;
            stroke: Theme.accent;
            stroke-width: 1.5px;
        }

        moved => {
            if (self.pressed) {
                self.dragging = true;
                self.drag-at = Math.max(0, Math.min(1,
                    key.at + (self.mouse-x - self.pressed-x) / root.width));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (self.dragging && Math.abs(self.drag-at - key.at) > 0.002) {
                    root.moved(key.at, self.drag-at);
                } else if (event.kind == PointerEventKind.up) {
                    root.jump(key.at);
                }
                self.dragging = false;
            }
        }
    }
}

/// The ease presets the curve editor offers, matched within a hair.
component EasePreset inherits Select {
    in property <float> x1;
    in property <float> y1;
    in property <float> x2;
    in property <float> y2;
    callback picked(x1: float, y1: float, x2: float, y2: float);

    pure function near(a: float, b: float) -> bool { return Math.abs(a - b) < 0.005; }
    pure function matches(px1: float, py1: float, px2: float, py2: float) -> bool {
        return near(root.x1, px1) && near(root.y1, py1) && near(root.x2, px2) && near(root.y2, py2);
    }

    options: [I18n.t("Linear"), I18n.t("Ease in"), I18n.t("Ease out"), I18n.t("Ease in and out"), I18n.t("Custom")];
    current: matches(0, 0, 1, 1) ? 0
        : matches(0.42, 0, 1, 1) ? 1
        : matches(0, 0, 0.58, 1) ? 2
        : matches(0.42, 0, 0.58, 1) ? 3
        : 4;
    changed(index) => {
        if (index == 0) { root.picked(0, 0, 1, 1); }
        else if (index == 1) { root.picked(0.42, 0, 1, 1); }
        else if (index == 2) { root.picked(0, 0, 0.58, 1); }
        else if (index == 3) { root.picked(0.42, 0, 0.58, 1); }
    }
}

export component KeyframesPanel inherits VerticalLayout {
    in property <SelectedClipData> selected;

    callback set(field: ClipField, value: float);
    callback set-param(key: string, value: float);
    callback commit();

    /// The row whose ease is shown: the last one touched.
    property <int> active: 0;
    property <int> shown-row: Math.max(0, Math.min(root.active, KeyEditor.rows.length - 1));
    property <bool> any-keys: KeyEditor.rows.length > 0;
    /// The row whose ease the curve shows.
    property <KeyRowData> ease-row: root.any-keys ? KeyEditor.rows[root.shown-row] : KeyEditor.rows[0];

    Section {
        first: true;
        SectionHeader {
            title: I18n.t("Keyframes");
            HelpButton {
                text: I18n.t("Every knob that can ride is a row: its keys along the clip, the playhead's place among them, and its value there. Change the value to set the key under the playhead. Click a diamond to go to its key, drag one to move it. The curve is the way into the key the playhead is on, or is heading for.");
            }
        }

        Row {
            HorizontalLayout {
                spacing: 6px;
                IconButton {
                    glyph: Glyph.chevron-left;
                    label: I18n.t("Previous key");
                    enabled: Keyframes.available;
                    clicked => { KeyEditor.step-all(-1); }
                }
                IconButton {
                    glyph: Glyph.chevron-right;
                    label: I18n.t("Next key");
                    enabled: Keyframes.available;
                    clicked => { KeyEditor.step-all(1); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    label: I18n.t("Clear all keys");
                    enabled: root.any-keys;
                    clicked => { KeyEditor.clear-all(); }
                }
            }
        }

        for row[index] in KeyEditor.rows: Rectangle {
            property <KeyRowData> data: row;
            changed data => { knob.value = self.data.value; }

            VerticalLayout {
                spacing: 2px;
                knob := Param {
                    label: row.label;
                    value: row.value;
                    minimum: row.minimum;
                    maximum: row.maximum;
                    step: row.step;
                    default-value: row.default-value;
                    fmt: row.fmt;
                    unit: row.unit;
                    unit-scale: row.unit-scale;
                    keyable: true;
                    field: row.field;
                    key-name: row.param;
                    key-state: row.state;
                    changed(v) => {
                        root.active = index;
                        if (row.param != "") { root.set-param(row.param, v); }
                        // The level knob speaks decibels; the clip holds a gain.
                        else if (row.field == ClipField.volume) { root.set(row.field, InspectorFmt.from-decibels(v)); }
                        else { root.set(row.field, v); }
                        root.commit();
                    }
                }
                KeyStrip {
                    keys: row.keys;
                    at: KeyEditor.at;
                    jump(at) => { root.active = index; KeyEditor.jump(at); }
                    moved(from, to) => { root.active = index; KeyEditor.move-key(row.field, row.param, from, to); }
                }
            }
        }

        if root.any-keys && root.ease-row.has-ease: VerticalLayout {
            spacing: 6px;

            Subhead { title: I18n.t("Ease into the key"); }
            Row {
                EasePreset {
                    x1: root.ease-row.ease-x1;
                    y1: root.ease-row.ease-y1;
                    x2: root.ease-row.ease-x2;
                    y2: root.ease-row.ease-y2;
                    picked(x1, y1, x2, y2) => {
                        KeyEditor.set-ease(root.ease-row.field, root.ease-row.param, root.ease-row.ease-at, x1, y1, x2, y2);
                    }
                }
            }
            Rectangle {
                // The editor's handles are in-out and stop following a
                // binding once dragged; a row change puts them back.
                property <KeyRowData> shown: root.ease-row;
                changed shown => {
                    curve.x1 = self.shown.ease-x1;
                    curve.y1 = self.shown.ease-y1;
                    curve.x2 = self.shown.ease-x2;
                    curve.y2 = self.shown.ease-y2;
                }
                height: 200px;
                curve := BezierEditor {
                    x1: root.ease-row.ease-x1;
                    y1: root.ease-row.ease-y1;
                    x2: root.ease-row.ease-x2;
                    y2: root.ease-row.ease-y2;
                    changed => {
                        KeyEditor.set-ease(root.ease-row.field, root.ease-row.param, root.ease-row.ease-at, self.x1, self.y1, self.x2, self.y2);
                    }
                }
            }
        }
    }
}
