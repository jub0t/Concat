import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph } from "../icons.slint";
import { Row, Section, SectionBody, SectionHeader } from "../primitives/panel.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";
import { NumberField } from "../primitives/number-field.slint";
import {
    ColourField, HelpButton, InspectorFmt, Param, ParamFormat, SwitchRow,
} from "controls.slint";
import {
    ClipField, ClipTextField, SelectedClipData, TextAlignment,
} from "../timeline/model.slint";

// The Text tab.
//
// A title is the one thing on the timeline that is not a file, so it gets its
// own inspector and nothing else: no volume, no speed, no audio filters.
// Offering those tabs would be offering panels that can only say "nothing
// here", which is why the tab strip drops them rather than disabling them.
//
// Five drawers, in the order a title is made: the words, their typography,
// the stroke around them, the box they sit in, and where the box goes.
//
// The document keeps sizes as fractions of the output frame, never points
// or pixels, so a title dialled in at 1080p does not move when the project
// is exported at 4K. The box's width and height are the exception on
// screen: they are shown and typed in pixels of the current frame, because
// "400 wide" is a size a person can picture and "20.8%" is not - the
// fraction is what is stored, still.
export component TextPanel inherits VerticalLayout {
    in property <SelectedClipData> selected;
    /// The faces this build bundles.
    in property <[string]> families: ["Hanken Grotesk"];

    callback set(field: ClipField, value: float);
    callback set-text(field: ClipTextField, value: string);
    callback set-colour(field: ClipTextField, value: color);
    callback commit();

    // Local editing state, seeded rather than bound — see the note on
    // AdjustPanel, which has the same problem for the same reason.
    property <float> size;
    property <float> alpha;
    property <float> stroke-width;
    property <float> stroke-alpha;
    property <float> line-height;
    property <float> tracking;
    property <float> box-w;
    property <float> box-h;
    property <float> offset-x;
    property <float> offset-y;
    property <int> weight-index;
    property <int> family-index;
    property <string> content;

    property <[float]> weights: [400, 500, 600, 700];
    /// The label column of the rows whose label is two words.
    property <length> label-w: 74px;
    property <float> frame-w: Math.max(1, root.selected.frame-width);
    property <float> frame-h: Math.max(1, root.selected.frame-height);

    function seed() {
        root.content = root.selected.content;
        root.size = root.selected.font-size;
        root.alpha = root.selected.text-opacity;
        root.stroke-width = root.selected.stroke-width;
        root.stroke-alpha = root.selected.stroke-opacity;
        root.line-height = root.selected.line-height;
        root.tracking = root.selected.tracking;
        root.box-w = root.selected.text-width * root.frame-w;
        root.box-h = root.selected.text-height * root.frame-h;
        root.offset-x = root.selected.offset-x;
        root.offset-y = root.selected.offset-y;
        root.weight-index = root.selected.font-weight >= 700 ? 3
            : root.selected.font-weight >= 600 ? 2
            : root.selected.font-weight >= 500 ? 1 : 0;
        // One bundled face; a title from an older document that named a
        // retired one is painted in it too, so it is that row as well.
        root.family-index = 0;
    }

    init => { root.seed(); }
    changed selected => { root.seed(); }

    /// A box side in pixels: "auto" at zero, else the whole number.
    pure function px(v: float) -> string {
        return v <= 0 ? I18n.t("auto") : "\{Math.round(v)}";
    }

    // ── content ──────────────────────────────────────────────────────────
    Section {
        first: true;
        content := SectionHeader {
            title: I18n.t("Content");
            collapsible: true;
            summary: root.selected.content == "" ? "Empty" : root.selected.content;
        }

        if content.open: SectionBody {
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-bottom: 4px;

            Rectangle {
                height: 64px;
                border-radius: Theme.r;
                background: Theme.field;
                border-width: 1px;
                border-color: body.has-focus ? Theme.accent : Theme.line;
                clip: true;

                body := TextInput {
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    height: parent.height - 12px;
                    text: root.content;
                    color: Theme.fg;
                    font-size: Theme.fs;
                    // Multi-line: a lower third is routinely two lines, and a
                    // single-line field would silently eat the break.
                    single-line: false;
                    wrap: word-wrap;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;

                    // Every keystroke goes to the echo so the monitor shows
                    // the words as they are typed; the commit waits for the
                    // way out, so a title being typed is one change and not
                    // forty.
                    edited => {
                        root.content = self.text;
                        root.set-text(ClipTextField.content, self.text);
                    }
                    changed has-focus => {
                        if (!self.has-focus) {
                            root.set-text(ClipTextField.content, root.content);
                            root.commit();
                        }
                    }

                    // Slint binds Home and End to nothing on macOS, so they
                    // walked up to the window's playhead shortcuts and the
                    // preview went blank mid-sentence. They belong to the
                    // text: the start and the end of it.
                    key-pressed(event) => {
                        if (event.text == Key.Home) {
                            self.set-selection-offsets(0, 0);
                            return accept;
                        }
                        if (event.text == Key.End) {
                            self.set-selection-offsets(1000000000, 1000000000);
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }
    }

    // ── typography ───────────────────────────────────────────────────────
    // The face, its weight and size, and its colour: one drawer, because
    // they are one decision. A colour drawer apart from the font it colours
    // was two places to look for how the words look.
    Section {
        typography := SectionHeader {
            title: I18n.t("Typography");
            collapsible: true;
            summary: root.selected.font-family + " · "
                + InspectorFmt.format(ParamFormat.height, root.size) + " · "
                + root.selected.fill-hex;
        }

        if typography.open: SectionBody {
        Row {
            label: I18n.t("Font");
            label-width: root.label-w;
            Select {
                options: root.families;
                current <=> root.family-index;
                changed(index) => {
                    root.set-text(ClipTextField.font-family, root.families[index]);
                    root.commit();
                }
            }
        }

        Row {
            label: I18n.t("Font Weight");
            label-width: root.label-w;
            Select {
                options: [I18n.t("Regular"), I18n.t("Medium"), I18n.t("SemiBold"), I18n.t("Bold")];
                current <=> root.weight-index;
                changed(index) => {
                    root.set(ClipField.font-weight, root.weights[index]);
                    root.commit();
                }
            }
        }

        Param {
            label: I18n.t("Size");
            value <=> root.size;
            minimum: 0.01;
            maximum: 0.5;
            step: 0.005;
            default-value: 0.09;
            fmt: ParamFormat.height;
            unit: "%";
            unit-scale: 100;
            changed(v) => { root.set(ClipField.font-size, v); root.commit(); }
        }

        SwitchRow {
            label: I18n.t("Italic");
            checked: root.selected.italic;
            toggled(on) => { root.set(ClipField.italic, on ? 1 : 0); root.commit(); }
        }

        // The fill has no alpha of its own: the title's Opacity below is
        // the one dial for how solid the words are.
        ColourField {
            label: I18n.t("Color");
            value: root.selected.fill;
            hex: root.selected.fill-hex;
            alpha: false;
            changed(colour) => { root.set-colour(ClipTextField.color, colour); root.commit(); }
        }

        Param {
            label: I18n.t("Opacity");
            value <=> root.alpha;
            minimum: 0;
            maximum: 1;
            step: 0.01;
            default-value: 1;
            fmt: ParamFormat.fraction;
            unit: "%";
            unit-scale: 100;
            changed(v) => { root.set(ClipField.text-opacity, v); root.commit(); }
        }

        SwitchRow {
            label: I18n.t("Drop shadow");
            checked: root.selected.shadow;

            HelpButton { text: I18n.t("A soft shadow under the words, for titles that have to sit over footage you do not control."); }

            toggled(on) => { root.set(ClipField.shadow, on ? 1 : 0); root.commit(); }
        }

        SwitchRow {
            label: I18n.t("Plate");
            checked: root.selected.plated;

            HelpButton { text: I18n.t("A solid band behind the words. Where a shadow softens the background, a plate replaces it — use it when the footage underneath is busy enough that neither weight nor outline will hold."); }

            toggled(on) => {
                // A plate is a colour, not a flag: turning it off is clearing
                // it. Fully transparent is what "no plate" is stored as.
                root.set-colour(ClipTextField.background,
                    on ? Theme.plate-on : Colors.transparent);
                root.commit();
            }
        }

        if root.selected.plated: ColourField {
            label: I18n.t("Plate color");
            value: root.selected.plate;
            hex: root.selected.plate-hex;
            alpha: true;
            changed(shade) => {
                root.set-colour(ClipTextField.background, shade);
                root.commit();
            }
        }
        }
    }

    // ── stroke ───────────────────────────────────────────────────────────
    Section {
        stroke := SectionHeader {
            title: I18n.t("Stroke");
            collapsible: true;
            open: false;
            summary: InspectorFmt.format(ParamFormat.outline, root.stroke-width);
        }

        if stroke.open: SectionBody {
        Param {
            label: I18n.t("Width");
            value <=> root.stroke-width;
            minimum: 0;
            maximum: 0.15;
            step: 0.005;
            default-value: 0;
            fmt: ParamFormat.outline;
            unit: "%";
            unit-scale: 100;
            changed(v) => { root.set(ClipField.stroke-width, v); root.commit(); }
        }

        // Only once there is a stroke to colour: a swatch for a stroke of
        // zero width sets something nobody can see. The stroke's opacity is
        // its colour's alpha - the picker's strip and this dial are one
        // number - kept apart from the title's own Opacity so an outline
        // can fade while the words stay solid.
        if root.selected.stroke-width > 0: ColourField {
            label: I18n.t("Color");
            value: root.selected.stroke;
            hex: root.selected.stroke-hex;
            alpha: true;
            changed(shade) => {
                root.set-colour(ClipTextField.stroke-color, shade);
                root.commit();
            }
        }

        if root.selected.stroke-width > 0: Param {
            label: I18n.t("Opacity");
            value <=> root.stroke-alpha;
            minimum: 0;
            maximum: 1;
            step: 0.01;
            default-value: 1;
            fmt: ParamFormat.fraction;
            unit: "%";
            unit-scale: 100;
            changed(v) => { root.set(ClipField.stroke-opacity, v); root.commit(); }
        }
        }
    }

    // ── layout ───────────────────────────────────────────────────────────
    // How the words fill their box, and how big the box is.
    Section {
        layout := SectionHeader {
            title: I18n.t("Layout");
            collapsible: true;
            summary: (root.selected.align == TextAlignment.right ? I18n.t("Right")
                : root.selected.align == TextAlignment.center ? I18n.t("Center") : I18n.t("Left"))
                + " · " + root.px(root.box-w) + " × " + root.px(root.box-h);
        }

        if layout.open: SectionBody {
        Row {
            label: I18n.t("Text Align");
            label-width: root.label-w;
            SegmentedControl {
                options: [I18n.t("Left"), I18n.t("Center"), I18n.t("Right")];
                icons: [Glyph.align-left, Glyph.align-center-x, Glyph.align-right];
                current: root.selected.align == TextAlignment.right ? 2
                    : root.selected.align == TextAlignment.center ? 1 : 0;
                changed(index) => { root.set(ClipField.align, index); root.commit(); }
            }
        }

        // The box, in pixels of the frame. Zero is "auto": that side is
        // sized by the words. The stage's grips pull the same two numbers;
        // here they can be typed exactly.
        Row {
            label: I18n.t("Width");
            label-width: root.label-w;
            NumberField {
                prefix: "W";
                unit: "px";
                value <=> root.box-w;
                minimum: 0;
                maximum: root.frame-w * 2;
                step: 1;
                format(v) => { return root.px(v); }
                parse(t) => { return t.is-float() ? Math.max(0, t.to-float()) : 0; }
                changed(v) => { root.set(ClipField.text-width, v / root.frame-w); root.commit(); }
            }
        }
        Row {
            label: I18n.t("Height");
            label-width: root.label-w;
            NumberField {
                prefix: "H";
                unit: "px";
                value <=> root.box-h;
                minimum: 0;
                maximum: root.frame-h * 2;
                step: 1;
                format(v) => { return root.px(v); }
                parse(t) => { return t.is-float() ? Math.max(0, t.to-float()) : 0; }
                changed(v) => { root.set(ClipField.text-height, v / root.frame-h); root.commit(); }
            }
        }

        Param {
            label: I18n.t("Line height");
            value <=> root.line-height;
            minimum: 0.7;
            maximum: 2.5;
            step: 0.05;
            default-value: 1.2;
            fmt: ParamFormat.rate;
            unit: "x";
            changed(v) => { root.set(ClipField.line-height, v); root.commit(); }
        }

        Param {
            label: I18n.t("Tracking");
            value <=> root.tracking;
            minimum: -0.05;
            maximum: 0.3;
            step: 0.005;
            default-value: 0;
            fmt: ParamFormat.outline;
            unit: "%";
            unit-scale: 100;
            changed(v) => { root.set(ClipField.tracking, v); root.commit(); }
        }
        }
    }

    // ── position ─────────────────────────────────────────────────────────
    Section {
        position := SectionHeader {
            title: I18n.t("Position");
            collapsible: true;
            summary: InspectorFmt.format(ParamFormat.centred, root.offset-x)
                + " · " + InspectorFmt.format(ParamFormat.centred, root.offset-y);
        }

        if position.open: SectionBody {
        Param {
            label: I18n.t("Horizontal");
            value <=> root.offset-x;
            minimum: -0.5;
            maximum: 0.5;
            step: 0.005;
            default-value: 0;
            fmt: ParamFormat.centred;
            unit: "%";
            unit-scale: 100;
            changed(v) => { root.set(ClipField.offset-x, v); root.commit(); }
        }

        Param {
            label: I18n.t("Vertical");
            value <=> root.offset-y;
            minimum: -0.5;
            maximum: 0.5;
            step: 0.005;
            default-value: 0;
            fmt: ParamFormat.centred;
            unit: "%";
            unit-scale: 100;
            changed(v) => { root.set(ClipField.offset-y, v); root.commit(); }
        }
        }
    }
}
