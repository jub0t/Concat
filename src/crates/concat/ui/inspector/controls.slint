import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Fmt } from "../util.slint";
import { Glyph, Icon } from "../icons.slint";
import { NumberField } from "../primitives/number-field.slint";
import { Stepper } from "../primitives/stepper.slint";
import { ColorPicker } from "../primitives/color-picker.slint";
import { ClipField, ClipKeyData, Keyframes } from "../timeline/model.slint";

// The clip inspector's controls: a horizontal fader, the Param row that
// repeats down every tab, a switch, a help disclosure, a note, and a search
// field. Written to the same contract as primitives/ — value plus a changed
// callback — so promoting one later is a file move rather than a rewrite.

// How a parameter's readout is spelled. A Slint struct cannot carry a
// closure, so the catalogue names one of these per param and InspectorFmt
// renders it.
export enum ParamFormat {
    percent,     // "45%"
    pitch,       // 0 is I18n.t("common.autoValue"), else "+3 st"
    seconds,     // 0 is I18n.t("common.off"), else "1.4 s"
    millis,      // 0 is I18n.t("common.off"), else "320 ms"
    hertz,       // "120 Hz", "6.5 kHz"
    decibels,    // "-18.0 dB", "+3.0 dB"
    ratio,       // "4.0 : 1"
    rate-hz,     // "1.2 Hz"
    steps,       // "12"
    rate,        // "1.00x"
    fade,        // 0 is I18n.t("common.none"), else "1.5 s"

    // The clip inspector's own. Several of these are fractions of something —
    // the frame's height, the frame's width — rather than absolute units,
    // because the frame can be any resolution and points would be a lie.
    fraction,    // 0..1 as a whole percent: "72%"
    centred,     // a signed offset: I18n.t("controls.centred") at zero, else "-12.5%"
    degrees,     // "45°"
    gain,        // decibels, with the floor spelled I18n.t("controls.silent")
    height,      // "9.0% of height"
    outline,     // 0 is I18n.t("common.none"), else "3.5%"
    seconds2,    // "1.25s" — two places, for a fade dialled against a duration

    // For a package parameter whose unit the manifest did not name, or
    // named in a unit nothing above spells.
    plain,       // "1.25", or "12" when it is whole
    kelvin,      // "4600 K"
    stops,       // "+0.50 EV", "0.00 EV"
}

export global InspectorFmt {
    // "3.5", with the trailing zero a bare interpolation would drop.
    public pure function fixed1(v: float) -> string {
        return (v < 0 ? "-" : "")
            + "\{Math.floor(Math.abs(Fmt.round-to(v, 1)))}.\{Math.mod(Math.round(Math.abs(v) * 10), 10)}";
    }

    public pure function fixed2(v: float) -> string {
        return (v < 0 ? "-" : "")
            + "\{Math.floor(Math.abs(Fmt.round-to(v, 2)))}." + Fmt.pad2(Math.mod(Math.round(Math.abs(v) * 100), 100));
    }

    public pure function format(fmt: ParamFormat, v: float) -> string {
        if (fmt == ParamFormat.percent) { return "\{Math.round(v)}%"; }
        if (fmt == ParamFormat.pitch) {
            return v == 0 ? I18n.t("common.autoValue") : "+\{Math.round(v)} st";
        }
        if (fmt == ParamFormat.seconds) {
            return v == 0 ? I18n.t("common.off") : InspectorFmt.fixed1(v) + " s";
        }
        if (fmt == ParamFormat.millis) {
            return v == 0 ? I18n.t("common.off") : "\{Math.round(v)} ms";
        }
        if (fmt == ParamFormat.hertz) {
            return v >= 1000 ? InspectorFmt.fixed1(v / 1000) + " kHz"
                : I18n.t1("controls.hertz", "\{Math.round(v)}");
        }
        if (fmt == ParamFormat.decibels) {
            return (v > 0 ? "+" : "") + InspectorFmt.fixed1(v) + " dB";
        }
        if (fmt == ParamFormat.ratio) { return InspectorFmt.fixed1(v) + " : 1"; }
        if (fmt == ParamFormat.rate-hz) { return InspectorFmt.fixed1(v) + " Hz"; }
        if (fmt == ParamFormat.steps) { return "\{Math.round(v)}"; }
        if (fmt == ParamFormat.rate) { return InspectorFmt.fixed2(v) + "x"; }
        if (fmt == ParamFormat.fraction) { return "\{Math.round(v * 100)}%"; }
        if (fmt == ParamFormat.centred) {
            // A hair either side of zero still reads as centred: the step is
            // 0.005, so an exact zero is easy to miss by one press.
            return Math.abs(v) < 0.0025 ? I18n.t("controls.centred") : InspectorFmt.fixed1(v * 100) + "%";
        }
        if (fmt == ParamFormat.degrees) { return "\{Math.round(v)}°"; }
        if (fmt == ParamFormat.gain) {
            // The bottom of the fader is silence, not -60 dB: a fader that
            // cannot reach zero is a fader you cannot mute with.
            return v <= -60 ? I18n.t("controls.silent")
                : Math.abs(v) < 0.05 ? "0.0 dB"
                : (v > 0 ? "+" : "") + InspectorFmt.fixed1(v) + " dB";
        }
        if (fmt == ParamFormat.height) {
            return InspectorFmt.fixed1(v * 100) + "% of height";
        }
        if (fmt == ParamFormat.outline) {
            return v == 0 ? I18n.t("common.none") : InspectorFmt.fixed1(v * 100) + "%";
        }
        if (fmt == ParamFormat.seconds2) {
            return v == 0 ? I18n.t("common.none") : InspectorFmt.fixed2(v) + "s";
        }
        if (fmt == ParamFormat.plain) {
            return Math.abs(v - Math.round(v)) < 0.0005 ? "\{Math.round(v)}"
                : InspectorFmt.fixed2(v);
        }
        if (fmt == ParamFormat.kelvin) { return I18n.t1("controls.kelvin", "\{Math.round(v)}"); }
        if (fmt == ParamFormat.stops) {
            return (v > 0 ? "+" : "") + InspectorFmt.fixed2(v) + " EV";
        }
        return v == 0 ? I18n.t("common.none") : InspectorFmt.fixed1(v) + " s";
    }

    /// Linear gain to decibels. Zero maps to the bottom of the fader rather
    /// than to -infinity, so the control has a reachable floor.
    public pure function to-decibels(gain: float) -> float {
        return gain <= 0 ? -60 : Fmt.clamp(20 * Math.log(gain, 10), -60, 24);
    }

    /// And back. At the very bottom the fader means silence, so it snaps to
    /// exactly zero rather than leaving an inaudible-but-nonzero gain in the
    /// project.
    public pure function from-decibels(decibels: float) -> float {
        return decibels <= -60 ? 0 : Math.pow(10, decibels / 20);
    }

    /// Units for parameters that previously relied on a separate readout.
    public pure function unit-of(fmt: ParamFormat) -> string {
        if (fmt == ParamFormat.percent || fmt == ParamFormat.fraction || fmt == ParamFormat.centred
            || fmt == ParamFormat.height || fmt == ParamFormat.outline) { return "%"; }
        if (fmt == ParamFormat.gain || fmt == ParamFormat.decibels) { return "dB"; }
        if (fmt == ParamFormat.degrees) { return "°"; }
        if (fmt == ParamFormat.seconds || fmt == ParamFormat.seconds2 || fmt == ParamFormat.fade) { return "s"; }
        if (fmt == ParamFormat.millis) { return "ms"; }
        if (fmt == ParamFormat.hertz || fmt == ParamFormat.rate-hz) { return "Hz"; }
        if (fmt == ParamFormat.pitch) { return "st"; }
        if (fmt == ParamFormat.ratio) { return ":1"; }
        if (fmt == ParamFormat.rate) { return "x"; }
        if (fmt == ParamFormat.kelvin) { return "K"; }
        if (fmt == ParamFormat.stops) { return "EV"; }
        return "";
    }

    // What a NumberField should show for a given step.
    public pure function precision-of(step: float) -> int {
        return step < 0.01 ? 3 : step < 0.1 ? 2 : step < 1 ? 1 : 0;
    }
}

// Click the track to jump, drag its handle to adjust, double-click to reset.
export component Rail inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    /// restored on double-click
    in property <float> default-value: root.minimum;
    in property <bool> enabled: true;

    in property <brush> track-brush: Theme.well;
    in property <bool> color-track: false;

    callback changed(value: float);

    height: Theme.h;
    opacity: root.enabled ? 1.0 : 0.45;

    property <float> span: Math.max(root.maximum - root.minimum, 0.000001);
    /// Half the dragger, so it stays inside the track at both ends and the
    /// value under the pointer is the value under the dragger's middle.
    property <length> inset: 5.5px;
    property <length> usable: Math.max(1px, root.width - 2 * root.inset);
    property <float> percent: Fmt.clamp((root.value - root.minimum) / root.span, 0, 1);
    property <bool> live: (touch.has-hover || touch.pressed) && root.enabled;

    function settle(raw: float) {
        root.value = Fmt.clamp(
            root.minimum + Math.round((raw - root.minimum) / root.step) * root.step,
            root.minimum, root.maximum);
        root.changed(root.value);
    }

    function apply-at(at: length) {
        root.settle(root.minimum
            + Fmt.clamp((at - root.inset) / root.usable, 0, 1) * root.span);
    }

    // The track. Four pixels and a hairline: enough to read as a groove, not
    // enough to compete with the dragger for the eye.
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: root.color-track ? 6px : 4px;
        border-radius: 2px;
        border-width: 1px;
        border-color: Theme.line;
        background: root.track-brush;

        // Runs to the dragger's middle rather than to its near edge, so the
        // fill and the chip meet instead of leaving a gap that grows with
        // the dragger's width.
        if !root.color-track: Rectangle {
            x: 0;
            y: 0;
            width: root.inset + root.usable * root.percent;
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.accent;
        }
    }

    grip := Rectangle {
        x: root.inset + root.usable * root.percent - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 11px;
        // Grows under the pointer: the chip is small enough that the target
        // wants confirming, and the growth is the confirmation.
        height: touch.pressed ? 22px : (root.live ? 20px : 18px);
        border-radius: Theme.r-xs;
        border-width: 1px;
        border-color: Theme.grip-edge;
        background: touch.pressed ? Theme.grip-active : Theme.grip;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.grip-edge;

        animate height, background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: ew-resize;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                root.apply-at(self.mouse-x);
            }
        }
        moved => {
            root.apply-at(self.mouse-x);
        }
        double-clicked => {
            root.settle(root.default-value);
        }
    }
}

// One target of the cluster. Small, quiet, and greyed rather than hidden
// when there is nowhere to go.
component KeyButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <bool> filled;
    in property <bool> enabled: true;
    in property <color> tint: Theme.fg-dim;

    callback clicked();

    width: 17px;
    height: 17px;
    border-radius: Theme.r-xs;
    background: touch.has-hover && root.enabled ? Theme.field : Colors.transparent;
    opacity: root.enabled ? 1.0 : 0.35;

    Icon {
        glyph: root.glyph;
        size: 11px;
        filled: root.filled;
        tint: touch.has-hover && root.enabled ? Theme.fg : root.tint;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The keyframe cluster: step back, put one on or take it off, step forward.
//
// Three targets in the width of one, which is what makes it a cluster rather
// than three buttons - they are read as one control ("is this animated, and
// where am I in it") and only pressed as three. The chevrons move the
// playhead rather than the value: a key is set where the playhead is, so
// arriving at one is how you edit it.
export component KeyCluster inherits HorizontalLayout {
    in property <ClipField> field;
    /// A knob named rather than enumerated - an Adjust row - keys by this
    /// name instead of `field`, and is handed its state rather than looking
    /// it up. Empty for a field.
    in property <string> name;
    in property <ClipKeyData> state: Keyframes.row(root.field);
    in property <bool> compact: false;
    in property <bool> position: false;

    in property <bool> enabled: true;
    property <bool> live: root.enabled && Keyframes.available;

    function toggle() {
        if (root.position) { Keyframes.toggle-position(); }
        else if (root.name == "") { Keyframes.toggle(root.field); }
        else { Keyframes.toggle-param(root.name); }
    }
    function step(delta: int) {
        if (root.name == "") { Keyframes.step(root.field, delta); }
        else { Keyframes.step-param(root.name, delta); }
    }

    spacing: 1px;

    if !root.compact: KeyButton {
        glyph: Glyph.chevron-left;
        enabled: root.live && root.state.prev;
        clicked => { root.step(-1); }
    }

    diamond := KeyButton {
        glyph: Glyph.keyframe;
        // Filled on a key, outlined on a keyed property between keys, and
        // plain grey on one that is still a constant. Three states because
        // there are three answers, and the middle one - "animated, but not
        // here" - is the one a two-state diamond loses.
        filled: root.state.here;
        enabled: root.live;
        tint: root.state.here || root.state.keyed ? Theme.accent : Theme.fg-dim;
        clicked => { root.toggle(); }
    }

    if !root.compact: KeyButton {
        glyph: Glyph.chevron-right;
        enabled: root.live && root.state.next;
        clicked => { root.step(1); }
    }
}

// Shared numeric control: a leading axis, centred value, trailing unit and steppers.
export component ValueControl inherits HorizontalLayout {
    in-out property <float> value;
    in property <float> minimum: -1000000000;
    in property <float> maximum: 1000000000;
    in property <float> step: 1;
    in property <string> unit;
    in property <string> axis;
    in property <float> unit-scale: 1;
    in property <bool> enabled: true;
    callback changed(value: float);

    min-width: 72px;
    preferred-width: 101px;
    spacing: 1px;
    NumberField {
        horizontal-stretch: 1;
        value <=> root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        precision: InspectorFmt.precision-of(root.step);
        enabled: root.enabled;
        scrubbable: false;
        centered: true;
        unit-leading: false;
        prefix: root.axis;
        radius-right: 0px;
        unit: root.unit;
        format(v) => {
            return Fmt.round-to(v * root.unit-scale,
                InspectorFmt.precision-of(root.step * root.unit-scale));
        }
        parse(t) => { return t.is-float() ? t.to-float() / root.unit-scale : root.value; }
        changed(v) => { root.changed(v); }
    }
    Stepper {
        vertical: true;
        enabled: root.enabled;
        stepped(direction, shift, alt) => {
            root.value = Fmt.clamp(Fmt.round-to(
                root.value + direction * root.step * (shift ? 10 : alt ? 0.1 : 1),
                InspectorFmt.precision-of(root.step) + (alt ? 1 : 0)),
                root.minimum, root.maximum);
            root.changed(root.value);
        }
    }
}

// X and Y share one keyframe action and one edit/undo transaction.
export component PositionRow inherits VerticalLayout {
    in-out property <float> x-value;
    in-out property <float> y-value;
    callback changed(x: float, y: float);
    spacing: 4px;
    padding-left: Theme.pad;
    padding-right: Theme.pad;
    Text {
        text: I18n.t("common.position");
        color: Theme.fg-muted;
        font-size: Theme.fs;
        TouchArea {
            double-clicked => {
                root.x-value = 0;
                root.y-value = 0;
                root.changed(0, 0);
            }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        ValueControl {
            horizontal-stretch: 1;
            axis: "X";
            unit: "%";
            unit-scale: 100;
            minimum: -1;
            maximum: 1;
            step: 0.005;
            value <=> root.x-value;
            changed(v) => { root.changed(v, root.y-value); }
        }
        ValueControl {
            horizontal-stretch: 1;
            axis: "Y";
            unit: "%";
            unit-scale: 100;
            minimum: -1;
            maximum: 1;
            step: 0.005;
            value <=> root.y-value;
            changed(v) => { root.changed(root.x-value, v); }
        }
        VerticalLayout {
            width: 17px;
            horizontal-stretch: 0;
            alignment: center;
            KeyCluster {
                compact: true;
                position: true;
                state: {
                    field: ClipField.offset-x,
                    here: Keyframes.row(ClipField.offset-x).here && Keyframes.row(ClipField.offset-y).here,
                    keyed: Keyframes.row(ClipField.offset-x).keyed || Keyframes.row(ClipField.offset-y).keyed,
                    prev: false,
                    next: false,
                };
            }
        }
    }
}

// Each adjustment has a label, then a slider, an editable value with
// vertical step buttons, and a keyframe diamond where supported. The model's
// units and change callbacks remain shared by every way of setting it.
export component Param inherits VerticalLayout {
    in property <string> label;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <float> default-value: root.minimum;
    in property <ParamFormat> fmt;
    in property <bool> enabled: true;
    /// Parameters expose a slider by default; specialised rows may opt out.
    in property <bool> rail: true;
    /// The trailing unit inside the fixed-width numeric field.
    in property <string> unit;
    /// What the field shows per unit of value: 100 for a fraction worn as
    /// a percent. The value itself stays what the model holds.
    in property <float> unit-scale: 1;
    /// Show the keyframe cluster, and which field it keys. Opt-in rather
    /// than derived from `field`, because a Slint enum property with nothing
    /// assigned to it is its first variant and not "none" - every unkeyable
    /// row would otherwise claim to be keying scale.
    in property <bool> keyable: false;
    in property <ClipField> field;
    /// See KeyCluster: a row keyed by name is handed its key state.
    in property <string> key-name;
    in property <string> color-key: root.key-name;
    in property <ClipKeyData> key-state: Keyframes.row(root.field);

    property <string> display-unit: root.unit != "" ? root.unit : InspectorFmt.unit-of(root.fmt);
    property <float> display-scale: root.unit != "" ? root.unit-scale
        : root.fmt == ParamFormat.fraction || root.fmt == ParamFormat.centred
            || root.fmt == ParamFormat.height || root.fmt == ParamFormat.outline ? 100 : root.unit-scale;

    callback changed(value: float);

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    spacing: 4px;

    HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.fg-muted;
            font-size: Theme.fs;
            vertical-alignment: center;
            TouchArea {
                enabled: root.enabled;
                double-clicked => {
                    root.value = root.default-value;
                    root.changed(root.default-value);
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }

    }

    HorizontalLayout {
        spacing: 6px;
        if root.rail: Rail {
            horizontal-stretch: 1;
            min-width: 48px;
            color-track: root.color-key == "temperature" || root.color-key == "tint" || root.color-key == "saturation";
            track-brush: root.color-key == "temperature" ? @linear-gradient(90deg, #f4d66c 0%, #478bff 100%)
                : root.color-key == "tint" ? @linear-gradient(90deg, #55c978 0%, #d566d2 100%)
                : root.color-key == "saturation" ? @linear-gradient(90deg, #808080 0%, #ea705e 100%)
                : Theme.well;
            value <=> root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            default-value: root.default-value;
            enabled: root.enabled;
            changed(v) => { root.changed(v); }
        }
        if !root.rail: Rectangle { horizontal-stretch: 1; }
        ValueControl {
            width: 101px;
            horizontal-stretch: 0;
            value <=> root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            unit: root.display-unit;
            unit-scale: root.display-scale;
            enabled: root.enabled;
            changed(v) => { root.changed(v); }
        }
        // Reserve the diamond's column even for unkeyable parameters, so
        // every rail ends at the same place and keeps its own numeric scale.
        if !root.keyable: Rectangle { width: 17px; height: Theme.h; }
        if root.keyable: VerticalLayout {
            width: 17px;
            horizontal-stretch: 0;
            alignment: center;
            KeyCluster {
                compact: true;
                enabled: root.enabled;
                field: root.field;
                name: root.key-name;
                state: root.key-state;
            }
        }

    }
}

// A label over a run of rows inside one section - Color, Lightness,
// Effects on the Adjust tab. Lighter than a SectionHeader, since it groups
// knobs rather than opening a drawer: muted text and a hairline under it.
export component Subhead inherits VerticalLayout {
    in property <string> title;

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    padding-top: 6px;
    spacing: 6px;

    Text {
        text: root.title;
        color: Theme.fg-muted;
        font-size: Theme.fs;
        font-weight: Theme.weight-title;
    }
    Rectangle {
        height: 1px;
        background: Theme.line;
    }
}

// A square tick box, for a block that is on or off among siblings that
// exclude it - the three ways of removing a background. A Switch says a
// setting is on; a box among boxes says which one. The box never sets
// itself: it asks, and shows whatever the owner then binds, so a tick
// that the owner refuses does not stick.
export component Check inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;

    callback toggled(checked: bool);

    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: root.checked ? Theme.accent : Theme.field-active;
    opacity: root.enabled ? 1.0 : 0.45;

    animate background { duration: 120ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    if root.checked: Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: Glyph.check;
        size: 11px;
        tint: Theme.on-accent;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;

    callback toggled(checked: bool);

    width: 30px;
    height: 17px;
    // Softly squared, not a pill: the thumb's corners sit concentric with
    // the track's, 2px in.
    border-radius: Theme.r-sm;
    background: root.checked ? Theme.accent : Theme.field-active;
    opacity: root.enabled ? 1.0 : 0.45;

    animate background { duration: 120ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    thumb := Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        border-radius: Theme.r-xs;
        background: Theme.on-accent;

        animate x { duration: 120ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// A labelled switch on one line. `@children` is the help disclosure slot.
export component SwitchRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;

    callback toggled(checked: bool);

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    spacing: 6px;
    min-height: Theme.h;

    Text {
        text: root.label;
        color: Theme.fg-muted;
        font-size: Theme.fs;
        vertical-alignment: center;
    }

    @children

    Rectangle { horizontal-stretch: 1; }

    VerticalLayout {
        alignment: center;
        Switch {
            checked <=> root.checked;
            toggled(on) => { root.toggled(on); }
        }
    }
}

// A "?" that explains on hover. The prose is a popover beside the mark, so
// it never rearranges the panel it sits in, and it goes when the pointer
// does. The mark has no height of its own: it fills whatever row it is
// given and sits in the middle of it, which is what keeps it level with a
// title or a switch rather than floating at the top of the row.
export component HelpButton inherits Rectangle {
    /// The sentence or two the popover shows.
    in property <string> text;

    width: 16px;

    mark := Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: touch.has-hover ? Theme.accent-soft : Theme.field;

        animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: "?";
            color: touch.has-hover ? Theme.accent : Theme.fg-muted;
            font-size: Theme.fs-xs;
            font-weight: Theme.weight-title;
        }

        touch := TouchArea {
            mouse-cursor: help;
        }

        Tooltip {
            Rectangle {
                width: 260px;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.line-strong;
                border-radius: Theme.r;

                HorizontalLayout {
                    padding: 10px;
                    Text {
                        text: root.text;
                        color: Theme.fg;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// Put a section back the way it was found.
//
// Sits in a SectionHeader's action slot beside the help disclosure, and is
// dimmed rather than hidden when there is nothing to undo: a control that
// appears only once you have made a mess is one you cannot learn is there.
export component ResetButton inherits Rectangle {
    /// Something in the section is off its default. False greys it.
    in property <bool> dirty: true;

    callback reset();

    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: touch.has-hover && root.dirty ? Theme.field-hover : Theme.field;
    opacity: root.dirty ? 1.0 : 0.4;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    Icon {
        glyph: Glyph.reset;
        size: 10px;
        tint: touch.has-hover && root.dirty ? Theme.fg : Theme.fg-muted;
    }

    touch := TouchArea {
        enabled: root.dirty;
        mouse-cursor: pointer;
        clicked => { root.reset(); }
    }
}

export component Note inherits HorizontalLayout {
    in property <string> text;

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    padding-top: 2px;
    padding-bottom: 4px;

    Text {
        text: root.text;
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;

    callback edited(text: string);

    // A caller's `focus()` lands in the field, so a list that opens on a
    // search can be typed into at once.
    forward-focus: input;
    height: Theme.h;
    border-radius: Theme.r-sm;
    background: Theme.field;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            Icon {
                glyph: Glyph.search;
                size: 12px;
                tint: Theme.fg-dim;
            }
        }

        Rectangle {
            clip: true;

            input := TextInput {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: self.preferred-height;
                color: Theme.fg;
                font-size: Theme.fs;
                single-line: true;
                text <=> root.text;
                edited => { root.edited(self.text); }
            }

            if root.text == "" && !input.has-focus: Text {
                x: 0;
                y: (parent.height - self.height) / 2;
                text: root.placeholder;
                color: Theme.fg-dim;
                font-size: Theme.fs;
            }
        }

        if root.text != "": VerticalLayout {
            alignment: center;
            clear := Rectangle {
                width: 18px;
                height: 18px;
                border-radius: Theme.r-xs;
                background: clear-touch.has-hover ? Theme.field-hover : Colors.transparent;

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    glyph: Glyph.close;
                    size: 10px;
                    tint: Theme.fg-muted;
                }

                clear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.text = "";
                        root.edited("");
                    }
                }
            }
        }
    }
}

// A colour on a labelled row.
//
// The swatch opens the picker - the square, the strips, the hex, the
// channels and the shelf, see primitives/color-picker.slint. The hex is
// shown beside the swatch too, so the row can be read without opening it.
export component ColourField inherits HorizontalLayout {
    in property <string> label;
    in property <color> value;
    /// The colour carries an alpha of its own; see ColorPicker.
    in property <bool> alpha: false;

    callback changed(value: color);

    /// The digits being typed, held apart from `value` for the reason
    /// the dialog's Field holds its draft: a TextInput writes to whatever
    /// it is bound to, and a republish mid-edit must not yank the caret.
    property <string> draft;
    function seed() {
        root.draft = Fmt.hex-digits(root.value);
    }
    /// What was typed, taken as a colour - "fff" and "cbf53f" alike, and
    /// the value kept when it is neither - with the alpha it already had:
    /// the field is six digits, and an opacity has a dial of its own.
    function adopt() {
        root.changed(Fmt.color-of("#" + root.draft, root.value)
            .with-alpha(root.value.to-hsv().alpha));
        root.seed();
    }

    init => { root.seed(); }
    changed value => {
        if (!input.has-focus) {
            root.seed();
        }
    }

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    spacing: 8px;
    min-height: Theme.h;

    Text {
        text: root.label;
        color: Theme.fg-muted;
        font-size: Theme.fs;
        vertical-alignment: center;
    }

    Rectangle { horizontal-stretch: 1; }

    // The hex, typed as well as read. The hash sits in a quiet segment on
    // the left - the number field's unit well, mirrored - because every
    // value starts with it and nobody should have to type it; the six
    // digits are the field.
    VerticalLayout {
        alignment: center;

        field := Rectangle {
            width: 86px;
            height: 24px;
            border-radius: Theme.r-sm;
            clip: true;
            background: input.has-focus ? Theme.field-hover
                : hover.has-hover ? Theme.field-hover
                : Theme.field;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Colors.transparent;

            animate background, border-color { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

            HorizontalLayout {
                Rectangle {
                    width: 20px;
                    background: Theme.well;

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.line;
                    }
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "#";
                        color: Theme.fg-dim;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;

                    hover := TouchArea {
                        mouse-cursor: MouseCursor.text;
                        clicked => { input.focus(); }
                    }

                    input := TextInput {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 16px;
                        height: self.preferred-height;
                        text <=> root.draft;
                        color: Theme.fg;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs;
                        single-line: true;
                        selection-background-color: Theme.accent;
                        selection-foreground-color: Theme.on-accent;

                        accepted => { root.adopt(); }
                        changed has-focus => {
                            if (!self.has-focus) {
                                root.adopt();
                            }
                        }
                    }
                }
            }
        }
    }

    // The swatch: a square the height of the field, and the button that
    // opens the picker.
    VerticalLayout {
        alignment: center;

        swatch := Rectangle {
            width: 24px;
            height: 24px;
            border-radius: Theme.r-sm;
            clip: true;
            border-width: 1px;
            border-color: touch.has-hover ? Theme.line-strong : Theme.line;

            // A checker under a colour that can be see-through, so a faint
            // stroke looks faint rather than like the panel.
            if root.alpha: Rectangle {
                for cell in 9: Rectangle {
                    x: Math.floor(cell / 3) * 8px;
                    y: Math.mod(cell, 3) * 8px;
                    width: 8px;
                    height: 8px;
                    background: Math.mod(cell + Math.floor(cell / 3), 2) == 0 ? #c8c8c8 : #7a7a7a;
                }
            }
            if !root.alpha: Rectangle { background: Theme.fg-dim; }
            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                border-radius: Theme.r-sm - 1px;
                background: root.value;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }

            popup := PopupWindow {
                x: swatch.width - 236px;
                y: swatch.height + 4px;
                width: 236px;
                close-policy: close-on-click-outside;

                Rectangle {
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.line-strong;
                    border-radius: Theme.r;

                    ColorPicker {
                        value: root.value;
                        alpha: root.alpha;
                        changed(next) => { root.changed(next); }
                    }
                }
            }
        }
    }
}
