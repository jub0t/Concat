import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button } from "../primitives/modal.slint";
import { IconButton, Row, Section, SectionBody, SectionHeader } from "../primitives/panel.slint";
import { FocusRing } from "../primitives/focus-ring.slint";
import { Select } from "../primitives/select.slint";
import { Param, ParamFormat, SwitchRow } from "controls.slint";
import { MaskChipData, MaskInspectorData } from "../timeline/model.slint";

component MaskChip inherits Rectangle {
    in property <MaskChipData> data;
    in property <bool> selected;
    callback picked();

    height: 29px;
    min-width: label.preferred-width + 22px;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.line;
    background: root.selected ? Theme.accent-soft : (touch.has-hover ? Theme.field-hover : Theme.field);

    label := Text {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        text: root.data.label;
        color: root.selected ? Theme.fg : Theme.fg-muted;
        font-size: Theme.fs;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

component ShapeTile inherits Rectangle {
    in property <int> shape;
    in property <string> label;
    in property <Glyph> glyph;
    in property <bool> selected;
    callback picked();
    property <bool> ring;

    height: 68px;
    min-width: 0px;
    horizontal-stretch: 1;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: root.selected ? Theme.accent
        : touch.has-hover ? Theme.line-strong
        : Theme.line;
    background: root.selected ? Theme.accent-soft
        : touch.pressed ? Theme.field-active
        : touch.has-hover ? Theme.field-hover
        : Theme.field;

    animate background, border-color {
        duration: 100ms;
        easing: cubic-bezier(0.4, 0, 0.2, 1);
    }

    fs := FocusScope {
        focus-gained(reason) => {
            root.ring = reason == FocusReason.tab-navigation;
        }
        focus-lost(reason) => { root.ring = false; }
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.picked();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 7px;
        padding-left: 6px;
        padding-right: 6px;
        spacing: 3px;
        alignment: center;
        Icon {
            glyph: root.glyph;
            size: 24px;
            tint: root.selected ? Theme.accent : Theme.fg-muted;
            weight: 1.6;
        }
        Text {
            min-width: 0px;
            horizontal-stretch: 1;
            text: root.label;
            color: root.selected ? Theme.accent : Theme.fg-muted;
            font-size: Theme.fs-sm;
            font-weight: root.selected ? Theme.weight-title : Theme.weight-body;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            fs.focus();
            root.picked();
        }
    }

    FocusRing { active: root.ring; radius: Theme.r; }
}

component MaskTextField inherits Rectangle {
    in-out property <string> value;
    callback accepted(value: string);

    height: 29px;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    background: Theme.well;
    input := TextInput {
        x: 9px;
        y: 0;
        width: parent.width - 18px;
        height: parent.height;
        text <=> root.value;
        color: Theme.fg;
        font-size: Theme.fs;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.accepted(self.text); }
        changed has-focus => {
            if (!self.has-focus) { root.accepted(self.text); }
        }
    }
}

export component MaskPanel inherits VerticalLayout {
    in property <[MaskChipData]> masks;
    in property <MaskInspectorData> mask;

    callback add(shape: int);
    callback shape(shape: int);
    callback select(id: string);
    callback remove();
    callback enabled(on: bool);
    callback inverted(on: bool);
    callback linked(on: bool);
    callback set(field: int, value: float);
    callback commit();
    callback keyframe-toggle(field: int, on: bool);
    callback text(value: string);
    callback drawing(on: bool);
    callback clear-points();
    callback reset();
    callback track-direction(index: int);
    callback track();

    property <float> px;
    property <float> py;
    property <float> turn;
    property <float> mw;
    property <float> mh;
    property <float> feather;
    property <float> roundness;
    property <float> brush-size;
    property <string> mask-text;

    function seed() {
        root.px = root.mask.position-x;
        root.py = root.mask.position-y;
        root.turn = root.mask.rotation;
        root.mw = root.mask.width;
        root.mh = root.mask.height;
        root.feather = root.mask.feather;
        root.roundness = root.mask.roundness;
        root.brush-size = root.mask.brush-size;
        root.mask-text = root.mask.text;
    }
    changed mask => { root.seed(); }
    init => { root.seed(); }

    Section {
        first: true;
        SectionHeader { title: I18n.t("Mask"); }
        SectionBody {
            SwitchRow {
                label: I18n.t("Enable mask");
                checked: root.mask.enabled;
                toggled(on) => { root.enabled(on); }
            }

            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: 6px;
                for chip in root.masks: MaskChip {
                    data: chip;
                    selected: chip.id == root.mask.id;
                    picked => { root.select(chip.id); }
                }
                IconButton {
                    glyph: Glyph.plus;
                    label: I18n.t("Add mask");
                    clicked => { root.add(3); }
                }
            }

            VerticalLayout {
                width: parent.width;
                horizontal-stretch: 1;
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: Theme.gap;
                HorizontalLayout {
                    width: parent.width - 2 * Theme.pad;
                    horizontal-stretch: 1;
                    spacing: Theme.gap;
                    ShapeTile { min-width: (parent.width - 2 * Theme.gap) / 3; max-width: self.min-width; shape: 0; label: I18n.t("Split"); glyph: Glyph.panel-horizontal; selected: root.mask.shape == 0; picked => { root.shape(0); } }
                    ShapeTile { min-width: (parent.width - 2 * Theme.gap) / 3; max-width: self.min-width; shape: 1; label: I18n.t("Filmstrip"); glyph: Glyph.filmstrip; selected: root.mask.shape == 1; picked => { root.shape(1); } }
                    ShapeTile { min-width: (parent.width - 2 * Theme.gap) / 3; max-width: self.min-width; shape: 2; label: I18n.t("Circle"); glyph: Glyph.circle; selected: root.mask.shape == 2; picked => { root.shape(2); } }
                }
                HorizontalLayout {
                    width: parent.width - 2 * Theme.pad;
                    horizontal-stretch: 1;
                    spacing: Theme.gap;
                    ShapeTile { min-width: (parent.width - 2 * Theme.gap) / 3; max-width: self.min-width; shape: 3; label: I18n.t("Rectangle"); glyph: Glyph.square; selected: root.mask.shape == 3; picked => { root.shape(3); } }
                    ShapeTile { min-width: (parent.width - 2 * Theme.gap) / 3; max-width: self.min-width; shape: 4; label: I18n.t("Star"); glyph: Glyph.star; selected: root.mask.shape == 4; picked => { root.shape(4); } }
                    ShapeTile { min-width: (parent.width - 2 * Theme.gap) / 3; max-width: self.min-width; shape: 5; label: I18n.t("Heart"); glyph: Glyph.heart; selected: root.mask.shape == 5; picked => { root.shape(5); } }
                }
                HorizontalLayout {
                    width: parent.width - 2 * Theme.pad;
                    horizontal-stretch: 1;
                    spacing: Theme.gap;
                    ShapeTile { min-width: (parent.width - 2 * Theme.gap) / 3; max-width: self.min-width; shape: 6; label: I18n.t("Text"); glyph: Glyph.text-mark; selected: root.mask.shape == 6; picked => { root.shape(6); } }
                    ShapeTile { min-width: (parent.width - 2 * Theme.gap) / 3; max-width: self.min-width; shape: 7; label: I18n.t("Brush"); glyph: Glyph.mask-brush; selected: root.mask.shape == 7; picked => { root.shape(7); } }
                    ShapeTile { min-width: (parent.width - 2 * Theme.gap) / 3; max-width: self.min-width; shape: 8; label: I18n.t("Pen"); glyph: Glyph.pen; selected: root.mask.shape == 8; picked => { root.shape(8); } }
                }
            }
        }
    }

    if root.mask.present: Section {
        header := SectionHeader {
            title: I18n.t("Mask settings");
            collapsible: true;
            HorizontalLayout {
                spacing: 2px;
                IconButton { glyph: root.mask.inverted ? Glyph.eye-off : Glyph.eye; label: I18n.t("Invert mask"); checked: root.mask.inverted; clicked => { root.inverted(!root.mask.inverted); } }
                IconButton { glyph: Glyph.rotate-ccw; label: I18n.t("Reset mask"); clicked => { root.reset(); } }
                IconButton { glyph: Glyph.trash; label: I18n.t("Remove mask"); danger: true; clicked => { root.remove(); } }
            }
        }
        if header.open: SectionBody {
            if root.mask.shape == 6: Row {
                label: I18n.t("Text");
                MaskTextField { horizontal-stretch: 1; value <=> root.mask-text; accepted(value) => { root.text(value); } }
            }
            Param { label: I18n.t("Position X"); value <=> root.px; minimum: -2; maximum: 2; step: 0.01; default-value: 0; fmt: ParamFormat.centred; custom-keyframe: true; keyframed: root.mask.position-x-keyframed; changed(v) => { root.set(0, v); root.commit(); } keyframe-toggled(on) => { root.keyframe-toggle(0, on); } }
            Param { label: I18n.t("Position Y"); value <=> root.py; minimum: -2; maximum: 2; step: 0.01; default-value: 0; fmt: ParamFormat.centred; custom-keyframe: true; keyframed: root.mask.position-y-keyframed; changed(v) => { root.set(1, v); root.commit(); } keyframe-toggled(on) => { root.keyframe-toggle(1, on); } }
            Param { label: I18n.t("Rotation"); value <=> root.turn; minimum: -180; maximum: 180; step: 1; default-value: 0; fmt: ParamFormat.degrees; custom-keyframe: true; keyframed: root.mask.rotation-keyframed; changed(v) => { root.set(2, v); root.commit(); } keyframe-toggled(on) => { root.keyframe-toggle(2, on); } }
            SwitchRow { label: I18n.t("Link width and height"); checked: root.mask.linked; toggled(on) => { root.linked(on); } }
            Param { label: I18n.t("Width"); value <=> root.mw; minimum: 0.01; maximum: 2; step: 0.01; default-value: 0.6; fmt: ParamFormat.fraction; custom-keyframe: true; keyframed: root.mask.width-keyframed; changed(v) => { root.set(3, v); if (root.mask.linked) { root.mh = v; root.set(4, v); } root.commit(); } keyframe-toggled(on) => { root.keyframe-toggle(3, on); } }
            Param { label: I18n.t("Height"); value <=> root.mh; minimum: 0.01; maximum: 2; step: 0.01; default-value: 0.6; fmt: ParamFormat.fraction; custom-keyframe: true; keyframed: root.mask.height-keyframed; changed(v) => { root.set(4, v); if (root.mask.linked) { root.mw = v; root.set(3, v); } root.commit(); } keyframe-toggled(on) => { root.keyframe-toggle(4, on); } }
            Param { label: I18n.t("Feather"); value <=> root.feather; minimum: 0; maximum: 0.5; step: 0.005; default-value: 0; fmt: ParamFormat.fraction; custom-keyframe: true; keyframed: root.mask.feather-keyframed; changed(v) => { root.set(5, v); root.commit(); } keyframe-toggled(on) => { root.keyframe-toggle(5, on); } }
            if root.mask.shape == 1 || root.mask.shape == 3: Param { label: I18n.t("Round corners"); value <=> root.roundness; minimum: 0; maximum: 1; step: 0.01; default-value: 0; fmt: ParamFormat.fraction; custom-keyframe: true; keyframed: root.mask.roundness-keyframed; changed(v) => { root.set(6, v); root.commit(); } keyframe-toggled(on) => { root.keyframe-toggle(6, on); } }
            if root.mask.shape == 7: Param { label: I18n.t("Brush size"); value <=> root.brush-size; minimum: 0.005; maximum: 0.5; step: 0.005; default-value: 0.08; fmt: ParamFormat.fraction; changed(v) => { root.set(7, v); root.commit(); } }
            if root.mask.shape == 7 || root.mask.shape == 8: SwitchRow { label: I18n.t("Draw on the monitor"); checked: root.mask.drawing; toggled(on) => { root.drawing(on); } }
            if root.mask.shape == 7 || root.mask.shape == 8: Row {
                label: root.mask.points == 1 ? I18n.t("1 point") : I18n.t1("{0} points", "\{root.mask.points}");
                Button { label: I18n.t("Clear"); ghost: true; enabled: root.mask.points > 0; clicked => { root.clear-points(); } }
            }
        }
    }

    if root.mask.present: Section {
        tracking := SectionHeader { title: I18n.t("Track mask"); collapsible: true; }
        if tracking.open: SectionBody {
            Row {
                label: I18n.t("Direction");
                Select { options: [I18n.t("Both"), I18n.t("Forward"), I18n.t("Backward")]; current: root.mask.track-direction; changed(index) => { root.track-direction(index); } }
            }
            if root.mask.tracking: Row {
                label: I18n.t("Tracking");
                Text { text: "\{Math.round(root.mask.track-progress * 100)}%"; color: Theme.fg-muted; font-size: Theme.fs; }
            }
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                Rectangle { horizontal-stretch: 1; }
                Button { label: root.mask.tracking ? I18n.t("Tracking…") : I18n.t("Track"); primary: true; enabled: !root.mask.tracking; clicked => { root.track(); } }
            }
        }
    }
}
