{
  "about": "Three tones: one whose clip is muted, one on a track that is muted, and one left alone, overlapping in time. Only the third is heard, at its full level, and the other two not at all. A failure means a muted clip or a muted track is still mixed into the export, or muting one silences another.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "tone", "tag": 1, "seconds": 2 },
    "b": { "kind": "tone", "tag": 3, "seconds": 2 },
    "c": { "kind": "tone", "tag": 5, "seconds": 2 }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "media.import", "path": "$project", "file": "$file.c", "as": "c" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 }, "as": "clipA" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 0.5 }, "as": "clipB", "bind": { "trackB": "/project/timelines/0/clips/1/trackId" } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$c", "start": 1 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "updateClip", "clipId": "$clipA", "patch": { "muted": true } } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "setTrackFlag", "trackId": "$trackB", "flag": "muted", "value": true } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 90,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 89] }
    ],
    "level": [
      { "at": 0.25, "media": "a", "gain": 0 },
      { "at": 1.5, "media": "a", "gain": 0 },
      { "at": 1.5, "media": "b", "gain": 0 },
      { "at": 2.25, "media": "b", "gain": 0 },
      { "at": 1.5, "media": "c", "gain": 1 },
      { "at": 2.75, "media": "c", "gain": 1 },
      { "at": 0.5, "media": "c", "gain": 0 }
    ]
  }
}
