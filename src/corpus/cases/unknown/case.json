{
  "about": "Clips A and B end to end, saved; then written into the saved file: a clip of a kind no build has, an effect entry that is not one, and a field on a clip that this build does not know. The project opens, edits, saves and reopens with all three still in its document, and exports A then B. A failure means a file from a newer build loses what this one cannot read: the promise that a build never deletes what it does not understand.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 }, "as": "clipA" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 2 } },
    { "step": "spliceDocument", "append": [{ "at": "/timelines/0/clips", "value": { "id": "c900", "kind": "hologram", "trackId": "T1", "start": 10, "duration": 1, "shimmer": [1, 2, 3] } }, { "at": "/timelines/0/clips/0/videoEffects", "value": { "mystery": true, "depth": { "a": 1 } } }], "merge": [{ "at": "/timelines/0/clips/1", "value": { "fromTheFuture": { "keep": "me" } } }] },
    { "method": "edit.apply", "path": "$project", "command": { "op": "updateClip", "clipId": "$clipA", "patch": { "opacity": 1 } } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 120,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 },
      { "frames": [60, 119], "media": "b", "from": 0, "step": 1 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "a", "from": 0 },
      { "frames": [60, 119], "media": "b", "from": 0 }
    ]
  }
}
