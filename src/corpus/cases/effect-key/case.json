{
  "about": "A clip with the Exposure effect, its stops keyed from none at the clip's start to two down at its end, in a straight line. Each frame shows the light that many stops down leaves: all of it at the start, a quarter at the end, halving every thirty frames. A failure means an effect's key is read at the wrong place in the clip, is eased where a straight line was asked for, or the effect ignores its keys.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60 }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 }, "as": "clip" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "updateClip", "clipId": "$clip", "patch": { "videoEffects": [{ "id": "concat.exposure", "params": { "stops": 0 }, "enabled": true }] } } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "setEffectKey", "clipId": "$clip", "entry": 0, "key": "stops", "at": 0, "value": 0, "ease": [0, 0, 1, 1] } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "setEffectKey", "clipId": "$clip", "entry": 0, "key": "stops", "at": 1, "value": -2, "ease": [0, 0, 1, 1] } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 60,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1, "stops": [0, -1.9667] }
    ]
  }
}
