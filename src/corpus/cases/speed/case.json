{
  "about": "Three two-second clips end to end, A at 2x, B at half speed and C at 1.5x. A's 60 frames last 30 output frames and show every second source frame; B's last 120 and show each source frame twice; C's last 40 and show source frame floor(k * 1.5). A failure means a speed change samples the wrong source frame: a frame early or late, doubled or skipped by rounding, or a clip whose length does not follow its speed. Each clip has its own sound, whose pips must land where its speed puts them, at their own pitch: a sound that keeps the old speed, drifts from its picture or goes silent fails.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "c": { "kind": "clock", "tag": 3, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "media.import", "path": "$project", "file": "$file.c", "as": "c" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 }, "as": "clipA" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "setClipSpeed", "clipId": "$clipA", "speed": 2 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 1 }, "as": "clipB" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "setClipSpeed", "clipId": "$clipB", "speed": 0.5 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$c", "start": 5 }, "as": "clipC" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "setClipSpeed", "clipId": "$clipC", "speed": 1.5 } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 190,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 29], "media": "a", "from": 0, "step": 2 },
      { "frames": [30, 149], "media": "b", "from": 0, "step": 1, "per": 2 },
      { "frames": [150, 189], "media": "c", "from": 0, "step": 3, "per": 2 }
    ],
    "sound": [
      { "frames": [0, 29], "media": "a", "from": 0, "speed": 2 },
      { "frames": [30, 149], "media": "b", "from": 0, "speed": 0.5 },
      { "frames": [150, 189], "media": "c", "from": 0, "speed": 1.5 }
    ]
  }
}
