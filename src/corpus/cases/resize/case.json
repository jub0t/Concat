{
  "about": "Clips A and B end to end on a 320 × 180 timeline at 30 fps, exported at twice the size and half the rate: 640 × 360 at 15 fps. The file has 60 frames, each showing the timeline frame at its own instant, every other one, with its code drawn at twice the size; the sound is as it would be at any size. A failure means an export at another size or rate scales or places the picture wrongly, picks frames a tick early or late, changes the length, or moves the sound.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "export": { "width": 640, "height": 360, "rateNum": 15, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 2 } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 120,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "file": { "frames": 60, "width": 640, "height": 360, "rate": [15, 1] },
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 },
      { "frames": [60, 119], "media": "b", "from": 0, "step": 1 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "a", "from": 0 },
      { "frames": [60, 119], "media": "b", "from": 0 }
    ]
  }
}
