{
  "about": "Clips A and B, two seconds each, end to end on one track, with A split at 1.5 s. Frames 44 and 45 either side of the split must be A's 44 and 45, and frames 59 and 60 either side of the clip boundary A's 59 and B's 0. The same edit without the split must preview identically. A failure means an off-by-one at a cut, a black, held or skipped frame, or a split that changes the picture.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60 },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60 }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 }, "as": "clipA" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 2 } },
    { "step": "closeAndReopen" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "splitClips", "clipIds": ["$clipA"], "time": 1.5 }, "as": "tail" }
  ],
  "expect": {
    "frames": 120,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 },
      { "frames": [60, 119], "media": "b", "from": 0, "step": 1 }
    ]
  },
  "twins": [
    { "name": "unsplit", "skip": ["tail"], "frames": [0, 30, 44, 45, 46, 59, 60, 119] }
  ]
}
