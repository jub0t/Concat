{
  "about": "Clip A fills the frame and clip B, on a track above it and turned grey by the Mono effect so it can be told from A, is cut to a feathered circle in the middle by a mask. A's frames show around it, and frames 0 and 45 of the monitor are held to stored pictures of the circle and its soft edge. A failure means a mask's shape, size, place or feather changed, or it draws differently on this graphics adapter.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60 },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60 }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addTrack" }, "as": "top" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClip", "mediaId": "$b", "trackId": "$top", "start": 0, "ripple": false }, "as": "clipB" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "updateClip", "clipId": "$clipB", "patch": { "videoEffects": [{ "id": "concat.mono", "params": {}, "enabled": true }], "masks": [{ "id": "mask-1", "name": "Circle", "mode": "add", "source": { "kind": "shape", "shape": "circle", "width": 0.3, "height": 0.3 }, "x": 0, "y": 0, "rotation": 0, "scale": 1, "feather": 0.2, "expand": 0, "opacity": 1 }] } } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 60,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 }
    ],
    "golden": [
      { "name": "frame-00", "frame": 0 },
      { "name": "frame-45", "frame": 45 }
    ]
  }
}
