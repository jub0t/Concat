{
  "about": "Clip A on the project's first timeline; a second timeline is added, which becomes the open one, and clip B put on it; the second is renamed and moved ahead of the first. The export is the open timeline's, B alone, and the project keeps both timelines, their names and their order through a save. A failure means a new timeline is not the open one, an edit lands on the wrong timeline, the export takes the wrong one, or a rename or a move is lost.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addTimeline" }, "as": "second" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "renameTimeline", "timelineId": "$second", "name": "Cutdown" } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "moveTimeline", "timelineId": "$second", "index": 0 } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 60,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "b", "from": 0, "step": 1 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "b", "from": 0 }
    ]
  }
}
