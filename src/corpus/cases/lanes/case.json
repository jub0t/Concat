{
  "about": "Clip A on the first track and, from half a second in, clip B on a track added above it. B covers A wherever both are, so frames 0 to 14 are A's and 15 to 74 are B's 0 to 59, while the sound is both at once: A's pips at 0 and 1 s, B's at 0.5 and 1.5 s. A failure means the track order is drawn upside down, the upper clip starts a frame early or late, or a covered clip's sound is dropped with its picture.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addTrack" }, "as": "top" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClip", "mediaId": "$b", "trackId": "$top", "start": 0.5, "ripple": false } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 75,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 14], "media": "a", "from": 0, "step": 1 },
      { "frames": [15, 74], "media": "b", "from": 0, "step": 1 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "a", "from": 0 },
      { "frames": [15, 74], "media": "b", "from": 0 }
    ]
  }
}
