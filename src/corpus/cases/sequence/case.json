{
  "about": "Three clips laid down in one step, in the order C, A, B, from the start of the timeline. Each plays in full where the one before it ends, and their pips follow. A failure means clips added in a sequence overlap, leave gaps, or land in another order than asked.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "c": { "kind": "clock", "tag": 3, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "media.import", "path": "$project", "file": "$file.c", "as": "c" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipsInSequence", "mediaIds": ["$c", "$a", "$b"], "start": 0, "ripple": false } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 180,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "c", "from": 0, "step": 1 },
      { "frames": [60, 119], "media": "a", "from": 0, "step": 1 },
      { "frames": [120, 179], "media": "b", "from": 0, "step": 1 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "c", "from": 0 },
      { "frames": [60, 119], "media": "a", "from": 0 },
      { "frames": [120, 179], "media": "b", "from": 0 }
    ]
  }
}
