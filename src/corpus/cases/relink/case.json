{
  "about": "Clips A and B end to end; then B's bin entry is pointed at another file, C's. Where B's clip was, C's frames and C's pips play, from C's own start. A failure means a relinked file is not read, the old one is still shown or heard, or the clip's place or length changes.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "c": { "kind": "clock", "tag": 3, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 2 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "updateMediaPath", "mediaId": "$b", "newPath": "$file.c" } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 120,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 },
      { "frames": [60, 119], "media": "c", "from": 0, "step": 1 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "a", "from": 0 },
      { "frames": [60, 119], "media": "c", "from": 0 }
    ]
  }
}
