{
  "about": "A two-second clip split at 0.7 s and at 1.3 s and the three pieces merged back into one. It plays frame for frame as it did, previews exactly as the same edit with no split and no merge, and its timeline is that edit's again, entry for entry. A failure means a merge of pieces cut from one clip drops, repeats or shifts frames at the joins, or does not come back to the clip it was.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60 }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 }, "as": "one" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "splitClips", "clipIds": ["$one"], "time": 0.7 }, "as": "two" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "splitClips", "clipIds": ["$two"], "time": 1.3 }, "as": "three" },
    { "step": "closeAndReopen" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "mergeClips", "clipIds": ["$one", "$two", "$three"] }, "as": "merged" }
  ],
  "expect": {
    "frames": 60,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 }
    ]
  },
  "twins": [
    { "name": "uncut", "skip": ["two", "three", "merged"], "frames": [0, 20, 21, 22, 38, 39, 40, 59], "same": true }
  ]
}
