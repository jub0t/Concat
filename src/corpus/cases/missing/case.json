{
  "about": "Clips A and B end to end. The project is saved and closed, B's file is taken away, and the project opened, saved and closed again; then the file is put back and it is opened once more. Through all of it the document is the same, clip and bin entry both, and the export at the end is A then B, every frame and pip. A failure means a project opened without one of its files loses the clip or its settings, saves that loss, or does not find the file again when it returns.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 2 } },
    { "step": "removeFile", "media": "b" },
    { "step": "closeAndReopen" },
    { "step": "restoreFile", "media": "b" }
  ],
  "expect": {
    "frames": 120,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 },
      { "frames": [60, 119], "media": "b", "from": 0, "step": 1 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "a", "from": 0 },
      { "frames": [60, 119], "media": "b", "from": 0 }
    ]
  }
}
