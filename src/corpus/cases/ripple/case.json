{
  "about": "Clips A, B and C end to end; B is removed with ripple, so C closes up to A; the removal is undone and done again, and the project saved and reopened. The export is A then C, 120 frames, with C's first frame at frame 60 and its pips two seconds earlier than they were. A failure means a ripple leaves a gap or moves the wrong clips, an undo and redo do not come back to the same edit, or the sound does not move with its picture.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "c": { "kind": "clock", "tag": 3, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "media.import", "path": "$project", "file": "$file.c", "as": "c" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 2 }, "as": "clipB" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$c", "start": 4 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "removeClips", "clipIds": ["$clipB"], "ripple": true } },
    { "method": "edit.undo", "path": "$project" },
    { "method": "edit.redo", "path": "$project" },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 120,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 },
      { "frames": [60, 119], "media": "c", "from": 0, "step": 1 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "a", "from": 0 },
      { "frames": [60, 119], "media": "c", "from": 0 }
    ]
  }
}
