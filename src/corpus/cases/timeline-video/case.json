{
  "about": "A clip on a 320 × 180 timeline whose frame is then set to 640 × 360. The export is 640 × 360 and the clip fills it, its code drawn at twice the size, frame for frame. A failure means changing a timeline's frame leaves the export at the old size, or leaves the picture at its old size in a corner.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a", "bind": { "timeline": "/project/timelines/0/id" } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "setTimelineVideo", "timelineId": "$timeline", "video": { "width": 640, "height": 360, "rateNum": 30, "rateDen": 1 } } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 60,
    "width": 640,
    "height": 360,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1, "block": 32 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "a", "from": 0 }
    ]
  }
}
