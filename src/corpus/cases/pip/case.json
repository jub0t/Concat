{
  "about": "Clip A fills the frame; clip B, on a track above it and starting half a second later, is scaled to half and moved a quarter of the frame right and down, so it sits exactly in the bottom right quarter. Every frame shows A's own frame at full size and B's own frame at half size, its code read off blocks of eight pixels at (160, 90), and both clips' pips are heard, B's half a second after A's. A failure means scale or offset place a picture somewhere else or at another size, the order of scale and offset changed, or the picture under an inset is not drawn.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 75, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addTrack" }, "as": "top" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClip", "mediaId": "$b", "trackId": "$top", "start": 0.5, "ripple": false }, "as": "clipB" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "setClipTransform", "clipId": "$clipB", "scale": 0.5, "offsetX": 0.25, "offsetY": 0.25 } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 75,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 74], "media": "a", "from": 0, "step": 1 }
    ],
    "inset": [
      { "frames": [15, 74], "media": "b", "from": 0, "step": 1, "at": [160, 90], "block": 8 }
    ],
    "sound": [
      { "frames": [0, 74], "media": "a", "from": 0 },
      { "frames": [15, 74], "media": "b", "from": 0 }
    ]
  }
}
