{
  "about": "Clip A at the start and clip B from 3 s, with a second of nothing between them. Frames 60 to 89 are black and silent, and B starts on its own first frame at frame 90. A failure means a gap holds the last picture, shows the next one early, is not black, carries sound, or is closed up by the export.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 3 } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 150,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 },
      { "frames": [60, 89] },
      { "frames": [90, 149], "media": "b", "from": 0, "step": 1 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "a", "from": 0 },
      { "frames": [90, 149], "media": "b", "from": 0 }
    ]
  }
}
