{
  "about": "A 30 fps clip on a 60 fps timeline. Each of its frames is shown twice, the file has 120 frames at 60 fps, and its pips are on its seconds. A failure means a timeline faster than its source skips or triples a frame, or runs the clip at the wrong length.",
  "video": { "width": 320, "height": 180, "rateNum": 60, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 120,
    "width": 320,
    "height": 180,
    "rate": [60, 1],
    "runs": [
      { "frames": [0, 119], "media": "a", "from": 0, "step": 1, "per": 2 }
    ],
    "sound": [
      { "frames": [0, 119], "media": "a", "from": 0 }
    ]
  }
}
