{
  "about": "Clip A on the first timeline and clip B on a second; then the first is chosen again. The export is the first timeline's, A alone. A failure means choosing a timeline does not change which one is exported, or is lost by a save.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a", "bind": { "first": "/project/view/showing" } },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addTimeline" } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "selectTimeline", "timelineId": "$first" } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 60,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "a", "from": 0 }
    ]
  }
}
