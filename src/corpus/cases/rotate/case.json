{
  "about": "Clip A fills the frame; clip B on a track above it is scaled to two fifths, turned thirty degrees and set a little below the middle. A's frames read under it, and frames 0 and 45 of the monitor are held to stored pictures of the turned clip and its edges. A failure means rotation turns the wrong way or about the wrong point, changes the picture's size, or its edges are drawn differently.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60 },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60 }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addTrack" }, "as": "top" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClip", "mediaId": "$b", "trackId": "$top", "start": 0, "ripple": false }, "as": "clipB" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "setClipTransform", "clipId": "$clipB", "scale": 0.4, "rotation": 30, "offsetY": 0.15 } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 60,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 }
    ],
    "golden": [
      { "name": "frame-00", "frame": 0 },
      { "name": "frame-45", "frame": 45 }
    ]
  }
}
