{
  "about": "Clips A, B and C end to end; then B's file is taken out of the bin, and its clip goes with it. A plays, the two seconds where B was are black and silent, and C is where it was. A failure means a file removed from the bin leaves a dead clip behind, takes another file's clip, or closes the gap it leaves.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true },
    "c": { "kind": "clock", "tag": 3, "width": 320, "height": 180, "rate": [30, 1], "frames": 60, "sound": true }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "media.import", "path": "$project", "file": "$file.c", "as": "c" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$b", "start": 2 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$c", "start": 4 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "removeMedia", "mediaId": "$b" } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 180,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 },
      { "frames": [60, 119] },
      { "frames": [120, 179], "media": "c", "from": 0, "step": 1 }
    ],
    "sound": [
      { "frames": [0, 59], "media": "a", "from": 0 },
      { "frames": [120, 179], "media": "c", "from": 0 }
    ]
  }
}
