{
  "about": "Clip A fills the frame; clip B, scaled to half in the bottom right quarter, has the Vignette effect at full strength. A's frames read beside it, and frames 0 and 45 of the monitor are held to stored pictures of B's darkened corners. A failure means the effect's shape, strength or falloff changed, or it draws differently on this graphics adapter.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60 },
    "b": { "kind": "clock", "tag": 2, "width": 320, "height": 180, "rate": [30, 1], "frames": 60 }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "media.import", "path": "$project", "file": "$file.b", "as": "b" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addTrack" }, "as": "top" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClip", "mediaId": "$b", "trackId": "$top", "start": 0, "ripple": false }, "as": "clipB" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "setClipTransform", "clipId": "$clipB", "scale": 0.5, "offsetX": 0.25, "offsetY": 0.25 } },
    { "method": "edit.apply", "path": "$project", "command": { "op": "updateClip", "clipId": "$clipB", "patch": { "videoEffects": [{ "id": "concat.vignette", "params": { "strength": 100 }, "enabled": true }] } } },
    { "step": "closeAndReopen" }
  ],
  "expect": {
    "frames": 60,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 59], "media": "a", "from": 0, "step": 1 }
    ],
    "golden": [
      { "name": "frame-00", "frame": 0 },
      { "name": "frame-45", "frame": 45 }
    ]
  }
}
