{
  "about": "A two-second clip at twice its speed, one second long, split half way. Either side of the split the frames are the ones the unsplit clip shows, every second source frame, and the same edit without the split previews identically. A failure means a split of a sped-up clip starts its second half from the wrong source frame, or changes the speed of either half.",
  "video": { "width": 320, "height": 180, "rateNum": 30, "rateDen": 1 },
  "media": {
    "a": { "kind": "clock", "tag": 1, "width": 320, "height": 180, "rate": [30, 1], "frames": 60 }
  },
  "steps": [
    { "method": "media.import", "path": "$project", "file": "$file.a", "as": "a" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "addClipAtFirstFree", "mediaId": "$a", "start": 0 }, "as": "clipA" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "setClipSpeed", "clipId": "$clipA", "speed": 2, "ripple": false } },
    { "step": "closeAndReopen" },
    { "method": "edit.apply", "path": "$project", "command": { "op": "splitClips", "clipIds": ["$clipA"], "time": 0.5 }, "as": "tail" }
  ],
  "expect": {
    "frames": 30,
    "width": 320,
    "height": 180,
    "rate": [30, 1],
    "runs": [
      { "frames": [0, 29], "media": "a", "from": 0, "step": 2 }
    ]
  },
  "twins": [
    { "name": "unsplit", "skip": ["tail"], "frames": [0, 7, 14, 15, 16, 29] }
  ]
}
