import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { IconButton, Row, Section, SectionBody, SectionHeader } from "../primitives/panel.slint";
import { Button } from "../primitives/modal.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";
import {
    Fader, HelpButton, InspectorFmt, Note, Param, ParamFormat,
    Rail, ResetButton, SearchField, Switch, SwitchRow,
} from "controls.slint";
import { ClipField, ClipKind, Keyframes, SelectedClipData } from "../timeline/model.slint";

// The editor's clip inspector: one panel, three tabs. Adjust is direct
// controls; Filters and Effects differ only in their catalogue, so both are
// PresetStack with different data.

/// One parameter a preset exposes. `value` doubles as the default in the
/// catalogue: applying a preset copies the row, and double-click restores
/// `default-value`.
/// One package on a library shelf. Published by Rust from the effect
/// catalogue; the id is what Rust is handed back when the row is clicked, and
/// ids are stable forever because project files store them.
export struct CatalogueEntryData {
    id: string,
    name: string,
    /// Starred, so it shows under the star chip whatever shelf it is on.
    favourite: bool,
    /// The shelf's label, and its index into the kind's group list.
    category: string,
    group: int,
    description: string,
}

/// What one effect library is currently showing.
export struct LibraryViewData {
    /// The words in its search box.
    query: string,
    /// Which shelf is selected, as an index into the kind's group list.
    group: int,
    /// The star is down: only favourites show, whatever shelf they are on.
    favourites: bool,
}

/// The three effect libraries' view state and the verbs that change it.
///
/// A global for the same reason `Keyframes` is one: the state belongs to
/// Rust - which does the searching, shelving and starring before the model
/// is published - and threading nine properties and four callbacks down
/// through the workspace to reach three sibling panels would be a lot of
/// plumbing for a fact that has one owner.
export global Library {
    /// One view per shelf, indexed by the numbers `PresetStack.shelf` uses:
    /// 0 filters, 1 effects, 2 audio.
    in property <[LibraryViewData]> views;

    /// The search box was typed in.
    callback query-changed(shelf: int, text: string);
    /// A shelf was picked from the strip.
    callback group-changed(shelf: int, index: int);
    /// The star chip was pressed.
    callback favourites-changed(shelf: int, on: bool);
    /// A package was starred or unstarred. Not per shelf: a star is a fact
    /// about the package, and it is remembered across sessions.
    callback favourite(id: string, on: bool);

    pure public function view(shelf: int) -> LibraryViewData {
        if (Library.views.length < 3) {
            return { query: "", group: 0, favourites: false };
        }
        return Library.views[shelf];
    }
}

/// One link of the selected clip's chain, in chain order.
export struct AppliedEntryData {
    id: string,
    name: string,
    /// False bypasses the link without losing what was dialled into it.
    on: bool,
    /// False when no package answers to the id: the row still shows, so the
    /// link can be removed, but it has no knobs and renders nothing.
    known: bool,
}

/// One knob of one link. Flat rather than nested in the entry so a value
/// changing under a drag rewrites one small row and not the whole link.
export struct AppliedParamData {
    /// Which link, as an index into the applied list.
    entry: int,
    /// The manifest's key; what Rust is handed back with the new value.
    key: string,
    label: string,
    min: float,
    max: float,
    step: float,
    default-value: float,
    value: float,
    fmt: ParamFormat,
}

/// The favourites chip: a star that filters the shelf down to what is on it.
component StarChip inherits Rectangle {
    in property <bool> on;

    callback clicked();

    width: 30px;
    height: Theme.h;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.line;
    background: root.on ? Theme.accent-soft
        : touch.has-hover ? Theme.field-hover
        : Theme.field;

    animate background, border-color { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    Icon {
        glyph: Glyph.sparkle;
        size: 12px;
        filled: root.on;
        tint: root.on ? Theme.accent : Theme.fg-muted;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A chain and its library: the links applied to the selected clip, each
/// with a control per parameter its package declares, and under it the
/// shelves of packages that can be added. One component serves effects,
/// filters and audio alike — the data says which.
export component PresetStack inherits VerticalLayout {
    /// lower-case singular, for labels and placeholders
    in property <string> noun: I18n.t("effect");
    in property <string> library-title: I18n.t("Effect library");
    in property <[string]> group-labels;
    in property <[CatalogueEntryData]> catalogue;
    /// Owned by Rust: a chain is edited by index, and Slint models cannot be
    /// spliced from the language.
    in property <[AppliedEntryData]> applied;
    in property <[AppliedParamData]> params;

    /// Which of the three libraries this is: 0 filters, 1 effects, 2 audio.
    /// The index its view state and its callbacks are keyed by.
    in property <int> shelf;

    /// Which shelf is showing, which words are in the search box, and
    /// whether the star is down. Owned by Rust, because the list below is:
    /// the catalogue arrives already narrowed by all three, and a control
    /// showing one thing while the list shows another is the bug that
    /// arrangement is there to make impossible.
    property <LibraryViewData> view: Library.view(root.shelf);
    property <int> group: root.view.group;
    property <string> query: root.view.query;
    property <bool> favourites-only: root.view.favourites;

    callback add(id: string);
    callback toggle(index: int);
    callback move-by(index: int, delta: int);
    callback remove(index: int);
    /// One knob moved. The value lands on the echo; `commit` makes it real.
    callback set-param(index: int, key: string, value: float);
    callback commit();

    property <bool> help;

    // The grid. Three columns at the inspector's width, which puts a tile at
    // about 70px - wide enough for "Voice Focus" on two lines and narrow
    // enough that a shelf of twenty is four rows rather than seven.
    property <int> columns: 3;
    property <length> pad: Theme.pad;
    property <length> cell-gap: 6px;
    property <length> cell-w: (root.width - 2 * root.pad
        - (root.columns - 1) * root.cell-gap) / root.columns;
    property <length> cell-h: 44px;
    property <int> rows: ceil(root.catalogue.length / root.columns);

    // The field owns its own text once it has been typed in - a TextInput
    // assigns to `text`, and an assignment replaces the binding declared on
    // it - so the box has to be put back by hand when Rust clears the query,
    // which picking a shelf and pressing the star both do.
    changed query => { search.text = root.query; }

    function in-chain(id: string) -> bool {
        // A real member test wants a model lookup Slint cannot express, so
        // this scans the first eight links, which is deeper than a chain
        // gets before it stops being a chain and starts being a problem.
        return root.applied.length > 0 && (root.applied[0].id == id
            || (root.applied.length > 1 && root.applied[1].id == id)
            || (root.applied.length > 2 && root.applied[2].id == id)
            || (root.applied.length > 3 && root.applied[3].id == id)
            || (root.applied.length > 4 && root.applied[4].id == id)
            || (root.applied.length > 5 && root.applied[5].id == id)
            || (root.applied.length > 6 && root.applied[6].id == id)
            || (root.applied.length > 7 && root.applied[7].id == id));
    }

    // No empty shell: the section arrives with the first link, so an
    // untouched clip shows only its library.
    if root.applied.length > 0: Section {
        first: true;

        SectionHeader {
            title: I18n.t("Applied");
            HelpButton {
                open: root.help;
                toggled => { root.help = self.open; }
            }
        }

        if root.help: Note {
            text: I18n.t("The chain runs top to bottom — reorder it with the chevrons. The eye bypasses one link without losing the values you dialled into it.");
        }

        VerticalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-bottom: 6px;
            spacing: 6px;

            for item[index] in root.applied: Rectangle {
                border-radius: Theme.r;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.line;
                opacity: item.on ? 1.0 : 0.55;

                VerticalLayout {
                    padding-bottom: 8px;
                    spacing: 4px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        padding-top: 6px;
                        spacing: 2px;

                        Text {
                            horizontal-stretch: 1;
                            text: item.name;
                            color: item.known ? Theme.fg : Theme.fg-dim;
                            font-size: Theme.fs;
                            font-weight: Theme.weight-title;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if !item.known: Text {
                            text: I18n.t("not installed");
                            color: Theme.fg-dim;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                        }

                        IconButton {
                            glyph: Glyph.eye;
                            label: item.on ? I18n.t1("Bypass {0}", "\{item.name}") : I18n.t1("Enable {0}", "\{item.name}");
                            checked: item.on;
                            clicked => { root.toggle(index); }
                        }
                        IconButton {
                            glyph: Glyph.chevron-up;
                            label: I18n.t1("Move {0} up", "\{item.name}");
                            enabled: index > 0;
                            clicked => { root.move-by(index, -1); }
                        }
                        IconButton {
                            glyph: Glyph.chevron-down;
                            label: I18n.t1("Move {0} down", "\{item.name}");
                            enabled: index < root.applied.length - 1;
                            clicked => { root.move-by(index, 1); }
                        }
                        IconButton {
                            glyph: Glyph.close;
                            label: I18n.t1("Remove {0}", "\{item.name}");
                            clicked => { root.remove(index); }
                        }
                    }

                    // One control per parameter the package declares. The
                    // knob writes to its own `value`, which drops a binding,
                    // so the row re-seeds it whenever Rust republishes the
                    // parameter — a new clip, an undo — and the control
                    // never shows a number that is not the document's.
                    for p in root.params: Rectangle {
                        property <AppliedParamData> data: p;
                        visible: p.entry == index;
                        height: p.entry == index ? knob.preferred-height : 0;
                        changed data => { knob.value = self.data.value; }

                        knob := Param {
                            label: p.label;
                            value: p.value;
                            minimum: p.min;
                            maximum: p.max;
                            step: p.step;
                            default-value: p.default-value;
                            fmt: p.fmt;
                            enabled: item.on;
                            changed(v) => {
                                root.set-param(index, p.key, v);
                                root.commit();
                            }
                        }
                    }
                }
            }
        }
    }

    Section {
        first: root.applied.length == 0;

        SectionHeader { title: root.library-title; }

        Row {
            search := SearchField {
                text: root.query;
                placeholder: I18n.t1("Search {0}s", "\{root.noun}");
                edited(text) => { Library.query-changed(root.shelf, text); }
            }
        }

        // Air between the field and the strip under it: two rows butted
        // together read as one control, and they are not.
        Rectangle { height: 8px; }

        // The star and the shelves. Favourites is not one more shelf: it
        // cuts across all of them, so it is a chip beside the strip rather
        // than a segment inside it, and it takes the strip's place when it
        // is on because a shelf inside a starred set is a filter of a filter
        // nobody asked for.
        Row {
            StarChip {
                on: root.favourites-only;
                clicked => { Library.favourites-changed(root.shelf, !root.favourites-only); }
            }

            if !root.favourites-only: SegmentedControl {
                options: root.group-labels;
                current: root.group;
                changed(index) => { Library.group-changed(root.shelf, index); }
            }

            if root.favourites-only: Text {
                vertical-alignment: center;
                text: I18n.t("Favourites");
                color: Theme.fg-muted;
                font-size: Theme.fs;
            }
        }

        Rectangle { height: 6px; }

        // The shelf itself, as tiles rather than rows.
        //
        // Rust hands this list over already searched, shelved and starred,
        // which is the whole reason a grid is possible: a cell's place is
        // its index, and an index only means a place when every entry in the
        // model is one that shows. Filtering in Slint - the `visible: false`
        // trick a vertical list can get away with - would leave holes in the
        // grid where the hidden ones were.
        Rectangle {
            height: root.rows * (root.cell-h + root.cell-gap);

            for entry[index] in root.catalogue: tile := Rectangle {
                property <bool> in-chain: root.in-chain(entry.id);

                x: root.pad + mod(index, root.columns) * (root.cell-w + root.cell-gap);
                y: floor(index / root.columns) * (root.cell-h + root.cell-gap);
                width: root.cell-w;
                height: root.cell-h;
                border-radius: Theme.r-sm;
                border-width: 1px;
                border-color: tile.in-chain ? Theme.accent
                    : tile-touch.has-hover ? Theme.line-strong
                    : Theme.line;
                background: tile.in-chain ? Theme.accent-soft
                    : tile-touch.has-hover ? Theme.field-hover
                    : Theme.field;

                animate background, border-color {
                    duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1);
                }

                // The name, centred and given the whole cell: at this size a
                // glyph would be a guess about what an effect looks like, and
                // the word is the thing being chosen.
                Text {
                    x: 4px;
                    width: parent.width - 8px;
                    height: parent.height;
                    text: entry.name;
                    color: tile.in-chain ? Theme.accent : Theme.fg;
                    font-size: Theme.fs-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }

                // The star rides the tile's corner and takes its own clicks,
                // so starring is never a step on the way to applying.
                star := Rectangle {
                    x: parent.width - self.width - 2px;
                    y: 2px;
                    width: 15px;
                    height: 15px;
                    border-radius: Theme.r-xs;
                    visible: entry.favourite || tile-touch.has-hover || star-touch.has-hover;
                    background: star-touch.has-hover ? Theme.field-active : Colors.transparent;

                    Icon {
                        glyph: Glyph.sparkle;
                        size: 10px;
                        filled: entry.favourite;
                        tint: entry.favourite ? Theme.accent : Theme.fg-dim;
                    }

                    star-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Library.favourite(entry.id, !entry.favourite); }
                    }
                }

                tile-touch := TouchArea {
                    // Below the star in the tree, so the star's own area wins
                    // the clicks that land on it.
                    enabled: !tile.in-chain;
                    mouse-cursor: pointer;
                    clicked => { root.add(entry.id); }
                }
            }
        }

        if root.catalogue.length == 0: HorizontalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-top: 2px;

            Text {
                text: root.favourites-only
                    ? I18n.t("Nothing starred yet — hover a tile and press its star.")
                    : I18n.t1("No {0} matches that.", "\{root.noun}");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }
    }
}

/// One treatment: a switch, its name, and one line saying what it does.
component Processor inherits VerticalLayout {
    in property <string> label;
    in property <string> note;
    in property <bool> on;

    callback toggled();

    padding-bottom: 6px;

    SwitchRow {
        label: root.label;
        checked: root.on;
        toggled(value) => { root.toggled(); }
    }

    // Under the switch and inside its padding, so the sentence reads as this
    // row's own rather than as a note about the section.
    HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: Theme.pad;

        Text {
            text: root.note;
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
    }
}

/// The three treatments a sound clip almost always wants, promoted out of
/// the effect library and onto the tab itself.
///
/// They are ordinary links of the audio chain - the same packages the
/// library lists, added and removed by the same callbacks - and nothing here
/// knows what they do. What they get is a switch instead of a search: a
/// person opening the Sound tab to fix a noisy lavalier should not have to
/// know that "Reduce noise" is filed under a shelf.
///
/// Their knobs stay in the chain's Applied section rather than being
/// duplicated here. One set of controls per link, in the order the link runs.
export component ProcessorRows inherits VerticalLayout {
    in property <[AppliedEntryData]> applied;

    callback add(id: string);
    callback remove(index: int);

    /// Where a package sits on the chain, or -1. The same eight-deep scan
    /// PresetStack does, and for the same reason: Slint has no lookup.
    pure function at(id: string) -> int {
        return root.applied.length > 0 && root.applied[0].id == id ? 0
            : root.applied.length > 1 && root.applied[1].id == id ? 1
            : root.applied.length > 2 && root.applied[2].id == id ? 2
            : root.applied.length > 3 && root.applied[3].id == id ? 3
            : root.applied.length > 4 && root.applied[4].id == id ? 4
            : root.applied.length > 5 && root.applied[5].id == id ? 5
            : root.applied.length > 6 && root.applied[6].id == id ? 6
            : root.applied.length > 7 && root.applied[7].id == id ? 7
            : -1;
    }

    function toggle(id: string) {
        if (root.at(id) >= 0) {
            root.remove(root.at(id));
        } else {
            root.add(id);
        }
    }

    Section {
        SectionHeader { title: I18n.t("Treatments"); }
        SectionBody {
            Processor {
                label: I18n.t("Normalize loudness");
                note: I18n.t("Brings the clip to a broadcast level without riding the fader.");
                on: root.at("concat.loudness") >= 0;
                toggled => { root.toggle("concat.loudness"); }
            }
            Processor {
                label: I18n.t("Reduce noise");
                note: I18n.t("Takes the room's hiss and hum out from under the voice.");
                on: root.at("concat.denoise") >= 0;
                toggled => { root.toggle("concat.denoise"); }
            }
            Processor {
                label: I18n.t("Enhance voice");
                note: I18n.t("Lifts speech out of the mix: a little presence, a little control.");
                on: root.at("concat.enhance-voice") >= 0;
                toggled => { root.toggle("concat.enhance-voice"); }
            }
        }
    }
}

// The clip's own tabs, one panel each. The tab strip follows the kind (see
// config-pane): a still has picture but no sound, so it gets Video and not
// Audio or Speed; a sound clip is the reverse. Every panel here is a set of
// fields on the selected clip; the chains have their own stacks.
//
// Local editing state is assigned rather than bound. A control writes to its
// own `value` as it is dragged, and an assignment in Slint replaces whatever
// binding the parent declared on that property — so binding these straight
// to `selected` would work exactly once and then go deaf to the model. They
// are seeded instead, on init and whenever the selection changes under us.

/// Video: how the picture sits in the frame, how solid it is, and whether
/// its background is keyed out.
export component VideoPanel inherits VerticalLayout {
    in property <SelectedClipData> selected;
    /// The picture's chain and its knobs, for the cutout section: keying is
    /// a package on the chain like any effect, and this panel only gives
    /// it a switch and a name.
    in property <[AppliedEntryData]> applied;
    in property <[AppliedParamData]> params;
    /// The custom cutout's brush; see Editor.
    in property <int> brush-tool;
    in property <float> brush-size;
    in property <bool> painting;

    callback set(field: ClipField, value: float);
    /// A control gesture finished: the accumulated change becomes one command.
    callback commit();
    callback chain-add(id: string);
    callback chain-remove(index: int);
    callback chain-set-param(index: int, key: string, value: float);
    /// The cutout: its mode (0 off, 1 automatic, 2 custom), and the brush.
    callback cutout-mode(mode: int);
    callback cutout-tool(index: int);
    callback cutout-size(size: float);
    callback cutout-painting(on: bool);
    callback cutout-clear();

    /// Which keyer is on the chain, and where: -1 for none. Scans the first
    /// eight links, as PresetStack does, for want of a model lookup.
    pure function keyer-at(id: string) -> int {
        return root.applied.length > 0 && root.applied[0].id == id ? 0
            : root.applied.length > 1 && root.applied[1].id == id ? 1
            : root.applied.length > 2 && root.applied[2].id == id ? 2
            : root.applied.length > 3 && root.applied[3].id == id ? 3
            : root.applied.length > 4 && root.applied[4].id == id ? 4
            : root.applied.length > 5 && root.applied[5].id == id ? 5
            : root.applied.length > 6 && root.applied[6].id == id ? 6
            : root.applied.length > 7 && root.applied[7].id == id ? 7
            : -1;
    }
    property <int> green: root.keyer-at("concat.green-screen");
    property <int> blue: root.keyer-at("concat.blue-screen");
    /// 0 off, 1 green, 2 blue: which chroma package is on.
    property <int> keyer: root.green >= 0 ? 1 : root.blue >= 0 ? 2 : 0;
    property <int> keyer-index: root.green >= 0 ? root.green : root.blue;
    /// The Mode row: 0 off, 1 automatic, 2 custom, 3 green screen, 4 blue
    /// screen. A keyer on the chain wins, since a cutout under a key would
    /// be two removals at once.
    property <int> removal: root.keyer == 1 ? 3 : root.keyer == 2 ? 4 : root.selected.cutout;
    property <bool> masked: root.removal == 1 || root.removal == 2;

    property <float> scale;
    property <float> offset-x;
    property <float> offset-y;
    property <float> rotation;
    property <float> stretch-x;
    property <float> stretch-y;
    property <float> alpha;
    property <float> crop-left;
    property <float> crop-top;
    property <float> crop-right;
    property <float> crop-bottom;
    property <float> feather;

    function seed() {
        root.feather = root.selected.cutout-feather;
        root.scale = root.selected.scale;
        root.offset-x = root.selected.offset-x;
        root.offset-y = root.selected.offset-y;
        root.rotation = root.selected.rotation;
        root.stretch-x = root.selected.stretch-x;
        root.stretch-y = root.selected.stretch-y;
        root.alpha = root.selected.opacity;
        root.crop-left = root.selected.crop-left;
        root.crop-top = root.selected.crop-top;
        root.crop-right = root.selected.crop-right;
        root.crop-bottom = root.selected.crop-bottom;
    }

    property <[string]> blends: [I18n.t("Normal"), I18n.t("Multiply"), I18n.t("Screen"), I18n.t("Add"), I18n.t("Lighten"), I18n.t("Darken")];

    init => { root.seed(); }
    changed selected => { root.seed(); }

    property <bool> transform-help;
    property <bool> cutout-help;

    Section {
        first: true;
        transform := SectionHeader {
            title: I18n.t("Transform");
            collapsible: true;
            summary: "\{Math.round(root.scale * 100)}% · \{Math.round(root.rotation)}°";
            HelpButton {
                open: root.transform-help;
                toggled => { root.transform-help = self.open; }
            }
        }

        if transform.open: SectionBody {

        if root.transform-help: Note {
            text: I18n.t("Scale and position are fractions of the output frame, so a clip keeps its framing if the project is re-sized. The same numbers move with the box on the monitor. Width and height pull one axis beyond the scale; the edge grips on the monitor do the same.");
        }

        Param {
            slider: false;
            label: I18n.t("Scale");
            keyable: true;
            field: ClipField.scale;
            value <=> root.scale;
            minimum: 0.05;
            maximum: 8;
            step: 0.01;
            default-value: 1;
            fmt: ParamFormat.fraction;
            changed(v) => { root.set(ClipField.scale, v); root.commit(); }
        }
        Param {
            slider: false;
            label: I18n.t("Position X");
            keyable: true;
            field: ClipField.offset-x;
            value <=> root.offset-x;
            minimum: -1;
            maximum: 1;
            step: 0.005;
            default-value: 0;
            fmt: ParamFormat.centred;
            changed(v) => { root.set(ClipField.offset-x, v); root.commit(); }
        }
        Param {
            slider: false;
            label: I18n.t("Position Y");
            keyable: true;
            field: ClipField.offset-y;
            value <=> root.offset-y;
            minimum: -1;
            maximum: 1;
            step: 0.005;
            default-value: 0;
            fmt: ParamFormat.centred;
            changed(v) => { root.set(ClipField.offset-y, v); root.commit(); }
        }
        Param {
            slider: false;
            label: I18n.t("Rotation");
            keyable: true;
            field: ClipField.rotation;
            value <=> root.rotation;
            minimum: -180;
            maximum: 180;
            step: 1;
            default-value: 0;
            fmt: ParamFormat.degrees;
            changed(v) => { root.set(ClipField.rotation, v); root.commit(); }
        }
        Param {
            slider: false;
            label: I18n.t("Width");
            value <=> root.stretch-x;
            minimum: 0.1;
            maximum: 4;
            step: 0.01;
            default-value: 1;
            fmt: ParamFormat.fraction;
            changed(v) => { root.set(ClipField.stretch-x, v); root.commit(); }
        }
        Param {
            slider: false;
            label: I18n.t("Height");
            value <=> root.stretch-y;
            minimum: 0.1;
            maximum: 4;
            step: 0.01;
            default-value: 1;
            fmt: ParamFormat.fraction;
            changed(v) => { root.set(ClipField.stretch-y, v); root.commit(); }
        }

        }
    }

    Section {
        blend := SectionHeader {
            title: I18n.t("Blend");
            collapsible: true;
            summary: "\{Math.round(root.alpha * 100)}% · "
                + root.blends[Math.max(0, Math.min(root.selected.blend, root.blends.length - 1))];
        }
        if blend.open: SectionBody {
        Param {
            label: I18n.t("Opacity");
            keyable: true;
            field: ClipField.opacity;
            value <=> root.alpha;
            minimum: 0;
            maximum: 1;
            step: 0.01;
            default-value: 1;
            fmt: ParamFormat.fraction;
            changed(v) => { root.set(ClipField.opacity, v); root.commit(); }
        }
        Row {
            label: I18n.t("Mode");
            Select {
                options: root.blends;
                current: root.selected.blend;
                changed(index) => { root.set(ClipField.blend, index); root.commit(); }
            }
        }
        SwitchRow {
            label: I18n.t("Flip horizontal");
            checked: root.selected.flip-h;
            toggled(on) => { root.set(ClipField.flip-h, on ? 1 : 0); root.commit(); }
        }
        SwitchRow {
            label: I18n.t("Flip vertical");
            checked: root.selected.flip-v;
            toggled(on) => { root.set(ClipField.flip-v, on ? 1 : 0); root.commit(); }
        }
        }
    }

    // The background taken away. Automatic and custom cut by the mask the
    // cutout model finds for the person in the picture - custom with
    // strokes painted on the monitor over it - and the two screens key a
    // colour out. A screen is the chroma package on the chain, which is why
    // its knobs read from the chain's own rows.
    Section {
        cutout := SectionHeader {
            title: I18n.t("Remove background");
            collapsible: true;
            summary: root.removal == 0 ? I18n.t("off")
                : root.removal == 1 ? I18n.t("Automatic")
                : root.removal == 2 ? I18n.t("Custom")
                : root.removal == 3 ? I18n.t("Green screen") : I18n.t("Blue screen");
            HelpButton {
                open: root.cutout-help;
                toggled => { root.cutout-help = self.open; }
            }
        }
        if cutout.open: SectionBody {

        if root.cutout-help: Note {
            text: I18n.t("Automatic keeps the person the cutout model finds and drops the rest. Custom starts from the same mask and takes corrections painted on the monitor: the smart brush and smart eraser follow the model's confidence, the plain ones do exactly what you paint. Green and blue screen key one colour out instead; similarity is how far from the colour still counts, softness feathers the edge.");
        }

        Row {
            label: I18n.t("Mode");
            Select {
                options: [I18n.t("Off"), I18n.t("Automatic"), I18n.t("Custom"), I18n.t("Green screen"), I18n.t("Blue screen")];
                current: root.removal;
                changed(index) => {
                    // One removal at a time: the keyer comes off the chain
                    // before anything else goes on, and the cutout is set
                    // or cleared to match.
                    if (root.keyer-index >= 0) {
                        root.chain-remove(root.keyer-index);
                    }
                    root.cutout-mode(index == 1 ? 1 : index == 2 ? 2 : 0);
                    if (index == 3) {
                        root.chain-add("concat.green-screen");
                    } else if (index == 4) {
                        root.chain-add("concat.blue-screen");
                    }
                    root.commit();
                }
            }
        }

        if root.masked: Param {
            label: I18n.t("Feather");
            value <=> root.feather;
            minimum: 0;
            maximum: 0.1;
            step: 0.002;
            default-value: 0.01;
            fmt: ParamFormat.percent;
            changed(v) => { root.set(ClipField.cutout-feather, v); root.commit(); }
        }

        // The analysis, while it runs: the masks are found in the
        // background and the picture is shown as shot until they are.
        if root.masked && root.selected.cutout-progress >= 0: Row {
            label: I18n.t("Analysis");
            Text {
                text: I18n.t1("Finding the subject… {0}%", "\{Math.round(root.selected.cutout-progress * 100)}");
                color: Theme.fg-muted;
                font-size: Theme.fs;
                vertical-alignment: center;
            }
        }

        if root.removal == 2: Row {
            label: I18n.t("Tool");
            Select {
                options: [I18n.t("Smart brush"), I18n.t("Brush"), I18n.t("Smart eraser"), I18n.t("Eraser")];
                current: root.brush-tool;
                changed(index) => { root.cutout-tool(index); }
            }
        }
        if root.removal == 2: Param {
            label: I18n.t("Brush size");
            value: root.brush-size;
            minimum: 0.005;
            maximum: 0.5;
            step: 0.005;
            default-value: 0.06;
            fmt: ParamFormat.percent;
            changed(v) => { root.cutout-size(v); }
        }
        if root.removal == 2: SwitchRow {
            label: I18n.t("Paint on the monitor");
            checked: root.painting;
            toggled(on) => { root.cutout-painting(on); }
        }
        if root.removal == 2: Row {
            label: root.selected.cutout-strokes == 1 ? "1 stroke"
                : "\{root.selected.cutout-strokes} strokes";
            Button {
                label: I18n.t("Clear strokes");
                ghost: true;
                enabled: root.selected.cutout-strokes > 0;
                clicked => { root.cutout-clear(); }
            }
        }

        // The keyer's own knobs, re-seeded from the chain the way the
        // stack's rows are; see PresetStack.
        for p in root.params: Rectangle {
            property <AppliedParamData> data: p;
            visible: root.keyer-index >= 0 && p.entry == root.keyer-index;
            height: root.keyer-index >= 0 && p.entry == root.keyer-index
                ? knob.preferred-height : 0;
            changed data => { knob.value = self.data.value; }

            knob := Param {
                label: p.label;
                value: p.value;
                minimum: p.min;
                maximum: p.max;
                step: p.step;
                default-value: p.default-value;
                fmt: p.fmt;
                changed(v) => {
                    root.chain-set-param(root.keyer-index, p.key, v);
                    root.commit();
                }
            }
        }

        }
    }

    // What is cut off the source before it is fitted. Fractions of the
    // source's own edges, so a crop survives a change of output size.
    Section {
        crop := SectionHeader {
            title: I18n.t("Crop");
            collapsible: true;
            summary: (root.crop-left == 0 && root.crop-top == 0
                && root.crop-right == 0 && root.crop-bottom == 0) ? I18n.t("none")
                : "\{Math.round(root.crop-left * 100)} · \{Math.round(root.crop-top * 100)} · \{Math.round(root.crop-right * 100)} · \{Math.round(root.crop-bottom * 100)}";
        }
        if crop.open: SectionBody {
        Param {
            slider: false;
            label: I18n.t("Left");
            value <=> root.crop-left;
            minimum: 0;
            maximum: 0.9;
            step: 0.005;
            default-value: 0;
            fmt: ParamFormat.fraction;
            changed(v) => { root.set(ClipField.crop-left, v); root.commit(); }
        }
        Param {
            slider: false;
            label: I18n.t("Top");
            value <=> root.crop-top;
            minimum: 0;
            maximum: 0.9;
            step: 0.005;
            default-value: 0;
            fmt: ParamFormat.fraction;
            changed(v) => { root.set(ClipField.crop-top, v); root.commit(); }
        }
        Param {
            slider: false;
            label: I18n.t("Right");
            value <=> root.crop-right;
            minimum: 0;
            maximum: 0.9;
            step: 0.005;
            default-value: 0;
            fmt: ParamFormat.fraction;
            changed(v) => { root.set(ClipField.crop-right, v); root.commit(); }
        }
        Param {
            slider: false;
            label: I18n.t("Bottom");
            value <=> root.crop-bottom;
            minimum: 0;
            maximum: 0.9;
            step: 0.005;
            default-value: 0;
            fmt: ParamFormat.fraction;
            changed(v) => { root.set(ClipField.crop-bottom, v); root.commit(); }
        }
        }
    }
}

/// Audio: the level and the fades. The voice and room chain sits under it
/// in the same tab; see config-pane.
///
/// The fader for level works in decibels, not linear gain. Linear puts every
/// useful setting in the bottom sixth of the travel; decibels is both how the
/// ear works and how anyone mixing thinks.
export component AudioPanel inherits VerticalLayout {
    in property <SelectedClipData> selected;

    callback set(field: ClipField, value: float);
    callback commit();

    /// A fade longer than half the clip would overlap the other one.
    property <float> fade-limit: Math.max(0.1, Math.min(10, root.selected.duration / 2));

    property <float> level;
    property <float> fade-in;
    property <float> fade-out;

    function seed() {
        root.level = InspectorFmt.to-decibels(root.selected.volume);
        root.fade-in = root.selected.fade-in;
        root.fade-out = root.selected.fade-out;
    }

    init => { root.seed(); }
    changed selected => { root.seed(); }

    Section {
        first: true;
        volume := SectionHeader {
            title: I18n.t("Volume");
            collapsible: true;
            summary: InspectorFmt.format(ParamFormat.gain, root.level);

            ResetButton {
                dirty: root.level != 0 || Keyframes.row(ClipField.volume).keyed;
                reset => {
                    Keyframes.clear(ClipField.volume);
                    root.set(ClipField.volume, 1);
                    root.commit();
                }
            }
        }
        if volume.open: SectionBody {
        Param {
            label: I18n.t("Level");
            keyable: true;
            field: ClipField.volume;
            rail: true;
            value <=> root.level;
            // The bottom is silence, not -60. +24 at the top because quiet
            // material genuinely needs it — a distant lavalier is routinely
            // 15-20 dB under, and a limit that cannot fix that is in the
            // wrong place.
            minimum: -60;
            maximum: 24;
            step: 0.5;
            default-value: 0;
            fmt: ParamFormat.gain;
            changed(v) => {
                root.set(ClipField.volume, InspectorFmt.from-decibels(v));
                root.commit();
            }
        }
        }
    }

    Section {
        fades := SectionHeader {
            title: I18n.t("Fades");
            collapsible: true;
            summary: (root.fade-in == 0 && root.fade-out == 0) ? I18n.t("none")
                : InspectorFmt.format(ParamFormat.seconds2, root.fade-in)
                    + " / " + InspectorFmt.format(ParamFormat.seconds2, root.fade-out);

            ResetButton {
                dirty: root.fade-in != 0 || root.fade-out != 0;
                reset => {
                    root.set(ClipField.fade-in, 0);
                    root.set(ClipField.fade-out, 0);
                    root.commit();
                }
            }
        }
        if fades.open: SectionBody {
        Param {
            label: I18n.t("Fade in");
            rail: true;
            value <=> root.fade-in;
            minimum: 0;
            maximum: root.fade-limit;
            step: 0.05;
            fmt: ParamFormat.seconds2;
            changed(v) => { root.set(ClipField.fade-in, v); root.commit(); }
        }
        Param {
            label: I18n.t("Fade out");
            rail: true;
            value <=> root.fade-out;
            minimum: 0;
            maximum: root.fade-limit;
            step: 0.05;
            fmt: ParamFormat.seconds2;
            changed(v) => { root.set(ClipField.fade-out, v); root.commit(); }
        }
        }
    }
}

/// Speed: the rate or a curve, whether pitch follows it, and backwards.
export component SpeedPanel inherits VerticalLayout {
    in property <SelectedClipData> selected;

    callback set(field: ClipField, value: float);
    callback commit();

    property <float> speed;
    function seed() { root.speed = root.selected.speed; }
    init => { root.seed(); }
    changed selected => { root.seed(); }

    property <bool> speed-help;
    /// The Select's rows: the constant rate first, then the shapes in the
    /// order Rust keeps them, then Custom for a shape that is none of them.
    property <[string]> curves: [I18n.t("Normal"), I18n.t("Montage"), I18n.t("Hero"), I18n.t("Bullet"),
        I18n.t("Jump Cut"), I18n.t("Flash In"), I18n.t("Flash Out"), I18n.t("Custom")];
    property <bool> curved: root.selected.speed-curve >= 0;

    Section {
        first: true;
        speed := SectionHeader {
            title: I18n.t("Speed");
            collapsible: true;
            summary: InspectorFmt.format(ParamFormat.rate, root.speed);
            HelpButton {
                open: root.speed-help;
                toggled => { root.speed-help = self.open; }
            }
        }

        if speed.open: SectionBody {

        if root.speed-help: Note {
            text: I18n.t("Rate re-times the clip in place, so the timeline length changes with it. Trim afterwards, not before. A curve varies the rate over the clip; the same footage plays, faster here and slower there.");
        }

        Row {
            label: I18n.t("Curve");
            Select {
                options: root.curves;
                // Custom is one past the presets; Rust says so with their
                // count, which lands on the same row.
                current: root.curved ? Math.min(root.selected.speed-curve + 1,
                    root.curves.length - 1) : 0;
                changed(index) => {
                    // Custom cannot be chosen, only arrived at.
                    if (index < root.curves.length - 1) {
                        root.set(ClipField.speed-curve, index - 1);
                        root.commit();
                    }
                }
            }
        }

        Param {
            label: I18n.t("Rate");
            value <=> root.speed;
            // With a curve the rate is the curve's mean, read-only: the
            // shape decides it.
            enabled: !root.curved;
            // The engine's full range. The track is linear, so the useful
            // 0.25-4x band sits left of centre and the number field beside it
            // is how the extremes are actually dialled in.
            minimum: 0.0625;
            maximum: 16;
            step: 0.05;
            default-value: 1;
            fmt: ParamFormat.rate;
            changed(v) => { root.set(ClipField.speed, v); root.commit(); }
        }

        SwitchRow {
            label: I18n.t("Change pitch with speed");
            checked: !root.selected.preserve-pitch;
            toggled(on) => {
                root.set(ClipField.preserve-pitch, on ? 0 : 1);
                root.commit();
            }
        }

        SwitchRow {
            label: I18n.t("Reverse");
            checked: root.selected.reverse;
            toggled(on) => {
                root.set(ClipField.reverse, on ? 1 : 0);
                root.commit();
            }
        }

        }
    }
}

/// Animation: how the clip comes in, goes out, and moves in between. Each
/// slot is a named shape from Rust's list and, for the head and tail, the
/// seconds it takes. The shapes are keys on the clip's own placement, so
/// the stage box follows them at the playhead.
export component AnimationPanel inherits VerticalLayout {
    in property <SelectedClipData> selected;

    callback set(field: ClipField, value: float);
    callback commit();

    property <[string]> in-shapes: [I18n.t("None"), I18n.t("Fade"), I18n.t("Zoom In"), I18n.t("Zoom Out"),
        I18n.t("Slide Up"), I18n.t("Slide Down"), I18n.t("Slide Left"), I18n.t("Slide Right"), I18n.t("Spin")];
    property <[string]> out-shapes: [I18n.t("None"), I18n.t("Fade"), I18n.t("Zoom In"), I18n.t("Zoom Out"),
        I18n.t("Slide Up"), I18n.t("Slide Down"), I18n.t("Slide Left"), I18n.t("Slide Right"), I18n.t("Spin")];
    property <[string]> combo-shapes: [I18n.t("None"), I18n.t("Pulse"), I18n.t("Shake"), I18n.t("Spin"), I18n.t("Bounce"), I18n.t("Drift")];

    property <float> in-seconds;
    property <float> out-seconds;
    function seed() {
        root.in-seconds = root.selected.anim-in-duration;
        root.out-seconds = root.selected.anim-out-duration;
    }
    init => { root.seed(); }
    changed selected => { root.seed(); }

    /// The longest a head or tail shape may take: half the clip, so the
    /// two cannot cross.
    property <float> limit: Math.max(0.1, Math.min(10, root.selected.duration / 2));
    property <bool> help;

    Section {
        first: true;
        SectionHeader {
            title: I18n.t("In");
            HelpButton {
                open: root.help;
                toggled => { root.help = self.open; }
            }
        }
        SectionBody {
        if root.help: Note {
            text: I18n.t("In and Out play over the clip's first and last seconds; Combo runs its whole length. Each moves the clip from where you placed it, so position it first.");
        }
        Row {
            label: I18n.t("Shape");
            Select {
                options: root.in-shapes;
                current: root.selected.anim-in + 1;
                changed(index) => { root.set(ClipField.anim-in, index - 1); root.commit(); }
            }
        }
        if root.selected.anim-in >= 0: Param {
            label: I18n.t("Length");
            value <=> root.in-seconds;
            minimum: 0.1;
            maximum: root.limit;
            step: 0.05;
            default-value: 0.5;
            fmt: ParamFormat.seconds2;
            changed(v) => { root.set(ClipField.anim-in-duration, v); root.commit(); }
        }
        }
    }

    Section {
        SectionHeader { title: I18n.t("Out"); }
        SectionBody {
        Row {
            label: I18n.t("Shape");
            Select {
                options: root.out-shapes;
                current: root.selected.anim-out + 1;
                changed(index) => { root.set(ClipField.anim-out, index - 1); root.commit(); }
            }
        }
        if root.selected.anim-out >= 0: Param {
            label: I18n.t("Length");
            value <=> root.out-seconds;
            minimum: 0.1;
            maximum: root.limit;
            step: 0.05;
            default-value: 0.5;
            fmt: ParamFormat.seconds2;
            changed(v) => { root.set(ClipField.anim-out-duration, v); root.commit(); }
        }
        }
    }

    Section {
        SectionHeader { title: I18n.t("Combo"); }
        SectionBody {
        Row {
            label: I18n.t("Shape");
            Select {
                options: root.combo-shapes;
                current: root.selected.anim-combo + 1;
                changed(index) => { root.set(ClipField.anim-combo, index - 1); root.commit(); }
            }
        }
        }
    }
}

/// Adjust: the manual colour panel. Every knob is a parameter of the one
/// built-in `concat.adjust` package, which Rust puts at the head of the
/// picture's chain the first time a knob moves; until then the rows show the
/// package's defaults, which are the picture as shot. The rows come from the
/// manifest, so a knob added there appears here without a line of UI.
export component AdjustPanel inherits VerticalLayout {
    in property <[AppliedParamData]> params;

    callback set(key: string, value: float);
    callback commit();

    property <bool> help;

    Section {
        first: true;
        SectionHeader {
            title: I18n.t("Colour");
            HelpButton {
                open: root.help;
                toggled => { root.help = self.open; }
            }
        }

        if root.help: Note {
            text: I18n.t("Exposure is in stops; the rest is a signed percent of the picture as shot, and zero everywhere is the picture as shot. Double-click a knob to put it back.");
        }

        // See PresetStack for why each row re-seeds its knob.
        SectionBody {
            for p in root.params: Rectangle {
                property <AppliedParamData> data: p;
                height: knob.preferred-height;
                changed data => { knob.value = self.data.value; }

                knob := Param {
                    label: p.label;
                    value: p.value;
                    minimum: p.min;
                    maximum: p.max;
                    step: p.step;
                    default-value: p.default-value;
                    fmt: p.fmt;
                    changed(v) => { root.set(p.key, v); root.commit(); }
                }
            }
        }
    }
}

// The panel a filter layer gets instead of Adjust.
//
// A layer is not a clip of anything: it has no picture to frame, no gain to
// set and no rate to change — it treats whatever is playing under it, for as
// long as it runs. So it gets the two things that *are* its own: how hard it
// is applied, and how it comes in and goes out.
//
// Strength is the clip's `opacity`. That is the same number a picture clip
// dissolves with, which is exactly what it means here — how much of the
// treated signal is heard — and one field that means one thing on every kind
// beats a second that means it only on this one.
export component FilterPanel inherits VerticalLayout {
    in property <SelectedClipData> selected;

    callback set(field: ClipField, value: float);
    callback commit();

    /// A ramp longer than half the layer would overlap the other one.
    property <float> ramp-limit: Math.max(0.1, Math.min(10, root.selected.duration / 2));

    // Seeded, not bound, for the reason AdjustPanel's are: a control writes to
    // its own `value`, and an assignment replaces the binding declared here.
    property <float> strength;
    property <float> fade-in;
    property <float> fade-out;

    function seed() {
        root.strength = root.selected.opacity;
        root.fade-in = root.selected.fade-in;
        root.fade-out = root.selected.fade-out;
    }

    init => { root.seed(); }
    changed selected => { root.seed(); }

    property <bool> layer-help;

    Section {
        first: true;
        layer := SectionHeader {
            title: I18n.t("Layer");
            collapsible: true;
            summary: InspectorFmt.format(ParamFormat.fraction, root.strength);
            HelpButton {
                open: root.layer-help;
                toggled => { root.layer-help = self.open; }
            }
        }

        if layer.open: SectionBody {

        if root.layer-help: Note {
            text: I18n.t("A layer treats everything under it for as long as it runs. Trim it on the timeline to change what it covers.");
        }

        Param {
            label: I18n.t("Strength");
            value <=> root.strength;
            minimum: 0;
            maximum: 1;
            step: 0.01;
            default-value: 1;
            fmt: ParamFormat.fraction;
            changed(v) => { root.set(ClipField.opacity, v); root.commit(); }
        }

        }
    }

    Section {
        ramps := SectionHeader {
            title: I18n.t("Ramps");
            collapsible: true;
            summary: (root.fade-in == 0 && root.fade-out == 0) ? I18n.t("none")
                : InspectorFmt.format(ParamFormat.seconds2, root.fade-in)
                    + " / " + InspectorFmt.format(ParamFormat.seconds2, root.fade-out);
        }
        if ramps.open: SectionBody {
        Param {
            label: I18n.t("Ramp in");
            value <=> root.fade-in;
            minimum: 0;
            maximum: root.ramp-limit;
            step: 0.05;
            fmt: ParamFormat.seconds2;
            changed(v) => { root.set(ClipField.fade-in, v); root.commit(); }
        }
        Param {
            label: I18n.t("Ramp out");
            value <=> root.fade-out;
            minimum: 0;
            maximum: root.ramp-limit;
            step: 0.05;
            fmt: ParamFormat.seconds2;
            changed(v) => { root.set(ClipField.fade-out, v); root.commit(); }
        }
        }
    }
}

// The catalogues. Data only: the stack renders whatever params a preset
// declares, so adding a processor is one entry here and no change to the
// panel. The ids are written into project files, so they are stable forever.
