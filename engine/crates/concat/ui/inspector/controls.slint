import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Fmt } from "../util.slint";
import { Glyph, Icon } from "../icons.slint";
import { NumberField } from "../primitives/number-field.slint";
import { ClipField, ClipKeyData, Keyframes } from "../timeline/model.slint";

// The clip inspector's controls: a horizontal fader, the Param row that
// repeats down every tab, a switch, a help disclosure, a note, and a search
// field. Written to the same contract as primitives/ — value plus a changed
// callback — so promoting one later is a file move rather than a rewrite.

// How a parameter's readout is spelled. A Slint struct cannot carry a
// closure, so the catalogue names one of these per param and InspectorFmt
// renders it.
export enum ParamFormat {
    percent,     // "45%"
    pitch,       // 0 is I18n.t("auto"), else "+3 st"
    seconds,     // 0 is I18n.t("off"), else "1.4 s"
    millis,      // 0 is I18n.t("off"), else "320 ms"
    hertz,       // "120 Hz", "6.5 kHz"
    decibels,    // "-18.0 dB", "+3.0 dB"
    ratio,       // "4.0 : 1"
    rate-hz,     // "1.2 Hz"
    steps,       // "12"
    rate,        // "1.00x"
    fade,        // 0 is I18n.t("none"), else "1.5 s"

    // The clip inspector's own. Several of these are fractions of something —
    // the frame's height, the frame's width — rather than absolute units,
    // because the frame can be any resolution and points would be a lie.
    fraction,    // 0..1 as a whole percent: "72%"
    centred,     // a signed offset: I18n.t("centred") at zero, else "-12.5%"
    degrees,     // "45°"
    gain,        // decibels, with the floor spelled I18n.t("Silent")
    height,      // "9.0% of height"
    outline,     // 0 is I18n.t("none"), else "3.5%"
    seconds2,    // "1.25s" — two places, for a fade dialled against a duration

    // For a package parameter whose unit the manifest did not name, or
    // named in a unit nothing above spells.
    plain,       // "1.25", or "12" when it is whole
    kelvin,      // "4600 K"
    stops,       // "+0.50 EV", "0.00 EV"
}

export global InspectorFmt {
    // "3.5", with the trailing zero a bare interpolation would drop.
    public pure function fixed1(v: float) -> string {
        return (v < 0 ? "-" : "")
            + "\{Math.floor(Math.abs(Fmt.round-to(v, 1)))}.\{Math.mod(Math.round(Math.abs(v) * 10), 10)}";
    }

    public pure function fixed2(v: float) -> string {
        return (v < 0 ? "-" : "")
            + "\{Math.floor(Math.abs(Fmt.round-to(v, 2)))}." + Fmt.pad2(Math.mod(Math.round(Math.abs(v) * 100), 100));
    }

    public pure function format(fmt: ParamFormat, v: float) -> string {
        if (fmt == ParamFormat.percent) { return "\{Math.round(v)}%"; }
        if (fmt == ParamFormat.pitch) {
            return v == 0 ? I18n.t("auto") : "+\{Math.round(v)} st";
        }
        if (fmt == ParamFormat.seconds) {
            return v == 0 ? I18n.t("off") : InspectorFmt.fixed1(v) + " s";
        }
        if (fmt == ParamFormat.millis) {
            return v == 0 ? I18n.t("off") : "\{Math.round(v)} ms";
        }
        if (fmt == ParamFormat.hertz) {
            return v >= 1000 ? InspectorFmt.fixed1(v / 1000) + " kHz"
                : I18n.t1("{0} Hz", "\{Math.round(v)}");
        }
        if (fmt == ParamFormat.decibels) {
            return (v > 0 ? "+" : "") + InspectorFmt.fixed1(v) + " dB";
        }
        if (fmt == ParamFormat.ratio) { return InspectorFmt.fixed1(v) + " : 1"; }
        if (fmt == ParamFormat.rate-hz) { return InspectorFmt.fixed1(v) + " Hz"; }
        if (fmt == ParamFormat.steps) { return "\{Math.round(v)}"; }
        if (fmt == ParamFormat.rate) { return InspectorFmt.fixed2(v) + "x"; }
        if (fmt == ParamFormat.fraction) { return "\{Math.round(v * 100)}%"; }
        if (fmt == ParamFormat.centred) {
            // A hair either side of zero still reads as centred: the step is
            // 0.005, so an exact zero is easy to miss by one press.
            return Math.abs(v) < 0.0025 ? I18n.t("centred") : InspectorFmt.fixed1(v * 100) + "%";
        }
        if (fmt == ParamFormat.degrees) { return "\{Math.round(v)}°"; }
        if (fmt == ParamFormat.gain) {
            // The bottom of the fader is silence, not -60 dB: a fader that
            // cannot reach zero is a fader you cannot mute with.
            return v <= -60 ? I18n.t("Silent")
                : Math.abs(v) < 0.05 ? "0.0 dB"
                : (v > 0 ? "+" : "") + InspectorFmt.fixed1(v) + " dB";
        }
        if (fmt == ParamFormat.height) {
            return InspectorFmt.fixed1(v * 100) + "% of height";
        }
        if (fmt == ParamFormat.outline) {
            return v == 0 ? I18n.t("none") : InspectorFmt.fixed1(v * 100) + "%";
        }
        if (fmt == ParamFormat.seconds2) {
            return v == 0 ? I18n.t("none") : InspectorFmt.fixed2(v) + "s";
        }
        if (fmt == ParamFormat.plain) {
            return Math.abs(v - Math.round(v)) < 0.0005 ? "\{Math.round(v)}"
                : InspectorFmt.fixed2(v);
        }
        if (fmt == ParamFormat.kelvin) { return I18n.t1("{0} K", "\{Math.round(v)}"); }
        if (fmt == ParamFormat.stops) {
            return (v > 0 ? "+" : "") + InspectorFmt.fixed2(v) + " EV";
        }
        return v == 0 ? I18n.t("none") : InspectorFmt.fixed1(v) + " s";
    }

    /// Linear gain to decibels. Zero maps to the bottom of the fader rather
    /// than to -infinity, so the control has a reachable floor.
    public pure function to-decibels(gain: float) -> float {
        return gain <= 0 ? -60 : Fmt.clamp(20 * Math.log(gain, 10), -60, 24);
    }

    /// And back. At the very bottom the fader means silence, so it snaps to
    /// exactly zero rather than leaving an inaudible-but-nonzero gain in the
    /// project.
    public pure function from-decibels(decibels: float) -> float {
        return decibels <= -60 ? 0 : Math.pow(10, decibels / 20);
    }

    // What the raw NumberField beside a fader should show for a given step.
    public pure function precision-of(step: float) -> int {
        return step < 0.01 ? 3 : step < 0.1 ? 2 : step < 1 ? 1 : 0;
    }
}

// Horizontal fader. Click to jump, drag to ride, double-click to reset.
//
// A sunken track the height of a field, filled from the left in the soft
// accent up to a bar in the full one. The fill is what reads at a glance -
// how much of the range is dialled in - and the bar, not a bead, is what
// lands on a value: flat edges have a precision a circle never has, and at
// zero the bar still sits inside the track rather than hanging off its end.
export component Fader inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    /// restored on double-click
    in property <float> default-value: root.minimum;
    in property <bool> enabled: true;

    callback changed(value: float);

    height: Theme.h;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: (touch.has-hover && root.enabled) ? Theme.line-strong : Theme.line;
    background: Theme.well;
    opacity: root.enabled ? 1.0 : 0.45;

    animate border-color { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    property <float> span: Math.max(root.maximum - root.minimum, 0.000001);
    // The rail is inset by the border and two pixels, so the bar lands under
    // the pointer at both ends instead of a few px short of them.
    property <length> inset: 3px;
    property <length> usable: Math.max(1px, root.width - 2 * root.inset);
    property <float> percent: Fmt.clamp((root.value - root.minimum) / root.span, 0, 1);

    function settle(raw: float) {
        root.value = Fmt.clamp(
            root.minimum + Math.round((raw - root.minimum) / root.step) * root.step,
            root.minimum, root.maximum);
        root.changed(root.value);
    }

    function apply-at(at: length) {
        root.settle(root.minimum
            + Fmt.clamp((at - root.inset) / root.usable, 0, 1) * root.span);
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: ew-resize;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                root.apply-at(self.mouse-x);
            }
        }
        moved => {
            root.apply-at(self.mouse-x);
        }
        double-clicked => {
            root.settle(root.default-value);
        }
    }

    fill := Rectangle {
        x: root.inset;
        y: root.inset;
        width: root.usable * root.percent;
        height: parent.height - 2 * root.inset;
        border-radius: Theme.r-xs;
        background: Theme.accent-soft;
    }

    cap := Rectangle {
        x: root.inset + root.usable * root.percent - self.width * root.percent;
        y: root.inset;
        width: 3px;
        height: parent.height - 2 * root.inset;
        border-radius: 2px;
        background: (touch.has-hover || touch.pressed) && root.enabled
            ? Theme.accent-hover : Theme.accent;

        animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    }
}

// The other slider, and the other half of the pair: where the Fader is a
// filled box the height of a field, the Rail is a hairline track with a
// raised chip you push along it.
//
// Which one a row gets is a question of how loud the row is, not of taste.
// The Fader is a *field*: it is the height of the number box beside it, it
// carries its own ground, and a column of them reads as a form — which is
// what an effect's six knobs should read as. The Rail is a *control*: it is
// mostly air, the dragger is the only solid thing in it, and one of them in
// a section says this is the setting the section is about. Volume is that.
// A chorus's wet/dry is not.
//
// The dragger is a chip and not a bead for the reason the Fader's cap is a
// bar: flat sides land on a value. It is light rather than accent-coloured
// because the fill it slides over is already the accent, and a dragger in
// the colour of the thing behind it stops being a dragger.
export component Rail inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    /// restored on double-click
    in property <float> default-value: root.minimum;
    in property <bool> enabled: true;

    callback changed(value: float);

    height: Theme.h;
    opacity: root.enabled ? 1.0 : 0.45;

    property <float> span: Math.max(root.maximum - root.minimum, 0.000001);
    /// Half the dragger, so it stays inside the track at both ends and the
    /// value under the pointer is the value under the dragger's middle.
    property <length> inset: 5.5px;
    property <length> usable: Math.max(1px, root.width - 2 * root.inset);
    property <float> percent: Fmt.clamp((root.value - root.minimum) / root.span, 0, 1);
    property <bool> live: (touch.has-hover || touch.pressed) && root.enabled;

    function settle(raw: float) {
        root.value = Fmt.clamp(
            root.minimum + Math.round((raw - root.minimum) / root.step) * root.step,
            root.minimum, root.maximum);
        root.changed(root.value);
    }

    function apply-at(at: length) {
        root.settle(root.minimum
            + Fmt.clamp((at - root.inset) / root.usable, 0, 1) * root.span);
    }

    // The track. Four pixels and a hairline: enough to read as a groove, not
    // enough to compete with the dragger for the eye.
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.well;

        // Runs to the dragger's middle rather than to its near edge, so the
        // fill and the chip meet instead of leaving a gap that grows with
        // the dragger's width.
        Rectangle {
            x: 0;
            y: 0;
            width: root.inset + root.usable * root.percent;
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.accent;
        }
    }

    grip := Rectangle {
        x: root.inset + root.usable * root.percent - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 11px;
        // Grows under the pointer: the chip is small enough that the target
        // wants confirming, and the growth is the confirmation.
        height: touch.pressed ? 22px : (root.live ? 20px : 18px);
        border-radius: Theme.r-xs;
        border-width: 1px;
        border-color: Theme.grip-edge;
        background: touch.pressed ? Theme.grip-active : Theme.grip;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.grip-edge;

        animate height, background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: ew-resize;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                root.apply-at(self.mouse-x);
            }
        }
        moved => {
            root.apply-at(self.mouse-x);
        }
        double-clicked => {
            root.settle(root.default-value);
        }
    }
}

// One target of the cluster. Small, quiet, and greyed rather than hidden
// when there is nowhere to go.
component KeyButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <bool> filled;
    in property <bool> enabled: true;
    in property <color> tint: Theme.fg-dim;

    callback clicked();

    width: 17px;
    height: 17px;
    border-radius: Theme.r-xs;
    background: touch.has-hover && root.enabled ? Theme.field : Colors.transparent;
    opacity: root.enabled ? 1.0 : 0.35;

    Icon {
        glyph: root.glyph;
        size: 11px;
        filled: root.filled;
        tint: touch.has-hover && root.enabled ? Theme.fg : root.tint;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The keyframe cluster: step back, put one on or take it off, step forward.
//
// Three targets in the width of one, which is what makes it a cluster rather
// than three buttons - they are read as one control ("is this animated, and
// where am I in it") and only pressed as three. The chevrons move the
// playhead rather than the value: a key is set where the playhead is, so
// arriving at one is how you edit it.
export component KeyCluster inherits HorizontalLayout {
    in property <ClipField> field;

    property <ClipKeyData> state: Keyframes.row(root.field);
    property <bool> live: Keyframes.available;

    spacing: 1px;

    prev := KeyButton {
        glyph: Glyph.chevron-left;
        enabled: root.live && root.state.prev;
        clicked => { Keyframes.step(root.field, -1); }
    }

    diamond := KeyButton {
        glyph: Glyph.keyframe;
        // Filled on a key, outlined on a keyed property between keys, and
        // plain grey on one that is still a constant. Three states because
        // there are three answers, and the middle one - "animated, but not
        // here" - is the one a two-state diamond loses.
        filled: root.state.here;
        enabled: root.live;
        tint: root.state.here || root.state.keyed ? Theme.accent : Theme.fg-dim;
        clicked => { Keyframes.toggle(root.field); }
    }

    next := KeyButton {
        glyph: Glyph.chevron-right;
        enabled: root.live && root.state.next;
        clicked => { Keyframes.step(root.field, 1); }
    }
}

// The inspector's repeating unit: a formatted readout above (the value in a
// unit you reason about — "none", "auto", "1.00x"), the fader and a raw
// number field below. Keeping both is what lets a fade of zero say "none"
// without making zero un-typeable.
export component Param inherits VerticalLayout {
    in property <string> label;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <float> default-value: root.minimum;
    in property <ParamFormat> fmt;
    in property <bool> enabled: true;
    /// Ride the Rail instead of the Fader — for the one setting a section is
    /// named after, not for a list of knobs.
    in property <bool> rail: false;
    /// Show the keyframe cluster, and which field it keys. Opt-in rather
    /// than derived from `field`, because a Slint enum property with nothing
    /// assigned to it is its first variant and not "none" - every unkeyable
    /// row would otherwise claim to be keying scale.
    in property <bool> keyable: false;
    in property <ClipField> field;

    callback changed(value: float);

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    spacing: 4px;

    HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.fg-muted;
            font-size: Theme.fs;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        Text {
            text: InspectorFmt.format(root.fmt, root.value);
            color: Theme.fg;
            font-family: Theme.font-technical;
            font-size: Theme.fs;
            vertical-alignment: center;
        }

        // On the readout's side rather than under the slider: the cluster is
        // about the value, and the value is what it sits beside.
        if root.keyable: Rectangle { width: 6px; }
        if root.keyable: VerticalLayout {
            alignment: center;
            KeyCluster { field: root.field; }
        }
    }

    HorizontalLayout {
        spacing: 8px;

        // One row, either slider. See Rail's header for which belongs where;
        // the rest of the row - the readout above, the number field beside -
        // is the same either way, which is the point of putting the choice
        // here rather than in two near-identical Param components.
        if !root.rail: Fader {
            horizontal-stretch: 1;
            value <=> root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            default-value: root.default-value;
            enabled: root.enabled;
            changed(v) => { root.changed(v); }
        }

        if root.rail: Rail {
            horizontal-stretch: 1;
            value <=> root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            default-value: root.default-value;
            enabled: root.enabled;
            changed(v) => { root.changed(v); }
        }

        field := NumberField {
            width: 64px;
            value <=> root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            precision: InspectorFmt.precision-of(root.step);
            enabled: root.enabled;
            changed(v) => { root.changed(v); }
        }
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;

    callback toggled(checked: bool);

    width: 30px;
    height: 17px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.accent : Theme.field-active;
    opacity: root.enabled ? 1.0 : 0.45;

    animate background { duration: 120ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    thumb := Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        border-radius: self.width / 2;
        background: Theme.on-accent;

        animate x { duration: 120ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// A labelled switch on one line. `@children` is the help disclosure slot.
export component SwitchRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;

    callback toggled(checked: bool);

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    spacing: 6px;
    min-height: Theme.h;

    Text {
        text: root.label;
        color: Theme.fg-muted;
        font-size: Theme.fs;
        vertical-alignment: center;
    }

    @children

    Rectangle { horizontal-stretch: 1; }

    VerticalLayout {
        alignment: center;
        Switch {
            checked <=> root.checked;
            toggled(on) => { root.toggled(on); }
        }
    }
}

// A tooltip would hide the answer again the moment the pointer moves; this
// toggles a line of prose the caller renders where it belongs.
export component HelpButton inherits Rectangle {
    in-out property <bool> open;

    callback toggled();

    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: root.open ? Theme.accent-soft
        : touch.has-hover ? Theme.field-hover
        : Theme.field;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: "?";
        color: root.open ? Theme.accent : Theme.fg-muted;
        font-size: Theme.fs-xs;
        font-weight: Theme.weight-title;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.open = !root.open;
            root.toggled();
        }
    }
}

// Put a section back the way it was found.
//
// Sits in a SectionHeader's action slot beside the help disclosure, and is
// dimmed rather than hidden when there is nothing to undo: a control that
// appears only once you have made a mess is one you cannot learn is there.
export component ResetButton inherits Rectangle {
    /// Something in the section is off its default. False greys it.
    in property <bool> dirty: true;

    callback reset();

    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: touch.has-hover && root.dirty ? Theme.field-hover : Theme.field;
    opacity: root.dirty ? 1.0 : 0.4;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    Icon {
        glyph: Glyph.reset;
        size: 10px;
        tint: touch.has-hover && root.dirty ? Theme.fg : Theme.fg-muted;
    }

    touch := TouchArea {
        enabled: root.dirty;
        mouse-cursor: pointer;
        clicked => { root.reset(); }
    }
}

export component Note inherits HorizontalLayout {
    in property <string> text;

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    padding-top: 2px;
    padding-bottom: 4px;

    Text {
        text: root.text;
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;

    callback edited(text: string);

    height: Theme.h;
    border-radius: Theme.r-sm;
    background: Theme.field;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            Icon {
                glyph: Glyph.search;
                size: 12px;
                tint: Theme.fg-dim;
            }
        }

        Rectangle {
            clip: true;

            input := TextInput {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: self.preferred-height;
                color: Theme.fg;
                font-size: Theme.fs;
                single-line: true;
                text <=> root.text;
                edited => { root.edited(self.text); }
            }

            if root.text == "" && !input.has-focus: Text {
                x: 0;
                y: (parent.height - self.height) / 2;
                text: root.placeholder;
                color: Theme.fg-dim;
                font-size: Theme.fs;
            }
        }

        if root.text != "": VerticalLayout {
            alignment: center;
            clear := Rectangle {
                width: 18px;
                height: 18px;
                border-radius: Theme.r-xs;
                background: clear-touch.has-hover ? Theme.field-hover : Colors.transparent;

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    glyph: Glyph.close;
                    size: 10px;
                    tint: Theme.fg-muted;
                }

                clear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.text = "";
                        root.edited("");
                    }
                }
            }
        }
    }
}

// A colour on a labelled row.
//
// Rather than fake an eyedropper and a wheel, the swatch opens a shelf of the
// colours a title actually gets set to: the neutrals it is legible on, and
// the kind hues already in the theme. The hex is shown beside it so a value
// from outside the shelf is still readable rather than invisible.
export component ColourField inherits HorizontalLayout {
    in property <string> label;
    in property <color> value;
    /// The value spelled out, formatted by whoever owns it — Slint cannot
    /// print a colour.
    in property <string> hex;

    callback changed(value: color);

    /// The colours a title can be. In the theme rather than here, so a fork
    /// that retones the window retones this with it — see `swatches`.
    property <[color]> shelf: Theme.swatches;

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    spacing: 8px;
    min-height: Theme.h;

    Text {
        text: root.label;
        color: Theme.fg-muted;
        font-size: Theme.fs;
        vertical-alignment: center;
    }

    Rectangle { horizontal-stretch: 1; }

    Text {
        text: root.hex;
        color: Theme.fg-dim;
        font-family: Theme.font-technical;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
    }

    VerticalLayout {
        alignment: center;

        swatch := Rectangle {
            width: 34px;
            height: 20px;
            border-radius: Theme.r-xs;
            // The swatch sits on its own light-to-dark checker of one square,
            // so a colour near the panel's own still has an edge.
            background: Theme.fg-dim;
            border-width: 1px;
            border-color: touch.has-hover ? Theme.line-strong : Theme.line;

            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                border-radius: Theme.r-xs - 1px;
                background: root.value;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { shelf.show(); }
            }

            shelf := PopupWindow {
                x: -128px;
                y: swatch.height + 4px;
                width: 160px;
                height: 92px;
                close-policy: close-on-click-outside;

                Rectangle {
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.line-strong;
                    border-radius: Theme.r;

                    for entry[index] in root.shelf: Rectangle {
                        x: 8px + Math.mod(index, 6) * 24px;
                        y: 8px + Math.floor(index / 6) * 26px;
                        width: 20px;
                        height: 20px;
                        border-radius: Theme.r-xs;
                        background: entry;
                        border-width: 1px;
                        border-color: pick.has-hover ? Theme.fg : Theme.line;

                        pick := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.changed(entry);
                                shelf.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
