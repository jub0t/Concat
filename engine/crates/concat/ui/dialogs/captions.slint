import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, CopyChip, DialogRow, DialogSection, Modal, Progress } from "../primitives/modal.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";

// Captions: what the tray's Captions tool opens.
//
// Two places the words can come from. The sound: the selected clip's, or
// every clip with sound on the timeline when nothing is selected, run
// through the transcriber and cut to the words' own timing. A script: the
// words typed here, one title per sentence at reading pace, laid down one
// after another. Then where the lines sit and how big they are, and one
// button. While it runs the sheet is the progress report: a transcription
// knows how far through the sound it is, so it gets a real bar and not a
// sweep. The language is the transcriber's to work out.

export struct CaptionsSheetData {
    open: bool,
    /// 0 Sound, 1 Script
    source: int,
    /// The sound to transcribe: the selected clip's name, or "4 clips with
    /// sound"; empty when the timeline has none.
    subject: string,
    /// Where a script's captions land, for the header's note.
    landing: string,
    text: string,
    /// Row in the installed transcriber list.
    model: int,
    /// 0 Bottom, 1 Centre, 2 Top
    placement: int,
    /// 0 Small, 1 Medium, 2 Large
    size: int,
    running: bool,
    /// 0..1
    progress: float,
    /// A transcriber model is installed.
    ready: bool,
    /// Why the last run failed, when it did.
    message: string,
}

export component CaptionsDialog inherits Modal {
    in property <CaptionsSheetData> data;
    /// The installed transcriber models, by name.
    in property <[string]> models;

    callback source-changed(index: int);
    callback text-edited(text: string);
    callback model-changed(index: int);
    callback placement-changed(index: int);
    callback size-changed(index: int);
    callback begin();
    callback cancel();

    property <bool> from-sound: root.data.source == 0;

    open: root.data.open;
    title: I18n.t("Captions");
    glyph: Glyph.text-mark;
    surface-width: 480px;
    dismissable: !root.data.running;
    note: root.from-sound ? root.data.subject : root.data.landing;

    // The script being typed, held apart from `data.text` the way the Field
    // primitive holds its draft: a TextInput's binding is dropped on the
    // first keystroke, so the sheet re-seeds it when it opens and never
    // while it is being typed into.
    property <string> draft;
    /// The script has the caret. Kept up here because the box lives under
    /// an `if`, and nothing outside one can reach into it.
    property <bool> typing;
    changed data => {
        if (!root.typing) {
            root.draft = root.data.text;
        }
    }
    init => { root.draft = root.data.text; }

    VerticalLayout {
        if !root.data.running: DialogSection {
            first: true;
            title: I18n.t("Source");

            SegmentedControl {
                options: [I18n.t("Sound"), I18n.t("Script")];
                current: root.data.source;
                changed(index) => { root.source-changed(index); }
            }
        }

        if !root.data.running && root.from-sound: DialogSection {
            title: I18n.t("Transcriber");

            DialogRow {
                label: I18n.t("Model");
                Select {
                    options: root.models;
                    current: root.data.model;
                    placeholder: I18n.t("None installed");
                    enabled: root.models.length > 0;
                    changed(index) => { root.model-changed(index); }
                }
            }

            if !root.data.ready: Text {
                text: I18n.t("Download a transcriber model in Settings › Transcriber first.");
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            if root.data.subject == "": Text {
                text: I18n.t("Nothing on the timeline has sound to transcribe. Select a clip with sound, or type a script instead.");
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        if !root.data.running && !root.from-sound: DialogSection {
            title: I18n.t("Script");

            Rectangle {
                height: 104px;
                border-radius: Theme.r;
                background: Theme.well;
                border-width: 1px;
                border-color: script.has-focus ? Theme.accent : Theme.line;
                clip: true;

                script := TextInput {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    text <=> root.draft;
                    color: Theme.fg;
                    font-size: Theme.fs-lg;
                    single-line: false;
                    wrap: word-wrap;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                    changed has-focus => { root.typing = self.has-focus; }
                    edited => { root.text-edited(self.text); }
                }

                if root.draft == "" && !script.has-focus: Text {
                    x: 10px;
                    y: 8px;
                    text: I18n.t("Type the words to put on screen…");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-lg;
                }
            }
        }

        if !root.data.running: DialogSection {
            title: I18n.t("Captions");

            DialogRow {
                label: I18n.t("Placement");
                SegmentedControl {
                    options: [I18n.t("Bottom"), I18n.t("Centre"), I18n.t("Top")];
                    current: root.data.placement;
                    changed(index) => { root.placement-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("Size");
                SegmentedControl {
                    options: [I18n.t("Small"), I18n.t("Medium"), I18n.t("Large")];
                    current: root.data.size;
                    changed(index) => { root.size-changed(index); }
                }
            }

            Text {
                text: root.from-sound
                    ? I18n.t("One title per phrase spoken, cut to the words' own timing, on the first lane with room.")
                    : I18n.t("One title per sentence, held for as long as it takes to read, one after another on the first lane with room.");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            if root.data.message != "": Rectangle {
                border-radius: Theme.r;
                background: Theme.danger-soft;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: start;
                        Icon { glyph: Glyph.close; size: 13px; tint: Theme.danger; }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.message;
                        color: Theme.danger;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        alignment: start;
                        CopyChip { text: root.data.message; }
                    }
                }
            }

            if root.data.running: HorizontalLayout {
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    text: root.data.progress < 0.02 ? I18n.t("Loading the model") : I18n.t("Transcribing");
                    color: Theme.fg;
                    font-size: Theme.fs;
                    vertical-alignment: center;
                }

                Text {
                    text: "\{Math.round(root.data.progress * 100)}%";
                    color: Theme.fg-muted;
                    font-family: Theme.font-technical;
                    font-size: Theme.fs;
                    vertical-alignment: center;
                }
            }

            if root.data.running: Progress { value: root.data.progress; }

            if root.data.running: HorizontalLayout {
                alignment: start;
                Button {
                    label: I18n.t("Cancel");
                    glyph: Glyph.close;
                    ghost: true;
                    clicked => { root.cancel(); }
                }
            }

            if !root.data.running: Button {
                block: true;
                primary: true;
                large: true;
                glyph: Glyph.text-mark;
                label: root.from-sound ? I18n.t("Generate captions") : I18n.t("Add captions");
                enabled: root.from-sound
                    ? root.data.ready && root.data.subject != ""
                    : root.draft != "";
                clicked => { root.begin(); }
            }
        }
    }
}
