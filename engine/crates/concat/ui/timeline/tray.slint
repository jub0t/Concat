import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { IconButton } from "../primitives/panel.slint";
import { Tip } from "../primitives/tooltip.slint";
import { TimelineTool } from "model.slint";

// The timeline's tool tray.
//
// The tool set: pointer and razor, then the three edit actions, then
// snapping, then the tools a clip's sound and words need - captions, a
// spoken title, detaching the sound - then add-track, and the view controls
// pushed to the far end behind the timecode readout. The metrics: 40px
// tall, 4px between buttons, an 18px hairline with 4px of air on each side
// between groups. Tight, without crowding a 26px button.
//
// The sound and word tools carry their names on the bar. They used to hang
// off one menu button, and a menu is where a tool goes to not be found:
// nobody looking for captions opens a waveform icon. Greyed rather than
// absent when the selection cannot use them, because a greyed button with
// a tip answers "why not" and an absent one only asks it.
//
// A disabled Merge carries the reason it is blocked, because a button that
// greys out without saying why leaves you guessing at the rule:
// `merge-blocked-because` is accepted and becomes the button's label, which
// is its accessible name and where a tooltip reads from.

// A tool with its name beside its mark: the same chip an IconButton is,
// wide enough for a word.
component TrayTool inherits Rectangle {
    in property <Glyph> glyph;
    in property <string> caption;
    /// what the tip says; the reason, when the tool is greyed
    in property <string> label;
    in property <bool> enabled: true;

    callback clicked();

    property <bool> lit: touch.has-hover && root.enabled;
    property <brush> tint: root.lit ? Theme.fg : Theme.fg-muted;

    width: text.preferred-width + 35px;
    min-height: 26px;

    chip := Rectangle {
        y: (root.height - self.height) / 2;
        width: root.width;
        height: 26px;
        border-radius: Theme.r-sm;
        opacity: root.enabled ? 1.0 : 0.4;
        background: !root.enabled ? Colors.transparent
            : touch.pressed ? Theme.field-active
            : touch.has-hover ? Theme.field
            : Colors.transparent;

        animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 9px;
            spacing: 5px;

            VerticalLayout {
                alignment: center;
                Icon {
                    glyph: root.glyph;
                    size: 14px;
                    tint: root.tint;
                }
            }

            text := Text {
                text: root.caption;
                color: root.tint;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }

        Tip {
            text: root.label;
            active: touch.has-hover;
        }
    }
}

component Divider inherits Rectangle {
    width: 9px;

    Rectangle {
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: 1px;
        height: 18px;
        background: Theme.line;
    }
}

export component TimelineTray inherits Rectangle {
    in property <TimelineTool> tool: TimelineTool.select;
    in property <bool> snap: true;
    in property <int> selected-count;
    /// Empty when the selection can be merged; otherwise why it cannot.
    in property <string> merge-blocked-because;
    /// What the selection can have done to its sound and its words. Each
    /// is one clip's worth of truth, decided by Rust; see the Editor global.
    in property <bool> can-caption;
    in property <bool> can-speak;
    in property <bool> can-detach;
    in property <bool> can-reattach;
    /// hh:mm:ss:ff at the playhead, formatted by the caller
    in property <string> readout;

    callback tool-changed(tool: TimelineTool);
    callback snap-changed(snap: bool);
    callback split();
    callback merge();
    callback delete-selected();
    callback captions();
    callback speak();
    callback detach();
    callback reattach();
    callback add-track();
    callback fit();
    callback zoom(factor: float);

    height: 40px;
    background: Theme.panel;

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.line;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 4px;

        IconButton {
            glyph: Glyph.pointer;
            label: I18n.t("Select (A or V)");
            icon-size: 16px;
            checked: root.tool == TimelineTool.select;
            clicked => { root.tool-changed(TimelineTool.select); }
        }
        IconButton {
            glyph: Glyph.razor;
            label: I18n.t("Razor (B)");
            icon-size: 16px;
            checked: root.tool == TimelineTool.razor;
            clicked => { root.tool-changed(TimelineTool.razor); }
        }

        Divider { }

        IconButton {
            glyph: Glyph.split;
            label: I18n.t("Split at playhead (S, or ⌘B for every clip)");
            icon-size: 16px;
            clicked => { root.split(); }
        }
        IconButton {
            glyph: Glyph.merge;
            // The reason a blocked Merge is blocked rides on the button rather
            // than being spelled out beside it. This tree has no tooltip yet,
            // so `label` — the accessible name, and where a tooltip will read
            // from — is the honest place to park it. A permanent caption in
            // the tray would answer a question nobody had asked yet.
            label: root.merge-blocked-because == "" ? "Merge selected"
                : root.merge-blocked-because;
            enabled: root.merge-blocked-because == "";
            icon-size: 16px;
            clicked => { root.merge(); }
        }
        IconButton {
            glyph: Glyph.trash;
            label: I18n.t("Delete selected");
            danger: true;
            icon-size: 16px;
            enabled: root.selected-count > 0;
            clicked => { root.delete-selected(); }
        }

        // The count of a multiple selection, in the accent so it reads as a
        // fact about the selection rather than another control.
        if root.selected-count > 1: Text {
            width: 16px;
            text: "\{root.selected-count}";
            color: Theme.accent;
            font-size: Theme.fs-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Divider { }

        IconButton {
            glyph: Glyph.magnet;
            label: I18n.t("Snap to edges");
            icon-size: 16px;
            checked: root.snap;
            clicked => { root.snap-changed(!root.snap); }
        }

        Divider { }

        TrayTool {
            glyph: Glyph.text-mark;
            caption: I18n.t("Captions");
            label: root.can-caption ? I18n.t("Auto captions from this clip's sound")
                : I18n.t("Select one clip with sound to caption it");
            enabled: root.can-caption;
            clicked => { root.captions(); }
        }
        TrayTool {
            glyph: Glyph.volume;
            caption: I18n.t("Speak");
            label: root.can-speak ? I18n.t("Read this title aloud")
                : I18n.t("Select a title to read it aloud");
            enabled: root.can-speak;
            clicked => { root.speak(); }
        }
        // One slot, two verbs: the sound is either on its picture or off it.
        if !root.can-reattach: TrayTool {
            glyph: Glyph.waveform;
            caption: I18n.t("Detach audio");
            label: root.can-detach ? I18n.t("Put this clip's sound on its own lane")
                : I18n.t("Select one video clip to detach its sound");
            enabled: root.can-detach;
            clicked => { root.detach(); }
        }
        if root.can-reattach: TrayTool {
            glyph: Glyph.merge;
            caption: I18n.t("Reattach");
            label: I18n.t("Put the detached sound back on its picture");
            clicked => { root.reattach(); }
        }

        Divider { }

        IconButton {
            glyph: Glyph.plus;
            label: I18n.t("Add track");
            icon-size: 14px;
            clicked => { root.add-track(); }
        }

        Rectangle { horizontal-stretch: 1; }

        // Fixed width, right-aligned: without it every control to its right
        // shuffles sideways each time the frame digits change.
        Text {
            width: 92px;
            text: root.readout;
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            letter-spacing: 0.24px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Divider { }

        IconButton {
            glyph: Glyph.fit;
            label: I18n.t("Zoom to fit");
            icon-size: 15px;
            clicked => { root.fit(); }
        }
        IconButton {
            glyph: Glyph.minus;
            label: I18n.t("Zoom out");
            icon-size: 14px;
            // Above 1 is out: the factor multiplies seconds-per-pixel, so a
            // bigger number is more seconds in the same pixel.
            clicked => { root.zoom(1.4); }
        }
        IconButton {
            glyph: Glyph.plus;
            label: I18n.t("Zoom in");
            icon-size: 14px;
            clicked => { root.zoom(1 / 1.4); }
        }
    }
}
